#!/usr/bin/env bash

# OKay DE - Skrypt wykonywania zrzutów ekranu
# Obsługuje zaznaczenie obszaru przez slurp, zapis do pliku, kopiowanie do schowka i powiadomienie.

set -euo pipefail

if ! command -v grim >/dev/null 2>&1 || ! command -v slurp >/dev/null 2>&1; then
    exit 0
fi

DIR="${HOME}/Pictures/Screenshots"
mkdir -p "$DIR"

FILE="${DIR}/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

# Wybór geometrii obszaru (anulowanie przez ESC nie powoduje błędu)
GEOM=$(slurp 2>/dev/null || true)

if [ -n "$GEOM" ]; then
    grim -g "$GEOM" "$FILE"
    if [ -f "$FILE" ]; then
        if command -v wl-copy >/dev/null 2>&1; then
            wl-copy < "$FILE"
        fi
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "Zrzut ekranu" "Zapisano w:\n$FILE" -i "$FILE"
        fi
    fi
fi
