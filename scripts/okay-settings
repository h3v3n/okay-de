    def _on_display_settings_clicked(self, _button):
        """Uruchamia narzędzie wdisplays lub wyświetla ostrzeżenie o braku pakietu."""
        if shutil.which("wdisplays"):
            subprocess.Popen(["wdisplays"])
        else:
            self._show_alert(
                "Brak programu wdisplays",
                "Narzędzie do konfiguracji ekranów 'wdisplays' nie jest zainstalowane.\n\n"
                "Możesz je zainstalować poleceniem:\n"
                "sudo pacman -S wdisplays"
            )

    def _on_sound_settings_clicked(self, _button):
        """Uruchamia mikser dźwięku pavucontrol lub wyświetla ostrzeżenie."""
        if shutil.which("pavucontrol"):
            subprocess.Popen(["pavucontrol"])
        else:
            self._show_alert(
                "Brak miksera pavucontrol",
                "Graficzny mikser dźwięku 'pavucontrol' nie jest zainstalowany.\n\n"
                "Możesz go zainstalować poleceniem:\n"
                "sudo pacman -S pavucontrol"
            )

    # -------------------------------------------------------------
    # Moduł 3: Wydajność i Zasoby (Ghost Runner + zRAM)
    # -------------------------------------------------------------
    def _init_performance_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Wydajność")
        page.set_icon_name("power-profile-performance-symbolic")

        group_ghost = Adw.PreferencesGroup()
        group_ghost.set_title("Zarządca zasobów OKsavi (Ghost Runner)")
        group_ghost.set_description("Optymalizacja cgroups v2, priorytetów zadań oraz pamięci kompresowanej zRAM.")

        row_ghost = Adw.ActionRow()
        row_ghost.set_title("Demon oksavi-ghost-runner")
        row_ghost.set_subtitle("Optymalizacja procesów tła i pamięci podręcznej")
        row_ghost.set_icon_name("system-run-symbolic")

        switch_ghost = Gtk.Switch()
        switch_ghost.set_valign(Gtk.Align.CENTER)

        is_running = self._is_ghost_runner_running()
        switch_ghost.set_active(is_running)

        def on_switch_toggled(sw, _p):
            if sw.get_active():
                subprocess.Popen(["oksavi-ghost-runner", "--start"])
            else:
                subprocess.run(["oksavi-ghost-runner", "--stop"], check=False)

        switch_ghost.connect("notify::active", on_switch_toggled)
        row_ghost.add_suffix(switch_ghost)
        group_ghost.add(row_ghost)

        row_zram = Adw.ActionRow()
        row_zram.set_title("Kompresja pamięci zRAM")
        row_zram.set_subtitle(SystemHelper.get_zram_status())
        row_zram.set_icon_name("drive-harddisk-symbolic")
        group_ghost.add(row_zram)

        page.add(group_ghost)

        # Grupa konserwacji pamięci
        group_maint = Adw.PreferencesGroup()
        group_maint.set_title("Konserwacja pamięci operacyjnej")
        group_maint.set_description("Zwalnianie buforów dyskowych i stron stronnicowania.")

        row_flush = Adw.ActionRow()
        row_flush.set_title("Zwolnij pamięć podręczną (Drop Caches)")
        row_flush.set_subtitle("Wymusza zrzut nieużywanych buforów jądra")
        row_flush.set_icon_name("edit-clear-symbolic")

        btn_flush = Gtk.Button(label="Oczyść RAM")
        btn_flush.set_valign(Gtk.Align.CENTER)
        btn_flush.connect("clicked", self._on_flush_ram_clicked)
        row_flush.add_suffix(btn_flush)
        group_maint.add(row_flush)

        page.add(group_maint)
        self.add(page)

    def _is_ghost_runner_running(self) -> bool:
        """Sprawdza, czy proces oksavi-ghost-runner jest aktywny."""
        try:
            res = subprocess.run(["pgrep", "-x", "oksavi-ghost-runner"], capture_output=True, check=False)
            return res.returncode == 0
        except Exception:
            return False

    def _on_flush_ram_clicked(self, _button):
        """Czyści bufory pamięci podręcznej jądra Linux."""
        try:
            subprocess.run(["sync"], check=False)
            if shutil.which("pkexec"):
                subprocess.run(["pkexec", "sh", "-c", "echo 3 > /proc/sys/vm/drop_caches"], check=False)
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "OKay DE", "Zwolniono pamięć podręczną RAM.", "-u", "low"])
        except Exception as e:
            self._show_alert("Błąd", f"Nie udało się oczyścić pamięci: {e}")

