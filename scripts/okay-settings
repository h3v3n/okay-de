class OkaySettingsWindow(QMainWindow):
    """Główne okno centrum sterowania OKay Settings w PyQt6."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Ustawienia OKay DE")
        self.resize(900, 620)
        self.setMinimumSize(800, 520)

        central = QWidget()
        central.setObjectName("centralWidget")
        self.setCentralWidget(central)

        main_layout = QHBoxLayout(central)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        # 1. Pasek boczny nawigacji (Sidebar)
        self.sidebar_widget = QWidget()
        self.sidebar_widget.setObjectName("sidebarWidget")
        self.sidebar_widget.setFixedWidth(240)

        sidebar_layout = QVBoxLayout(self.sidebar_widget)
        sidebar_layout.setContentsMargins(10, 18, 10, 18)
        sidebar_layout.setSpacing(6)

        # Header w pasku bocznym
        header_widget = QWidget()
        header_layout = QVBoxLayout(header_widget)
        header_layout.setContentsMargins(14, 0, 14, 12)
        header_layout.setSpacing(2)

        lbl_logo = QLabel("󰒓  OKay Settings")
        lbl_logo.setObjectName("sidebarLogo")
        lbl_desc = QLabel("Centrum sterowania OKsavi")
        lbl_desc.setObjectName("sidebarSubtitle")

        header_layout.addWidget(lbl_logo)
        header_layout.addWidget(lbl_desc)
        sidebar_layout.addWidget(header_widget)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setObjectName("sidebarSep")
        sidebar_layout.addWidget(sep)

        sidebar_layout.addSpacing(6)

        self.btn_group = QButtonGroup(self)
        self.btn_group.setExclusive(True)

        categories = [
            ("󰏘  Wygląd", 0),
            ("󰍹  System i Ekran", 1),
            ("󰓅  Wydajność", 2),
            ("󰌌  Skróty klawiszowe", 3),
            ("󰑓  Aktualizacje", 4),
            ("󰋽  O systemie", 5)
        ]

        self.sidebar_buttons = []
        for label, idx in categories:
            btn = SidebarButton(label)
            self.btn_group.addButton(btn, idx)
            sidebar_layout.addWidget(btn)
            self.sidebar_buttons.append(btn)

        sidebar_layout.addStretch()
        main_layout.addWidget(self.sidebar_widget)

        # 2. Stosy stron (StackedWidget z przewijaniem)
        self.stacked = QStackedWidget()

        self.page_appearance = self._wrap_in_scroll(AppearancePage())
        self.page_system = self._wrap_in_scroll(SystemPage())
        self.page_perf = self._wrap_in_scroll(PerformancePage())
        self.page_shortcuts = self._wrap_in_scroll(ShortcutsPage())
        self.page_updates = self._wrap_in_scroll(UpdatesPage())
        self.page_about = self._wrap_in_scroll(AboutPage())

        self.stacked.addWidget(self.page_appearance)
        self.stacked.addWidget(self.page_system)
        self.stacked.addWidget(self.page_perf)
        self.stacked.addWidget(self.page_shortcuts)
        self.stacked.addWidget(self.page_updates)
        self.stacked.addWidget(self.page_about)

        main_layout.addWidget(self.stacked, stretch=1)

        # Synchronizacja paska bocznego
        self.btn_group.idClicked.connect(self.stacked.setCurrentIndex)
        if self.sidebar_buttons:
            self.sidebar_buttons[0].setChecked(True)
        self.stacked.setCurrentIndex(0)

    def _wrap_in_scroll(self, page_widget: QWidget) -> QScrollArea:
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(page_widget)
        return scroll


def main():
    """Główny punkt wejściowy aplikacji OKay Settings."""
    os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")

    app = QApplication(sys.argv)
    app.setApplicationName("okay-settings")
    app.setDesktopFileName("okay-settings")
    app.setStyleSheet(CATPPUCCIN_MOCHA_QSS)

    window = OkaySettingsWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
