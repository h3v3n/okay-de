class UpdatesPage(QWidget):
    """Moduł: Aktualizacje (GitHub)."""

    def __init__(self):
        super().__init__()
        self.check_worker = None
        self.install_worker = None

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(16)

        # 1. Stan aktualizacji
        card_status = PreferenceCard(
            "Stan aktualizacji",
            "Sprawdź dostępność nowszej wersji OKay DE w oficjalnym repozytorium GitHub."
        )

        self.lbl_local_ver = QLabel(UpdateManager.get_local_commit())
        self.lbl_local_ver.setObjectName("versionBadge")
        card_status.add_row(PreferenceRow(
            "Zainstalowana wersja",
            f"Repozytorium: {UpdateManager.GITHUB_REPO}",
            self.lbl_local_ver
        ))

        # Kontrolka sprawdzania
        check_widget = QWidget()
        check_layout = QHBoxLayout(check_widget)
        check_layout.setContentsMargins(0, 0, 0, 0)
        check_layout.setSpacing(8)

        self.btn_check = QPushButton("Sprawdź teraz")
        self.btn_check.setProperty("class", "suggested-btn")
        self.btn_check.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_check.clicked.connect(self._check_updates)
        check_layout.addWidget(self.btn_check)

        self.row_check_status = PreferenceRow(
            "Sprawdzanie aktualizacji",
            "Kliknij przycisk, aby połączyć się z GitHub.",
            check_widget
        )
        card_status.add_row(self.row_check_status)

        layout.addWidget(card_status)

        # 2. Dostępne uaktualnienie (ukryte do czasu wykrycia)
        self.card_update = PreferenceCard(
            "Dostępne uaktualnienie",
            "W repozytorium GitHub opublikowano nowsze wydanie środowiska."
        )
        self.card_update.setVisible(False)

        self.row_remote_sha = PreferenceRow("Najnowszy commit", "-")
        self.card_update.add_row(self.row_remote_sha)

        self.row_commit_msg = PreferenceRow("Opis zmian", "-")
        self.card_update.add_row(self.row_commit_msg)

        # Tryb instalacji
        self.combo_mode = QComboBox()
        self.combo_mode.addItems([
            "Katalog użytkownika (~/.config, ~/.local)",
            "Systemowy (/etc, /usr - wymaga uprawnień)"
        ])
        self.card_update.add_row(PreferenceRow(
            "Zakres instalacji",
            "Wybierz profil instalacji uaktualnienia",
            self.combo_mode
        ))

        # Przycisk instalacji
        self.btn_install = QPushButton("Zainstaluj teraz")
        self.btn_install.setProperty("class", "suggested-btn")
        self.btn_install.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_install.clicked.connect(self._install_update)

        self.row_install = PreferenceRow(
            "Rozpocznij instalację",
            "Pobierze pliki z gałęzi main i zaaplikuje konfigurację.",
            self.btn_install
        )
        self.card_update.add_row(self.row_install)

        layout.addWidget(self.card_update)
        layout.addStretch()

    def _check_updates(self):
        self.btn_check.setEnabled(False)
        self.row_check_status.set_subtitle("Łączenie z GitHub API (h3v3n/okay-de)...")

        self.check_worker = CheckUpdateWorker()
        self.check_worker.finished.connect(self._on_check_finished)
        self.check_worker.start()

    def _on_check_finished(self, result: dict):
        self.btn_check.setEnabled(True)

        if not result.get("success"):
            err = result.get("error", "Błąd połączenia")
            self.row_check_status.set_subtitle(f"Nie udało się połączyć z GitHub: {err}")
            self.card_update.setVisible(False)
            return

        local_sha = result.get("local_sha", "")
        remote_sha = result.get("remote_sha", "")
        has_update = result.get("has_update", False)

        if has_update:
            self.row_check_status.set_subtitle(f"Dostępna nowa wersja: {local_sha} ➔ {remote_sha}")
            author = result.get("author", "Autor")
            date = result.get("date", "")
            date_info = f" | {date}" if date else ""
            self.row_remote_sha.set_subtitle(f"Commit {remote_sha} ({author}{date_info})")
            self.row_commit_msg.set_subtitle(result.get("commit_msg", "Brak opisu"))
            self.card_update.setVisible(True)
        else:
            self.row_check_status.set_subtitle(f"System jest aktualny. Posiadasz najnowszą wersję ({local_sha}).")
            self.card_update.setVisible(False)

    def _install_update(self):
        target_mode = "system" if self.combo_mode.currentIndex() == 1 else "user"
        self.btn_install.setEnabled(False)
        self.btn_check.setEnabled(False)
        self.row_install.set_subtitle("Inicjowanie procesu aktualizacji...")

        self.install_worker = InstallUpdateWorker(target_mode)
        self.install_worker.progress.connect(self._on_install_progress)
        self.install_worker.finished.connect(self._on_install_finished)
        self.install_worker.start()

    def _on_install_progress(self, msg: str):
        self.row_install.set_subtitle(msg)

    def _on_install_finished(self, success: bool, msg: str):
        self.btn_install.setEnabled(True)
        self.btn_check.setEnabled(True)
        self.row_install.set_subtitle(msg)

        if success:
            new_sha = UpdateManager.get_local_commit()
            self.lbl_local_ver.setText(new_sha)
            self.card_update.setVisible(False)
            self.row_check_status.set_subtitle(f"Pomyślnie zaktualizowano do wersji {new_sha}.")
            QMessageBox.information(
                self,
                "Aktualizacja zakończona",
                "OKay DE zostało pomyślnie zaktualizowane!\n"
                "Konfiguracja kompozytora labwc oraz pasek Waybar zostały odświeżone."
            )
        else:
            QMessageBox.critical(self, "Błąd aktualizacji", f"Instalacja aktualizacji nie powiodła się:\n\n{msg}")


class AboutPage(QWidget):
    """Moduł: O systemie (Informacje)."""

    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(16)

        card = PreferenceCard("O systemie", "Podstawowe dane o sprzęcie i zainstalowanym oprogramowaniu.")

        card.add_row(PreferenceRow("Dystrybucja", SystemHelper.get_distro_name()))
        card.add_row(PreferenceRow("Środowisko graficzne", SystemHelper.get_desktop_info()))
        card.add_row(PreferenceRow("Wersja OKay DE", f"Commit {UpdateManager.get_local_commit()}"))
        card.add_row(PreferenceRow("Wersja jądra Linux", SystemHelper.get_kernel_release()))
        card.add_row(PreferenceRow("Procesor (CPU)", SystemHelper.get_cpu_info()))
        card.add_row(PreferenceRow("Pamięć operacyjna", SystemHelper.get_memory_info()))
        card.add_row(PreferenceRow("Technologia UI", "PyQt6 (Qt 6.x)"))

        layout.addWidget(card)
        layout.addStretch()


