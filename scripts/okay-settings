class AppearancePage(QWidget):
    """Moduł: Wygląd i Pulpit."""

    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(16)

        # 1. Karta Pulpit i Dock
        card_desktop = PreferenceCard("Wygląd i Pulpit", "Dostosuj tło pulpitu oraz styl paska zadań Waybar.")

        # Tapeta
        btn_wallpaper = QPushButton("Zmień tapetę...")
        btn_wallpaper.setProperty("class", "suggested-btn")
        btn_wallpaper.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_wallpaper.clicked.connect(self._change_wallpaper)
        self.row_wallpaper = PreferenceRow(
            "Tapeta pulpitu",
            "Wybierz plik graficzny (PNG, JPG, WEBP)",
            btn_wallpaper
        )
        card_desktop.add_row(self.row_wallpaper)

        # Styl docka
        self.combo_dock = QComboBox()
        self.combo_dock.addItems(["Pływająca wyspa", "Pełna belka"])
        current_style = ConfigManager.get_dock_style()
        self.combo_dock.setCurrentIndex(1 if current_style == "full" else 0)
        self.combo_dock.currentIndexChanged.connect(self._dock_style_changed)
        card_desktop.add_row(PreferenceRow(
            "Styl Docka",
            "Wybierz formę wyświetlania dolnego paska zadań",
            self.combo_dock
        ))

        layout.addWidget(card_desktop)

        # 2. Karta Przyciski okien
        card_buttons = PreferenceCard(
            "Przyciski okien (Dekoracje SSD)",
            "Dostosuj barwy prostokątnych przycisków sterowania oknami labwc."
        )

        current_colors = ConfigManager.get_button_colors()

        # Przycisk zamykania
        self.btn_close_color = ColorPickerButton(current_colors.get("close", "#f38ba8"))
        self.btn_close_color.color_changed.connect(
            lambda h: ConfigManager.set_button_color("close", h)
        )
        card_buttons.add_row(PreferenceRow(
            "Przycisk zamykania (Close)",
            "Kolor aktywnego przycisku zamykania okna",
            self.btn_close_color
        ))

        # Przycisk maksymalizowania
        self.btn_max_color = ColorPickerButton(current_colors.get("max", "#89b4fa"))
        self.btn_max_color.color_changed.connect(
            lambda h: ConfigManager.set_button_color("max", h)
        )
        card_buttons.add_row(PreferenceRow(
            "Przycisk maksymalizowania (Maximize)",
            "Kolor aktywnego przycisku powiększania okna",
            self.btn_max_color
        ))

        # Przycisk minimalizowania
        self.btn_min_color = ColorPickerButton(current_colors.get("iconify", "#585b70"))
        self.btn_min_color.color_changed.connect(
            lambda h: ConfigManager.set_button_color("iconify", h)
        )
        card_buttons.add_row(PreferenceRow(
            "Przycisk minimalizowania (Iconify)",
            "Kolor aktywnego przycisku minimalizacji do docka",
            self.btn_min_color
        ))

        layout.addWidget(card_buttons)

        # 3. Karta Przypięte aplikacje w docku (Taskbar)
        card_pinned = PreferenceCard(
            "Przypięte aplikacje w docku (Taskbar)",
            "Zarządzaj skrótami do aplikacji stale widocznymi na dolnym pasku zadań."
        )

        self.pinned_apps = ConfigManager.get_pinned_apps()
        self.pin_checkboxes = {}

        for app_id, app_info in self.pinned_apps.items():
            chk = QCheckBox("Przypięta")
            chk.setChecked(app_info.get("enabled", False))
            chk.toggled.connect(self._create_pin_toggle_handler(app_id))
            self.pin_checkboxes[app_id] = chk

            row = PreferenceRow(
                f"{app_info.get('icon', '󰣇')}  {app_info.get('name', app_id)}",
                f"Polecenie: {app_info.get('cmd', '')}",
                chk
            )
            card_pinned.add_row(row)

        btn_add_pin = QPushButton("+ Przypnij inną aplikację...")
        btn_add_pin.setProperty("class", "suggested-btn")
        btn_add_pin.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_add_pin.clicked.connect(self._add_custom_pinned_app)
        card_pinned.add_row(PreferenceRow(
            "Dodaj własny skrót",
            "Zdefiniuj nowy program do przypięcia na docku",
            btn_add_pin
        ))

        layout.addWidget(card_pinned)
        layout.addStretch()

    def _create_pin_toggle_handler(self, app_id: str):
        def handler(checked: bool):
            if app_id in self.pinned_apps:
                self.pinned_apps[app_id]["enabled"] = checked
                ConfigManager.set_pinned_apps(self.pinned_apps)
        return handler

    def _add_custom_pinned_app(self):
        name, ok1 = QInputDialog.getText(self, "Przypnij aplikację", "Nazwa aplikacji:")
        if not ok1 or not name.strip():
            return
        cmd, ok2 = QInputDialog.getText(self, "Przypnij aplikację", f"Polecenie uruchomienia dla '{name}':")
        if not ok2 or not cmd.strip():
            return
        icon, ok3 = QInputDialog.getText(self, "Przypnij aplikację", "Symbol ikony (np. 󰅩, , 󰈹):", text="󰣇")
        if not ok3 or not icon.strip():
            icon = "󰣇"

        app_id = f"custom_{len(self.pinned_apps) + 1}"
        self.pinned_apps[app_id] = {
            "name": name.strip(),
            "cmd": cmd.strip(),
            "icon": icon.strip(),
            "enabled": True
        }
        ConfigManager.set_pinned_apps(self.pinned_apps)
        QMessageBox.information(
            self,
            "OKay DE",
            f"Aplikacja '{name}' została przypięta do paska zadań!\nPasek Waybar został odświeżony."
        )

    def _change_wallpaper(self):
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Wybierz tapetę pulpitu",
            os.path.expanduser("~"),
            "Pliki graficzne (*.png *.jpg *.jpeg *.webp)"
        )
        if file_path:
            success = ConfigManager.set_wallpaper(file_path)
            if success:
                self.row_wallpaper.set_subtitle(f"Aktywna: {os.path.basename(file_path)}")
                if shutil.which("notify-send"):
                    subprocess.Popen([
                        "notify-send",
                        "OKay DE",
                        f"Ustawiono nową tapetę:\n{os.path.basename(file_path)}"
                    ])

    def _dock_style_changed(self, idx):
        style = "full" if idx == 1 else "floating"
        ConfigManager.set_dock_style(style)


