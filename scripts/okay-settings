#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Settings (GTK3) — Centrum sterowania dla OKay Desktop Environment (Wayfire / Wayland).
Obsługuje reaktywne odświeżanie motywu Ciemny/Jasny, koloru akcentu oraz silnika animacji 60/120+ FPS.
"""

import os
import sys
import glob
import signal
import argparse

os.environ.setdefault("MALLOC_ARENA_MAX", "2")
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ.setdefault("GDK_BACKEND", "wayland,x11")

# Automatyczne wykrycie gniazda Wayland w /run/user/$UID, jeśli uruchomiono spoza środowiska sesji
if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("BROADWAY_DISPLAY"):
    _rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if os.path.isdir(_rt):
        _wl_socks = sorted(glob.glob(os.path.join(_rt, "wayland-[0-9]*")))
        _wl_socks = [s for s in _wl_socks if not s.endswith(".lock")]
        if _wl_socks:
            os.environ.setdefault("XDG_RUNTIME_DIR", _rt)
            os.environ["WAYLAND_DISPLAY"] = os.path.basename(_wl_socks[0])

try:
    import ctypes
    ctypes.CDLL(None).prctl(15, b"okay-settings", 0, 0, 0)
except Exception:
    pass

# Rozwiązanie ścieżki modułów `settings` i `panel`: priorytet repo -> ~/.local -> /usr/local -> /usr
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_XDG_DATA = os.environ.get("XDG_DATA_HOME", "").strip()
_USER_SHARE_DIR = os.path.join(
    os.path.expanduser(_XDG_DATA) if _XDG_DATA else os.path.expanduser("~/.local/share"),
    "okay-de",
)
_parent_dir = os.path.dirname(_SCRIPT_DIR)
_candidates_raw = [
    _SCRIPT_DIR,
    os.path.join(_parent_dir, "scripts"),
    _USER_SHARE_DIR,
    os.path.join(_USER_SHARE_DIR, "repo", "scripts"),
    "/usr/local/share/okay-de",
    "/usr/share/okay-de",
]
_candidates = []
for _c in _candidates_raw:
    if _c and (os.path.isdir(os.path.join(_c, "settings")) or os.path.isdir(os.path.join(_c, "panel"))) and _c not in _candidates:
        _candidates.append(_c)

for _cand in reversed(_candidates):
    if _cand in sys.path:
        sys.path.remove(_cand)
    sys.path.insert(0, _cand)

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk

from settings.helpers import (
    apply_settings_css,
    ensure_user_configs,
    get_state_manager,
)
from panel.animations import configure_animations, prepare_fade_in, start_fade_in
from settings.wifi_tab import WifiTab
from settings.sound_tab import SoundTab
from settings.display_tab import DisplayTab
from settings.input_tab import InputTab
from settings.panel_tab import PanelTab
from settings.system_tab import SystemTab


TAB_ALIASES = {
    "wifi": "wifi",
    "network": "wifi",
    "bluetooth": "wifi",
    "sound": "sound",
    "audio": "sound",
    "display": "display",
    "monitors": "display",
    "input": "input",
    "mouse": "input",
    "shortcuts": "input",
    "panel": "panel",
    "appearance": "panel",
    "animations": "panel",
    "system": "system",
    "privacy": "system",
}


class OkaySettingsWindow(Gtk.Window):
    """Główne okno centrum sterowania OKay DE."""

    def __init__(self, initial_tab: str = None):
        super().__init__(title="Ustawienia systemowe — OKay DE")
        self.set_name("okay-settings")
        self.set_default_size(940, 620)
        self.set_position(Gtk.WindowPosition.CENTER)

        ensure_user_configs()
        self._state = get_state_manager()
        cfg = self._state.get_config()

        apply_settings_css(cfg.get("accent_color"), theme_mode=cfg.get("theme_mode", "dark"))
        configure_animations(
            reduce_motion=cfg.get("reduce_motion", False),
            speed_multiplier=cfg.get("animation_speed", 1.0),
        )
        self._state.subscribe(self._on_state_changed)

        self._anim_enabled = not bool(cfg.get("reduce_motion", False))
        if not self._anim_enabled:
            self.get_style_context().add_class("no-animations")

        prepare_fade_in(self)
        self.connect("map-event", self._on_window_map_event)
        self.connect("key-press-event", self._on_key_press_event)
        self.connect("destroy", self._on_window_destroy)

        root_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(root_hbox)

        # Panel boczny
        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        left_col.set_size_request(240, -1)

        brand_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        brand_box.get_style_context().add_class("settings-brand")
        lbl_brand = Gtk.Label(label="OKay DE", xalign=0.0)
        lbl_brand.get_style_context().add_class("brand-title")
        lbl_sub = Gtk.Label(label="Centrum sterowania Wayland", xalign=0.0)
        lbl_sub.get_style_context().add_class("brand-subtitle")
        brand_box.pack_start(lbl_brand, False, False, 0)
        brand_box.pack_start(lbl_sub, False, False, 0)
        left_col.pack_start(brand_box, False, False, 0)

        self.nav_list = Gtk.ListBox()
        self.nav_list.set_selection_mode(Gtk.SelectionMode.BROWSE)
        self.nav_list.get_style_context().add_class("settings-sidebar")
        self.nav_list.connect("row-selected", self._on_nav_row_selected)
        left_col.pack_start(self.nav_list, True, True, 0)

        root_hbox.pack_start(left_col, False, False, 0)

        # Prawa strona (Stack z płynnymi przejściami)
        self.stack = Gtk.Stack()
        self._update_stack_transition()
        root_hbox.pack_start(self.stack, True, True, 0)

        pages = [
            ("panel", "applications-graphics-symbolic", "Wygląd i Animacje", PanelTab(parent_window=self)),
            ("display", "video-display-symbolic", "Ekrany i Wyjścia", DisplayTab(parent_window=self, defer_load=True)),
            ("sound", "audio-speakers-symbolic", "Dźwięk (PipeWire)", SoundTab(parent_window=self, defer_load=True)),
            ("wifi", "network-wireless-signal-excellent-symbolic", "Sieć i Bluetooth", WifiTab(parent_window=self, defer_load=True)),
            ("input", "input-mouse-symbolic", "Mysz i Skróty", InputTab(parent_window=self, defer_load=True)),
            ("system", "computer-symbolic", "Prywatność i System", SystemTab(parent_window=self)),
        ]

        self._rows_by_key = {}
        self._pages_by_key = {}
        for key, icon_name, title, widget in pages:
            self.stack.add_named(widget, key)
            self._pages_by_key[key] = widget

            row = Gtk.ListBoxRow()
            row._page_key = key

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
            lbl = Gtk.Label(label=title, xalign=0.0)
            row_box.pack_start(icon, False, False, 0)
            row_box.pack_start(lbl, True, True, 0)

            row.add(row_box)
            self.nav_list.add(row)
            self._rows_by_key[key] = row

        target_key = TAB_ALIASES.get((initial_tab or "").lower(), "panel")
        first_row = self._rows_by_key.get(target_key) or self.nav_list.get_row_at_index(0)
        if first_row is not None:
            self.nav_list.select_row(first_row)

    def _on_window_destroy(self, _widget):
        self._state.unsubscribe(self._on_state_changed)
        Gtk.main_quit()

    def _on_state_changed(self, cfg: dict):
        self._anim_enabled = not bool(cfg.get("reduce_motion", False))
        ctx = self.get_style_context()
        if self._anim_enabled:
            ctx.remove_class("no-animations")
        elif not ctx.has_class("no-animations"):
            ctx.add_class("no-animations")
        self._update_stack_transition()
        apply_settings_css(cfg.get("accent_color"), theme_mode=cfg.get("theme_mode", "dark"))

    def _update_stack_transition(self):
        cfg = self._state.get_config()
        if not cfg.get("reduce_motion", False):
            speed = max(0.5, min(2.0, float(cfg.get("animation_speed", 1.0))))
            self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            self.stack.set_transition_duration(max(40, int(round(140.0 / speed))))
        else:
            self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
            self.stack.set_transition_duration(0)

    def _on_window_map_event(self, _widget, _event):
        if self._anim_enabled:
            start_fade_in(self, duration_ms=150)
        else:
            self.set_opacity(1.0)
        return False

    def _on_key_press_event(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _on_nav_row_selected(self, _listbox, row):
        if row is None:
            return
        key = getattr(row, "_page_key", None)
        if key:
            page = self._pages_by_key.get(key)
            if page is not None and hasattr(page, "ensure_loaded"):
                page.ensure_loaded()
            self.stack.set_visible_child_name(key)


def main():
    parser = argparse.ArgumentParser(description="OKay Settings — Centrum sterowania OKay DE")
    parser.add_argument(
        "--tab",
        default=None,
        help="Otwórz bezpośrednio wskazaną zakładkę (panel, display, sound, wifi, input, system)",
    )
    args, unknown = parser.parse_known_args()
    sys.argv = [sys.argv[0]] + unknown

    win = OkaySettingsWindow(initial_tab=args.tab)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
