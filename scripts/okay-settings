#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Settings (okay-settings)
Natywne centrum sterowania środowiska graficznego OKay DE dla dystrybucji OKsavi Linux.
Stos technologiczny: Python 3, GTK3 (PyGObject), Wayland.
"""

import os
import sys
import json
import signal
import shutil
import subprocess

# Ograniczenie aren glibc, wyłączenie mostu AT-SPI oraz wymuszenie Wayland przed startem GTK3
os.environ.setdefault("MALLOC_ARENA_MAX", "2")
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ["GDK_BACKEND"] = "wayland"

# Nazwa procesu w jądrze Linux dla pkill / menedżera zadań
try:
    import ctypes
    ctypes.CDLL(None).prctl(15, b"okay-settings", 0, 0, 0)
except Exception:
    pass

# Rozwiązanie ścieżki modułu `settings`: priorytet repo -> ~/.local -> /usr/local -> /usr
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_XDG_DATA = os.environ.get("XDG_DATA_HOME", "").strip()
_USER_SHARE_DIR = os.path.join(
    os.path.expanduser(_XDG_DATA) if _XDG_DATA else os.path.expanduser("~/.local/share"),
    "okay-de",
)
for _candidate in reversed((
    _SCRIPT_DIR,
    _USER_SHARE_DIR,
    "/usr/local/share/okay-de",
    "/usr/share/okay-de",
)):
    if os.path.isdir(os.path.join(_candidate, "settings")):
        if _candidate in sys.path:
            sys.path.remove(_candidate)
        sys.path.insert(0, _candidate)

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gio, GLib
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek GTK3 / PyGObject: {err}\n"
        "Zainstaluj pakiety: gtk3, python-gobject.",
        file=sys.stderr
    )
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "Błąd OKay Settings", "Wymagane pakiety: gtk3 python-gobject", "-u", "critical"],
            check=False
        )
    sys.exit(1)

from settings import (
    apply_settings_css,
    ensure_user_configs,
    WifiTab,
    DisplayTab,
    InputTab,
    SoundTab,
    PanelTab,
    SystemTab,
)
from settings.helpers import okay_config_dir, okay_template_file


class OkaySettingsWindow(Gtk.ApplicationWindow):
    """Główne okno centrum sterowania OKay DE z panelem Gtk.StackSidebar + Gtk.Stack."""

    def __init__(self, app, initial_tab: str = ""):
        super().__init__(application=app, title="OKay Settings — Centrum sterowania")
        self.set_name("okay-settings")
        self.set_icon_name("preferences-system")
        self.set_default_size(940, 620)
        self.set_size_request(760, 500)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Inicjalizacja ~/.config/okay-de i ~/.config/labwc z szablonów systemowych (read-only)
        ensure_user_configs()
        apply_settings_css()

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(root)

        # Lewa kolumna: Nagłówek marki + Gtk.StackSidebar
        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        left_col.set_size_request(230, -1)

        brand_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        brand_box.get_style_context().add_class("settings-brand")
        lbl_brand = Gtk.Label(label="OKay Settings", xalign=0.0)
        lbl_brand.get_style_context().add_class("brand-title")
        lbl_sub = Gtk.Label(label="OKsavi Linux • Wayland", xalign=0.0)
        lbl_sub.get_style_context().add_class("brand-subtitle")
        brand_box.pack_start(lbl_brand, False, False, 0)
        brand_box.pack_start(lbl_sub, False, False, 0)
        left_col.pack_start(brand_box, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)

        self.sidebar = Gtk.StackSidebar()
        self.sidebar.set_stack(self.stack)
        self.sidebar.get_style_context().add_class("settings-sidebar")
        self.sidebar.set_vexpand(True)
        left_col.pack_start(self.sidebar, True, True, 0)

        root.pack_start(left_col, False, False, 0)
        root.pack_start(self.stack, True, True, 0)

        # Rejestracja modularnych zakładek (leniwe ładowanie ciężkich backendów po otwarciu danej karty)
        self._panel_tab = PanelTab(
            self,
            defer_load=True,
            on_animations_changed=self.apply_animations_setting,
            on_accent_changed=self.apply_accent_setting,
        )
        tabs = [
            ("wifi", "Wi-Fi i Sieć", WifiTab(self, defer_load=True)),
            ("display", "Monitory", DisplayTab(self, defer_load=True)),
            ("input", "Mysz i Touchpad", InputTab(self, defer_load=True)),
            ("sound", "Dźwięk", SoundTab(self, defer_load=True)),
            ("panel", "Pulpit i Panel", self._panel_tab),
            ("system", "System i Aktualizacje", SystemTab(self)),
        ]
        for tab_id, title, widget in tabs:
            self.stack.add_titled(widget, tab_id, title)

        self.apply_animations_setting(self._read_animations_setting())

        self.stack.connect("notify::visible-child", self._on_visible_tab_changed)
        self.show_all()

        if initial_tab and self.stack.get_child_by_name(initial_tab):
            self.stack.set_visible_child_name(initial_tab)
        self._activate_current_tab()

    @staticmethod
    def _read_animations_setting() -> bool:
        user_panel = os.path.join(okay_config_dir(), "panel.json")
        candidates = (user_panel, okay_template_file("panel.json"))
        for path in candidates:
            if path and os.path.exists(path):
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        data = json.load(f)
                    if isinstance(data, dict):
                        return bool(data.get("animations", True))
                except Exception:
                    pass
                if path == user_panel:
                    continue
                break
        return True

    def refresh_after_update(self):
        apply_settings_css()
        self.apply_animations_setting(self._read_animations_setting())
        if getattr(self._panel_tab, "_loaded", False):
            self._panel_tab.load_config()

    def apply_accent_setting(self, accent_hex: str):
        apply_settings_css(accent_hex)

    def apply_animations_setting(self, enabled: bool):
        enabled = bool(enabled)
        if enabled:
            self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            self.stack.set_transition_duration(150)
            self.get_style_context().remove_class("no-animations")
        else:
            self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
            self.stack.set_transition_duration(0)
            self.get_style_context().add_class("no-animations")
        try:
            gtk_settings = Gtk.Settings.get_default()
            if gtk_settings is not None:
                gtk_settings.set_property("gtk-enable-animations", enabled)
        except Exception:
            pass

    def _activate_current_tab(self):
        child = self.stack.get_visible_child()
        if child is not None and hasattr(child, "ensure_loaded"):
            child.ensure_loaded()

    def _on_visible_tab_changed(self, _stack, _pspec):
        self._activate_current_tab()


class OkaySettingsApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.oksavi.okay_settings",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.initial_tab = ""
        self._window = None

    @staticmethod
    def _parse_tab_arg(argv: list) -> str:
        for i, arg in enumerate(argv[1:], start=1):
            if arg in ("--tab", "-t") and i + 1 < len(argv):
                return argv[i + 1].strip()
            if arg.startswith("--tab="):
                return arg.split("=", 1)[1].strip()
        return ""

    def do_command_line(self, command_line):
        self.initial_tab = self._parse_tab_arg(command_line.get_arguments())
        self.activate()
        return 0

    def do_activate(self):
        if self._window is None:
            self._window = OkaySettingsWindow(self, self.initial_tab)
            self._window.connect("destroy", lambda _w: setattr(self, "_window", None))
        elif self.initial_tab and self._window.stack.get_child_by_name(self.initial_tab):
            self._window.stack.set_visible_child_name(self.initial_tab)
            self._window._activate_current_tab()
        self._window.present()


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    GLib.set_prgname("okay-settings")
    app = OkaySettingsApp()
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
