#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Settings (okay-settings)
Natywne centrum sterowania środowiska graficznego OKay DE dla dystrybucji OKsavi Linux.
Stos technologiczny: Python 3, GTK3 (PyGObject), Wayland.
"""

import os
import sys
import shutil
import subprocess

# Wymuszenie natywnego backendu Wayland dla GTK3 (spójny app_id z panelem)
os.environ["GDK_BACKEND"] = "wayland"

# Nazwa procesu w jądrze Linux dla pkill / menedżera zadań
try:
    import ctypes
    ctypes.CDLL(None).prctl(15, b"okay-settings", 0, 0, 0)
except Exception:
    pass

# Rozwiązanie ścieżki modułu `settings` dla uruchomień z repo, ~/.local oraz /usr
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
for _candidate in (
    _SCRIPT_DIR,
    os.path.expanduser("~/.local/share/okay-de"),
    "/usr/local/share/okay-de",
    "/usr/share/okay-de",
):
    if os.path.isdir(os.path.join(_candidate, "settings")) and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek GTK3 / PyGObject: {err}\n"
        "Zainstaluj pakiety: gtk3, python-gobject.",
        file=sys.stderr
    )
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "Błąd OKay Settings", "Wymagane pakiety: gtk3 python-gobject", "-u", "critical"],
            check=False
        )
    sys.exit(1)

from settings import (
    apply_settings_css,
    WifiTab,
    DisplayTab,
    InputTab,
    SoundTab,
    PanelTab,
    SystemTab,
)


class OkaySettingsWindow(Gtk.ApplicationWindow):
    """Główne okno centrum sterowania OKay DE z panelem Gtk.StackSidebar + Gtk.Stack."""

    def __init__(self, app, initial_tab: str = ""):
        super().__init__(application=app, title="OKay Settings — Centrum sterowania")
        self.set_name("okay-settings")
        self.set_icon_name("preferences-system")
        self.set_default_size(940, 620)
        self.set_size_request(760, 500)
        self.set_position(Gtk.WindowPosition.CENTER)

        apply_settings_css()

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(root)

        # Lewa kolumna: Nagłówek marki + Gtk.StackSidebar
        left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        left_col.set_size_request(230, -1)

        brand_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        brand_box.get_style_context().add_class("settings-brand")
        lbl_brand = Gtk.Label(label="OKay Settings", xalign=0.0)
        lbl_brand.get_style_context().add_class("brand-title")
        lbl_sub = Gtk.Label(label="OKsavi Linux • Wayland", xalign=0.0)
        lbl_sub.get_style_context().add_class("brand-subtitle")
        brand_box.pack_start(lbl_brand, False, False, 0)
        brand_box.pack_start(lbl_sub, False, False, 0)
        left_col.pack_start(brand_box, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(80)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)

        self.sidebar = Gtk.StackSidebar()
        self.sidebar.set_stack(self.stack)
        self.sidebar.get_style_context().add_class("settings-sidebar")
        self.sidebar.set_vexpand(True)
        left_col.pack_start(self.sidebar, True, True, 0)

        root.pack_start(left_col, False, False, 0)
        root.pack_start(self.stack, True, True, 0)

        # Rejestracja modularnych zakładek
        tabs = [
            ("wifi", "Wi-Fi i Sieć", WifiTab(self)),
            ("display", "Monitory", DisplayTab(self)),
            ("input", "Mysz i Touchpad", InputTab(self)),
            ("sound", "Dźwięk", SoundTab(self)),
            ("panel", "Pulpit i Panel", PanelTab(self)),
            ("system", "System i Aktualizacje", SystemTab(self)),
        ]
        for tab_id, title, widget in tabs:
            self.stack.add_titled(widget, tab_id, title)

        self.show_all()

        if initial_tab and self.stack.get_child_by_name(initial_tab):
            self.stack.set_visible_child_name(initial_tab)


class OkaySettingsApp(Gtk.Application):
    def __init__(self, initial_tab: str = ""):
        super().__init__(application_id="org.oksavi.okay_settings")
        self.initial_tab = initial_tab
        self._window = None

    def do_activate(self):
        if self._window is None:
            self._window = OkaySettingsWindow(self, self.initial_tab)
        else:
            if self.initial_tab and self._window.stack.get_child_by_name(self.initial_tab):
                self._window.stack.set_visible_child_name(self.initial_tab)
        self._window.present()


def main():
    initial_tab = ""
    if len(sys.argv) >= 3 and sys.argv[1] in ("--tab", "-t"):
        initial_tab = sys.argv[2].strip()
    elif len(sys.argv) >= 2 and sys.argv[1].startswith("--tab="):
        initial_tab = sys.argv[1].split("=", 1)[1].strip()

    GLib.set_prgname("okay-settings")
    app = OkaySettingsApp(initial_tab=initial_tab)
    sys.exit(app.run([]))


if __name__ == "__main__":
    main()
