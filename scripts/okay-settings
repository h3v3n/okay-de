        "Zainstaluj wymagane pakiety: python-pyqt6 (lub qt6-base i python-pyqt6).",
        file=sys.stderr
    )
    if shutil.which("notify-send"):
        subprocess.run([
            "notify-send",
            "Błąd OKay Settings",
            "Wymagany pakiet: python-pyqt6",
            "-u", "critical"
        ], check=False)
    sys.exit(1)


# ============================================================================
# Narzędzia systemowe i pomocnicze
# ============================================================================

class SystemHelper:
    """Klasa narzędziowa do pobierania informacji o sprzęcie i systemie."""

    @staticmethod
    def get_distro_name() -> str:
        """Pobiera nazwę dystrybucji z /etc/os-release z fallbackiem na OKsavi Linux."""
        os_release = "/etc/os-release"
        if os.path.exists(os_release):
            try:
                with open(os_release, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("PRETTY_NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
                        if line.startswith("NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
            except Exception:
                pass
        return "OKsavi Linux"

    @staticmethod
    def get_desktop_info() -> str:
        """Zwraca identyfikator środowiska graficznego."""
        return "OKay DE (Wayland / labwc)"

    @staticmethod
    def get_kernel_release() -> str:
        """Zwraca wersję jądra Linux."""
        return platform.release()

    @staticmethod
    def get_cpu_info() -> str:
        """Odczytuje nazwę procesora z /proc/cpuinfo."""
        cpuinfo = "/proc/cpuinfo"
        if os.path.exists(cpuinfo):
            try:
                with open(cpuinfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if "model name" in line:
                            return line.split(":", 1)[1].strip()
                        if "Hardware" in line:
                            return line.split(":", 1)[1].strip()
            except Exception:
                pass
        return platform.processor() or "Nieznany procesor"

    @staticmethod
    def get_memory_info() -> str:
        """Odczytuje całkowitą pamięć RAM z /proc/meminfo."""
        meminfo = "/proc/meminfo"
        if os.path.exists(meminfo):
            try:
                with open(meminfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("MemTotal:"):
                            parts = line.split()
                            kb = int(parts[1])
                            gb = kb / (1024 * 1024)
                            return f"{gb:.1f} GiB RAM"
            except Exception:
                pass
        return "Nieznana"

    @staticmethod
    def get_zram_status() -> str:
        """Odczytuje stan i statystyki kompresji pamięci zRAM."""
        zram_disksize = "/sys/block/zram0/disksize"
        if os.path.exists(zram_disksize):
            try:
                with open(zram_disksize, "r", encoding="utf-8") as f:
                    size_bytes = int(f.read().strip())
                    if size_bytes > 0:
                        size_mb = size_bytes / (1024 * 1024)
                        return f"Aktywny ({size_mb:.0f} MiB przestrzeni kompresowanej zstd)"
            except Exception:
                pass
        return "Nieskonfigurowany lub brak modułu zRAM"


# ============================================================================
# Menedżer aktualizacji z repozytorium GitHub
# ============================================================================

class UpdateManager:
    """Zarządza wersjami i aktualizacjami z repozytorium GitHub."""

    GITHUB_REPO = "h3v3n/okay-de"
    GITHUB_URL = "https://github.com/h3v3n/okay-de"
    API_COMMITS_URL = "https://api.github.com/repos/h3v3n/okay-de/commits/main"
    TARBALL_URL = "https://github.com/h3v3n/okay-de/archive/refs/heads/main.tar.gz"
    LOCAL_VERSION_FILE = os.path.expanduser("~/.config/okay-de/version")
    SYSTEM_VERSION_FILE = "/etc/okay-de/version"

    @classmethod
    def get_local_commit(cls) -> str:
        """Pobiera hash aktualnie zainstalowanego commita."""
        for v_file in [cls.LOCAL_VERSION_FILE, cls.SYSTEM_VERSION_FILE]:
            if os.path.exists(v_file):
                try:
                    with open(v_file, "r", encoding="utf-8") as f:
                        val = f.read().strip()
                        if val:
                            return val
                except Exception:
                    pass

        script_dir = os.path.dirname(os.path.realpath(__file__))
        project_root = os.path.abspath(os.path.join(script_dir, ".."))
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--short", "HEAD"],
                cwd=project_root if os.path.isdir(os.path.join(project_root, ".git")) else None,
                capture_output=True,
                text=True,
                check=False
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception:
            pass

        return "9eede97"

    @classmethod
    def get_remote_commit_sync(cls) -> str:
        """Pobiera skrót commita z API synchronicznie."""
        try:
            req = urllib.request.Request(
                cls.API_COMMITS_URL,
                headers={"User-Agent": "OKay-DE-Settings", "Accept": "application/vnd.github.v3+json"}
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                return data.get("sha", "")[:7].lower()
        except Exception:
            return "latest"


class CheckUpdateWorker(QThread):
    """Wątek asynchronicznego sprawdzania aktualizacji na GitHub."""
    finished = pyqtSignal(dict)

    def run(self):
        local_sha = UpdateManager.get_local_commit().lower()
        try:
            # 1. Sprawdzenie przez GitHub API
            req = urllib.request.Request(
                UpdateManager.API_COMMITS_URL,
                headers={
                    "User-Agent": "OKay-DE-Settings",
                    "Accept": "application/vnd.github.v3+json"
                }
            )
            with urllib.request.urlopen(req, timeout=10) as response:
                data = json.loads(response.read().decode("utf-8"))
                remote_sha = data.get("sha", "")[:7].lower()
                commit_msg = data.get("commit", {}).get("message", "").split("\n")[0]
                author_name = data.get("commit", {}).get("author", {}).get("name", "OKay Developer")
                commit_date = data.get("commit", {}).get("author", {}).get("date", "")[:10]

                has_update = (remote_sha != local_sha) and bool(remote_sha)

                self.finished.emit({
                    "success": True,
                    "has_update": has_update,
                    "local_sha": local_sha,
                    "remote_sha": remote_sha,
                    "commit_msg": commit_msg,
                    "author": author_name,
                    "date": commit_date
                })
                return
        except Exception as e:
            # 2. Fallback przez git ls-remote
            try:
                res = subprocess.run(
                    ["git", "ls-remote", f"{UpdateManager.GITHUB_URL}.git", "HEAD"],
                    capture_output=True,
                    text=True,
                    timeout=10,
                    check=False
                )
                if res.returncode == 0 and res.stdout.strip():
                    remote_sha = res.stdout.strip().split()[0][:7].lower()
                    has_update = (remote_sha != local_sha) and bool(remote_sha)
                    self.finished.emit({
                        "success": True,
                        "has_update": has_update,
                        "local_sha": local_sha,
                        "remote_sha": remote_sha,
                        "commit_msg": "Najnowsza wersja gałęzi main",
                        "author": "GitHub",
                        "date": ""
                    })
                    return
            except Exception:
                pass

            self.finished.emit({
                "success": False,
                "error": str(e),
                "local_sha": local_sha
            })


class InstallUpdateWorker(QThread):
    """Wątek asynchronicznej instalacji aktualizacji."""
    progress = pyqtSignal(str)
    finished = pyqtSignal(bool, str)

    def __init__(self, target_mode: str):
        super().__init__()
        self.target_mode = target_mode

    def run(self):
        try:
            self.progress.emit("Przygotowywanie pobierania...")

            script_dir = os.path.dirname(os.path.realpath(__file__))
            project_root = os.path.abspath(os.path.join(script_dir, ".."))
            is_git_clone = False

            if os.path.isdir(os.path.join(project_root, ".git")):
                res = subprocess.run(
                    ["git", "remote", "get-url", "origin"],
                    cwd=project_root,
                    capture_output=True,
                    text=True,
                    check=False
                )
                if "okay-de" in res.stdout:
                    is_git_clone = True

            work_dir = None
            if is_git_clone:
                self.progress.emit("Pobieranie zmian z repozytorium git (git pull)...")
                subprocess.run(
                    ["git", "pull", "origin", "main"],
                    cwd=project_root,
                    capture_output=True,
                    text=True,
                    check=False
                )
                work_dir = project_root
            else:
                self.progress.emit("Pobieranie archiwum z GitHub...")
                temp_dir = tempfile.mkdtemp(prefix="okay-de-update-")
                archive_path = os.path.join(temp_dir, "main.tar.gz")

                req = urllib.request.Request(
                    UpdateManager.TARBALL_URL,
                    headers={"User-Agent": "OKay-DE-Settings"}
                )
                with urllib.request.urlopen(req, timeout=30) as resp, open(archive_path, "wb") as out_f:
                    shutil.copyfileobj(resp, out_f)

                self.progress.emit("Rozpakowywanie archiwum aktualizacji...")
                with tarfile.open(archive_path, "r:gz") as tar:
                    tar.extractall(path=temp_dir)

                extracted_dirs = [
                    os.path.join(temp_dir, d) for d in os.listdir(temp_dir)
                    if os.path.isdir(os.path.join(temp_dir, d))
                ]
                work_dir = extracted_dirs[0] if extracted_dirs else temp_dir

            if not work_dir or not os.path.exists(work_dir):
                raise RuntimeError("Nie udało się przygotować katalogu źródłowego aktualizacji.")

            # Instalacja
            self.progress.emit(f"Instalowanie aktualizacji ({self.target_mode})...")
            install_script = os.path.join(work_dir, "install.sh")
            if os.path.exists(install_script):
                os.chmod(install_script, 0o755)

            if self.target_mode == "system":
                cmd = ["pkexec", "bash", install_script, "--system"] if shutil.which("pkexec") else ["sudo", "bash", install_script, "--system"]
                res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                if res.returncode != 0:
                    raise RuntimeError(f"Błąd instalacji systemowej: {res.stderr or res.stdout}")
            else:
                cmd = ["bash", install_script, "--user"]
                res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                if res.returncode != 0:
                    raise RuntimeError(f"Błąd instalacji profilu: {res.stderr or res.stdout}")

            # Zapis nowego hasha commita
            try:
                latest_sha = UpdateManager.get_remote_commit_sync()
                os.makedirs(os.path.dirname(UpdateManager.LOCAL_VERSION_FILE), exist_ok=True)
                with open(UpdateManager.LOCAL_VERSION_FILE, "w", encoding="utf-8") as f:
                    f.write(latest_sha)
            except Exception:
                pass

            # Przeładowanie kompozytora i Waybara
            self.progress.emit("Przeładowywanie kompozytora labwc i paska Waybar...")
            subprocess.run(["labwc", "--reconfigure"], check=False)
            subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)

            if shutil.which("notify-send"):
                subprocess.Popen([
                    "notify-send",
                    "OKay DE",
                    "Aktualizacja środowiska została pomyślnie zainstalowana!",
                    "-u", "normal"
                ])

            self.finished.emit(True, "Aktualizacja zakończona sukcesem!")
        except Exception as e:
            self.finished.emit(False, str(e))


# ============================================================================
# Menedżer konfiguracji wyglądu
# ============================================================================

class ConfigManager:
    """Zarządza konfiguracją wyglądu, tapetą i stylami okien."""

    CONFIG_DIR = os.path.expanduser("~/.config/okay-de")
    WAYBAR_DIR = os.path.expanduser("~/.config/waybar")
    LABWC_DIR = os.path.expanduser("~/.config/labwc")
    THEMERC_OVERRIDE = os.path.join(LABWC_DIR, "themerc-override")
    WALLPAPER_TARGET = os.path.join(CONFIG_DIR, "wallpaper.png")
    DOCK_STYLE_FILE = os.path.join(CONFIG_DIR, "dock_style")
    DOCK_CSS_TARGET = os.path.join(WAYBAR_DIR, "dock-style.css")
    PINNED_APPS_FILE = os.path.join(CONFIG_DIR, "pinned_apps.json")
    WAYBAR_CONFIG_FILE = os.path.join(WAYBAR_DIR, "config.jsonc")

    DEFAULT_BUTTON_COLORS = {
        "close": "#f38ba8",
        "max": "#89b4fa",
        "iconify": "#585b70"
    }

    DEFAULT_PINNED_APPS = {
        "foot": {"name": "Terminal (foot)", "icon": "", "cmd": "foot", "enabled": True},
        "pcmanfm": {"name": "Menedżer plików (pcmanfm)", "icon": "󰉋", "cmd": "pcmanfm", "enabled": True},
        "settings": {"name": "Ustawienia OKay", "icon": "󰒓", "cmd": "okay-settings", "enabled": True},
        "firefox": {"name": "Przeglądarka internetowa (firefox)", "icon": "󰈹", "cmd": "firefox", "enabled": False}
    }

    @classmethod
    def get_pinned_apps(cls) -> dict:
        """Pobiera listę przypiętych aplikacji."""
        cls.ensure_dirs()
        apps = dict(cls.DEFAULT_PINNED_APPS)
        if os.path.exists(cls.PINNED_APPS_FILE):
            try:
                with open(cls.PINNED_APPS_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    for k, v in data.items():
                        apps[k] = v
            except Exception:
                pass
        return apps

    @classmethod
    def set_pinned_apps(cls, apps: dict) -> bool:
        """Zapisuje przypięte aplikacje i aktualizuje pasek Waybar."""
        cls.ensure_dirs()
        try:
            with open(cls.PINNED_APPS_FILE, "w", encoding="utf-8") as f:
                json.dump(apps, f, indent=2, ensure_ascii=False)

            cls.sync_waybar_pinned(apps)
            return True
        except Exception as e:
            print(f"Błąd zapisu przypiętych aplikacji: {e}", file=sys.stderr)
            return False

    @classmethod
    def sync_waybar_pinned(cls, apps: dict):
        """Aktualizuje moduły przypiętych aplikacji w pliku config.jsonc Waybara."""
        cls.ensure_dirs()
        config_path = cls.WAYBAR_CONFIG_FILE

        if not os.path.exists(config_path):
            candidates = [
                "/etc/xdg/waybar/config.jsonc",
                os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "config", "waybar", "config.jsonc"))
            ]
            for cand in candidates:
                if os.path.exists(cand):
                    try:
                        shutil.copyfile(cand, config_path)
                        break
                    except Exception:
                        pass

        if not os.path.exists(config_path):
            return

        try:
            with open(config_path, "r", encoding="utf-8") as f:
                config_data = json.load(f)
        except Exception:
            return

        modules_center = config_data.get("modules-center", [])

        # Usunięcie starych custom/pin-*
        new_modules_center = [m for m in modules_center if not m.startswith("custom/pin-")]

        # Pozycja za custom/launcher
        insert_idx = 1
        if "custom/launcher" in new_modules_center:
            insert_idx = new_modules_center.index("custom/launcher") + 1

        for app_id, app_info in apps.items():
            mod_name = f"custom/pin-{app_id}"
            if app_info.get("enabled", False):
                new_modules_center.insert(insert_idx, mod_name)
                insert_idx += 1

            config_data[mod_name] = {
                "format": app_info.get("icon", "󰣇"),
                "on-click": app_info.get("cmd", "true"),
                "tooltip-format": app_info.get("name", "Aplikacja")
            }

        config_data["modules-center"] = new_modules_center

        try:
            with open(config_path, "w", encoding="utf-8") as f:
                json.dump(config_data, f, indent=2, ensure_ascii=False)

            subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)
        except Exception as e:
            print(f"Błąd aktualizacji waybar config.jsonc: {e}", file=sys.stderr)

    @classmethod
    def ensure_dirs(cls):
        """Upewnia się, że katalogi konfiguracji istnieją."""
        os.makedirs(cls.CONFIG_DIR, exist_ok=True)
        os.makedirs(cls.WAYBAR_DIR, exist_ok=True)
        os.makedirs(cls.LABWC_DIR, exist_ok=True)

    @classmethod
    def set_wallpaper(cls, source_path: str) -> bool:
        """Kopiuje wskazaną tapetę i natychmiast aplikuje w PCManFM oraz swaybg."""
        cls.ensure_dirs()
        try:
            shutil.copyfile(source_path, cls.WALLPAPER_TARGET)

            # 1. Pulpit PCManFM
            if shutil.which("pcmanfm"):
                subprocess.run([
                    "pcmanfm",
                    f"-w={cls.WALLPAPER_TARGET}",
                    "--wallpaper-mode=crop"
                ], check=False)

            # 2. swaybg
            subprocess.run(["pkill", "-x", "swaybg"], check=False)
            subprocess.Popen([
                "swaybg",
                "-c", "#1e1e2e",
                "-i", cls.WALLPAPER_TARGET,
                "-m", "fill"
            ])
            return True
        except Exception as e:
            print(f"Błąd zmiany tapety: {e}", file=sys.stderr)
            return False

    @classmethod
    def get_dock_style(cls) -> str:
        """Zwraca aktualny styl docka ('floating' lub 'full')."""
        cls.ensure_dirs()
        if os.path.exists(cls.DOCK_STYLE_FILE):
            try:
                with open(cls.DOCK_STYLE_FILE, "r", encoding="utf-8") as f:
                    return f.read().strip()
            except Exception:
                pass
        return "floating"

    @classmethod
    def set_dock_style(cls, style: str) -> bool:
        """Zapisuje styl docka i natychmiast wysyła SIGUSR2 do waybar."""
        cls.ensure_dirs()
        try:
            with open(cls.DOCK_STYLE_FILE, "w", encoding="utf-8") as f:
                f.write(style)

            if style == "full":
                css_content = (
                    "/* OKay DE - Styl docka: Pełna belka */\n"
                    "window#waybar {\n"
                    "    background-color: #11111b;\n"
                    "    border-top: 2px solid #313244;\n"
                    "    box-shadow: none;\n"
                    "}\n\n"
                    ".modules-center {\n"
                    "    background-color: transparent;\n"
                    "    border: none;\n"
                    "    border-radius: 0;\n"
                    "    padding: 0 8px;\n"
                    "    margin-bottom: 0;\n"
                    "    box-shadow: none;\n"
                    "}\n"
                )
            else:
                css_content = (
                    "/* OKay DE - Styl docka: Pływająca wyspa */\n"
                    "window#waybar {\n"
                    "    background-color: transparent;\n"
                    "    border: none;\n"
                    "    box-shadow: none;\n"
                    "}\n\n"
                    ".modules-center {\n"
                    "    background-color: rgba(30, 30, 46, 0.90);\n"
                    "    border: 1px solid rgba(137, 180, 250, 0.35);\n"
                    "    border-radius: 18px;\n"
                    "    padding: 2px 14px;\n"
                    "    margin-bottom: 8px;\n"
                    "    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);\n"
                    "}\n"
                )

            with open(cls.DOCK_CSS_TARGET, "w", encoding="utf-8") as f:
                f.write(css_content)

            subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)
            return True
        except Exception as e:
            print(f"Błąd zmiany stylu docka: {e}", file=sys.stderr)
            return False

    @classmethod
    def get_button_colors(cls) -> dict:
        """Odczytuje aktualne kolory przycisków okien z themerc-override."""
        colors = dict(cls.DEFAULT_BUTTON_COLORS)
        if os.path.exists(cls.THEMERC_OVERRIDE):
            try:
                with open(cls.THEMERC_OVERRIDE, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("#") or not line:
                            continue
                        if ":" in line:
                            k, v = line.split(":", 1)
                            k, v = k.strip(), v.strip()
                            if k == "window.active.button.unhover.close.color":
                                colors["close"] = v
                            elif k == "window.active.button.unhover.max.color":
                                colors["max"] = v
                            elif k == "window.active.button.unhover.iconify.color":
                                colors["iconify"] = v
            except Exception:
                pass
        return colors

    @classmethod
    def set_button_color(cls, button_type: str, hex_color: str) -> bool:
        """Zapisuje nowy kolor przycisku okna i wykonuje labwc --reconfigure."""
        cls.ensure_dirs()
        current = cls.get_button_colors()
        current[button_type] = hex_color

        c_close = current.get("close", cls.DEFAULT_BUTTON_COLORS["close"])
        c_max = current.get("max", cls.DEFAULT_BUTTON_COLORS["max"])
        c_min = current.get("iconify", cls.DEFAULT_BUTTON_COLORS["iconify"])

        key_map = {
            "window.active.button.unhover.close.color": c_close,
            "window.active.button.hover.close.color": c_close,
            "window.active.button.pressed.close.color": c_close,
            "window.inactive.button.unhover.close.color": "#45475a",
            "window.inactive.button.hover.close.color": c_close,

            "window.active.button.unhover.max.color": c_max,
            "window.active.button.hover.max.color": c_max,
            "window.active.button.pressed.max.color": c_max,
            "window.inactive.button.unhover.max.color": "#45475a",
            "window.inactive.button.hover.max.color": c_max,

            "window.active.button.unhover.iconify.color": c_min,
            "window.active.button.hover.iconify.color": c_min,
            "window.active.button.pressed.iconify.color": c_min,
            "window.inactive.button.unhover.iconify.color": "#45475a",
            "window.inactive.button.hover.iconify.color": c_min,
        }

        lines = []
        if os.path.exists(cls.THEMERC_OVERRIDE):
            try:
                with open(cls.THEMERC_OVERRIDE, "r", encoding="utf-8") as f:
                    lines = f.readlines()
            except Exception:
                pass

        if not lines:
            lines = [
                "# OKay DE - Nakładka motywu kompozytora labwc (Catppuccin Mocha)\n",
                "window.theme: OKay\n",
                "window.cornerRadius: 8\n",
                "window.titlebar.layout: :iconify,max,close\n",
                "titlebar.height: 36\n",
                "window.button.width: 44\n",
                "window.button.height: 22\n",
                "window.button.spacing: 6\n",
                "window.titlebar.padding: 4\n",
                "window.titlebar.padding.width: 8\n",
                "window.titlebar.padding.height: 6\n",
                "window.active.label.text.color: transparent\n",
                "window.inactive.label.text.color: transparent\n",
                "border.width: 2\n",
                "window.active.border.color: #89b4fa\n",
                "window.inactive.border.color: #313244\n"
            ]

        updated_keys = set()
        new_lines = []
        for line in lines:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and ":" in line:
                key = line.split(":", 1)[0].strip()
                if key in key_map:
                    new_lines.append(f"{key}: {key_map[key]}\n")
                    updated_keys.add(key)
                    continue
            new_lines.append(line)

        for k, v in key_map.items():
            if k not in updated_keys:
                new_lines.append(f"{k}: {v}\n")

        try:
            with open(cls.THEMERC_OVERRIDE, "w", encoding="utf-8") as f:
                f.writelines(new_lines)

            subprocess.run(["labwc", "--reconfigure"], check=False)
            return True
        except Exception as e:
            print(f"Błąd zapisu themerc-override: {e}", file=sys.stderr)
            return False


# ============================================================================
# Komponenty UI PyQt6
# ============================================================================

class PreferenceRow(QWidget):
    """Elegancki wiersz preferencji z tytułem, opisem i kontrolką akcji."""

    def __init__(self, title: str, subtitle: str = "", suffix_widget: QWidget = None):
        super().__init__()
        layout = QHBoxLayout(self)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(12)

        vbox = QVBoxLayout()
        vbox.setSpacing(2)

        lbl_title = QLabel(title)
        lbl_title.setObjectName("rowTitle")
        vbox.addWidget(lbl_title)

        if subtitle:
            lbl_sub = QLabel(subtitle)
            lbl_sub.setObjectName("rowSubtitle")
            lbl_sub.setWordWrap(True)
            vbox.addWidget(lbl_sub)
            self.lbl_subtitle = lbl_sub
        else:
            self.lbl_subtitle = None

        layout.addLayout(vbox, stretch=1)

        if suffix_widget:
            layout.addWidget(suffix_widget, alignment=Qt.AlignmentFlag.AlignVCenter)
            self.suffix_widget = suffix_widget

    def set_subtitle(self, text: str):
        if self.lbl_subtitle:
            self.lbl_subtitle.setText(text)


class PreferenceCard(QFrame):
    """Karta grupowania ustawień w stylu nowoczesnego centrum preferencji."""

    def __init__(self, title: str = "", description: str = ""):
        super().__init__()
        self.setObjectName("prefCard")

        self.main_layout = QVBoxLayout(self)
        self.main_layout.setContentsMargins(0, 0, 0, 0)
        self.main_layout.setSpacing(0)

        if title or description:
            header_widget = QWidget()
            header_layout = QVBoxLayout(header_widget)
            header_layout.setContentsMargins(14, 12, 14, 8)
            header_layout.setSpacing(2)

            if title:
                lbl_t = QLabel(title)
                lbl_t.setObjectName("groupTitle")
                header_layout.addWidget(lbl_t)

            if description:
                lbl_d = QLabel(description)
                lbl_d.setObjectName("groupDescription")
                lbl_d.setWordWrap(True)
                header_layout.addWidget(lbl_d)

            self.main_layout.addWidget(header_widget)

            # Linia oddzielająca nagłówek
            sep = QFrame()
            sep.setFrameShape(QFrame.Shape.HLine)
            sep.setObjectName("cardSeparator")
            self.main_layout.addWidget(sep)

        self.rows_container = QVBoxLayout()
        self.rows_container.setContentsMargins(0, 0, 0, 0)
        self.rows_container.setSpacing(0)
        self.main_layout.addLayout(self.rows_container)

    def add_row(self, row_widget: QWidget):
        if self.rows_container.count() > 0:
            sep = QFrame()
            sep.setFrameShape(QFrame.Shape.HLine)
            sep.setObjectName("cardSeparator")
            self.rows_container.addWidget(sep)
        self.rows_container.addWidget(row_widget)


class ColorPickerButton(QPushButton):
    """Przycisk z próbnikiem koloru wyświetlający aktualną barwę hex."""

    color_changed = pyqtSignal(str)

    def __init__(self, initial_hex: str, parent=None):
        super().__init__(parent)
        self.current_hex = initial_hex
        self.setFixedSize(72, 30)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._update_style()
        self.clicked.connect(self._choose_color)

    def _update_style(self):
        self.setText(self.current_hex.upper())
        # Kontrast tekstu
        c = QColor(self.current_hex)
        luminance = (0.299 * c.red() + 0.587 * c.green() + 0.114 * c.blue()) / 255
        text_color = "#11111b" if luminance > 0.5 else "#ffffff"
        self.setStyleSheet(f"""
            QPushButton {{
                background-color: {self.current_hex};
                color: {text_color};
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 6px;
                font-weight: bold;
                font-size: 11px;
            }}
            QPushButton:hover {{
                border: 2px solid #ffffff;
            }}
        """)

    def _choose_color(self):
        color = QColorDialog.getColor(QColor(self.current_hex), self, "Wybierz kolor przycisku")
        if color.isValid():
            self.current_hex = color.name()
            self._update_style()
            self.color_changed.emit(self.current_hex)


class ShortcutBadge(QLabel):
    """Odznaka wizualna dla kombinacji skrótów klawiszowych."""

    def __init__(self, key_combo: str):
        super().__init__(key_combo)
        self.setObjectName("shortcutBadge")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)


