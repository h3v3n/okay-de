    def _on_check_updates_clicked(self, _btn):
        """Uruchamia asynchroniczne sprawdzanie aktualizacji."""
        self.btn_check.set_sensitive(False)
        self.check_spinner.set_visible(True)
        self.check_spinner.start()
        self.row_status_msg.set_title("Sprawdzanie...")
        self.row_status_msg.set_subtitle("Łączenie z GitHub API (h3v3n/okay-de)...")

        UpdateManager.check_for_updates(self._on_update_check_finished)

    def _on_update_check_finished(self, result: dict):
        """Obsługuje wynik sprawdzania aktualizacji w głównym wątku GTK."""
        self.btn_check.set_sensitive(True)
        self.check_spinner.stop()
        self.check_spinner.set_visible(False)

        if not result.get("success"):
            err = result.get("error", "Błąd połączenia z siecią")
            self.row_status_msg.set_title("Błąd sprawdzania aktualizacji")
            self.row_status_msg.set_subtitle(f"Nie udało się pobrać informacji: {err}")
            self.row_status_msg.set_icon_name("dialog-error-symbolic")
            self.group_update_info.set_visible(False)
            return

        local_sha = result.get("local_sha", "")
        remote_sha = result.get("remote_sha", "")
        has_update = result.get("has_update", False)

        if has_update:
            self.row_status_msg.set_title("Dostępna jest nowa wersja!")
            self.row_status_msg.set_subtitle(f"Lokalna: {local_sha} ➔ GitHub: {remote_sha}")
            self.row_status_msg.set_icon_name("software-update-available-symbolic")

            author = result.get("author", "OKay Developer")
            date = result.get("date", "")
            date_info = f" | {date}" if date else ""
            self.row_remote_version.set_subtitle(f"Commit {remote_sha} ({author}{date_info})")
            self.row_commit_msg.set_subtitle(result.get("commit_msg", "Brak opisu zmian"))
            self.group_update_info.set_visible(True)
        else:
            self.row_status_msg.set_title("System jest aktualny")
            self.row_status_msg.set_subtitle(f"Posiadasz najnowszą wersję OKay DE ({local_sha}).")
            self.row_status_msg.set_icon_name("emblem-ok-symbolic")
            self.group_update_info.set_visible(False)

    def _on_install_update_clicked(self, _btn):
        """Uruchamia asynchroniczną instalację aktualizacji."""
        mode = "system" if self.row_install_mode.get_selected() == 1 else "user"
        self.btn_install.set_sensitive(False)
        self.btn_check.set_sensitive(False)
        self.install_spinner.set_visible(True)
        self.install_spinner.start()
        self.row_install_action.set_subtitle("Inicjowanie procesu aktualizacji...")

        def on_progress(msg: str):
            self.row_install_action.set_subtitle(msg)

        def on_finish(success: bool, msg: str):
            self.btn_install.set_sensitive(True)
            self.btn_check.set_sensitive(True)
            self.install_spinner.stop()
            self.install_spinner.set_visible(False)
            self.row_install_action.set_subtitle(msg)

            if success:
                new_sha = UpdateManager.get_local_commit()
                self.lbl_local_version.set_text(new_sha)
                self.group_update_info.set_visible(False)
                self.row_status_msg.set_title("System jest aktualny")
                self.row_status_msg.set_subtitle(f"Pomyślnie zaktualizowano do wersji {new_sha}.")
                self.row_status_msg.set_icon_name("emblem-ok-symbolic")
                self._show_alert(
                    "Aktualizacja zakończona",
                    "OKay DE zostało pomyślnie zaktualizowane!\n"
                    "Konfiguracja kompozytora labwc oraz pasek Waybar zostały odświeżone."
                )
            else:
                self._show_alert("Błąd aktualizacji", f"Instalacja aktualizacji nie powiodła się:\n\n{msg}")

        UpdateManager.install_update(mode, on_progress, on_finish)

    # -------------------------------------------------------------
    # Moduł 6: O systemie (Informacje)
    # -------------------------------------------------------------
    def _init_about_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Informacje")
        page.set_icon_name("help-about-symbolic")

        group = Adw.PreferencesGroup()
        group.set_title("O systemie")
        group.set_description("Podstawowe dane o sprzęcie i zainstalowanym oprogramowaniu.")

        self._add_info_row(group, "Dystrybucja", SystemHelper.get_distro_name(), "distributor-logo-symbolic")
        self._add_info_row(group, "Środowisko graficzne", SystemHelper.get_desktop_info(), "user-desktop-symbolic")
        self._add_info_row(group, "Wersja OKay DE", f"Commit {UpdateManager.get_local_commit()}", "software-update-available-symbolic")
        self._add_info_row(group, "Wersja jądra Linux", SystemHelper.get_kernel_release(), "applications-system-symbolic")
        self._add_info_row(group, "Procesor (CPU)", SystemHelper.get_cpu_info(), "cpu-symbolic")
        self._add_info_row(group, "Pamięć operacyjna", SystemHelper.get_memory_info(), "drive-harddisk-symbolic")

        page.add(group)
        self.add(page)

    def _add_info_row(self, group: Adw.PreferencesGroup, title: str, value: str, icon_name: str):
        """Pomocniczy wiersz informacji o systemie."""
        row = Adw.ActionRow()
        row.set_title(title)
        row.set_icon_name(icon_name)

        label = Gtk.Label(label=value)
        label.set_selectable(True)
        label.add_css_class("dim-label")
        label.set_valign(Gtk.Align.CENTER)

        row.add_suffix(label)
        group.add(row)


class OkaySettingsApp(Adw.Application):
    """Główna aplikacja Libadwaita."""

    def __init__(self):
        super().__init__(
            application_id="org.oksavi.okay.settings",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        # Wymuszenie ciemnego motywu Catppuccin Mocha / Adwaita Dark
        style_manager = Adw.StyleManager.get_default()
        style_manager.set_color_scheme(Adw.ColorScheme.FORCE_DARK)

        win = self.props.active_window
        if not win:
            win = OkaySettingsWindow(application=self)
        win.present()


def main():
    """Punkt startowy programu."""
    app = OkaySettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
