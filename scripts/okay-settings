# Sprawdzenie obecności PyQt6
try:
    from PyQt6.QtWidgets import (
        QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
        QStackedWidget, QLabel, QPushButton,
        QComboBox, QFileDialog, QCheckBox, QFrame,
        QScrollArea, QMessageBox, QProgressBar, QSizePolicy, QSpacerItem,
        QInputDialog, QButtonGroup
    )
    from PyQt6.QtCore import Qt, QThread, pyqtSignal, QSize
    from PyQt6.QtGui import QColor, QFont, QIcon, QPalette, QPixmap
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek PyQt6: {err}\n"
        "Zainstaluj wymagany pakiet: python-pyqt6.",
        file=sys.stderr
    )
    if shutil.which("notify-send"):
        subprocess.run([
            "notify-send",
            "Błąd OKay Settings",
            "Wymagany pakiet: python-pyqt6",
            "-u", "critical"
        ], check=False)
    sys.exit(1)


# ============================================================================
# Narzędzia systemowe i pomocnicze
# ============================================================================

class SystemHelper:
    """Klasa narzędziowa do pobierania informacji o sprzęcie i systemie."""

    @staticmethod
    def get_distro_name() -> str:
        """Pobiera nazwę dystrybucji z /etc/os-release z fallbackiem na OKsavi Linux."""
        os_release = "/etc/os-release"
        if os.path.exists(os_release):
            try:
                with open(os_release, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("PRETTY_NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
                        if line.startswith("NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
            except Exception:
                pass
        return "OKsavi Linux"

    @staticmethod
    def get_desktop_info() -> str:
        """Zwraca identyfikator środowiska graficznego."""
        return "OKay DE (Wayland / labwc)"

    @staticmethod
    def get_kernel_release() -> str:
        """Zwraca wersję jądra Linux."""
        return platform.release()

    @staticmethod
    def get_cpu_info() -> str:
        """Odczytuje nazwę procesora z /proc/cpuinfo."""
        cpuinfo = "/proc/cpuinfo"
        if os.path.exists(cpuinfo):
            try:
                with open(cpuinfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if "model name" in line:
                            return line.split(":", 1)[1].strip()
                        if "Hardware" in line:
                            return line.split(":", 1)[1].strip()
            except Exception:
                pass
        return platform.processor() or "Nieznany procesor"

    @staticmethod
    def get_memory_info() -> str:
        """Odczytuje całkowitą pamięć RAM z /proc/meminfo."""
        meminfo = "/proc/meminfo"
        if os.path.exists(meminfo):
            try:
                with open(meminfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("MemTotal:"):
                            parts = line.split()
                            kb = int(parts[1])
                            gb = kb / (1024 * 1024)
                            return f"{gb:.1f} GiB RAM"
            except Exception:
                pass
        return "Nieznana"

    @staticmethod
    def get_zram_status() -> str:
        """Odczytuje stan i statystyki kompresji pamięci zRAM."""
        zram_disksize = "/sys/block/zram0/disksize"
        if os.path.exists(zram_disksize):
            try:
                with open(zram_disksize, "r", encoding="utf-8") as f:
                    size_bytes = int(f.read().strip())
                    if size_bytes > 0:
                        size_mb = size_bytes / (1024 * 1024)
                        return f"Aktywny ({size_mb:.0f} MiB przestrzeni kompresowanej zstd)"
            except Exception:
                pass
        return "Nieskonfigurowany lub brak modułu zRAM"


# ============================================================================
# Menedżer aktualizacji z repozytorium GitHub
# ============================================================================

class UpdateManager:
    """Zarządza wersjami i aktualizacjami z repozytorium GitHub."""

    GITHUB_REPO = "h3v3n/okay-de"
    GITHUB_URL = "https://github.com/h3v3n/okay-de"
    API_COMMITS_URL = "https://api.github.com/repos/h3v3n/okay-de/commits/main"
    TARBALL_URL = "https://github.com/h3v3n/okay-de/archive/refs/heads/main.tar.gz"
    LOCAL_VERSION_FILE = os.path.expanduser("~/.config/okay-de/version")
    SYSTEM_VERSION_FILE = "/etc/okay-de/version"

    @classmethod
    def get_local_commit(cls) -> str:
        """Pobiera hash aktualnie zainstalowanego commita."""
        for v_file in [cls.LOCAL_VERSION_FILE, cls.SYSTEM_VERSION_FILE]:
            if os.path.exists(v_file):
                try:
                    with open(v_file, "r", encoding="utf-8") as f:
                        val = f.read().strip()
                        if val:
                            return val
                except Exception:
                    pass

        script_dir = os.path.dirname(os.path.realpath(__file__))
        project_root = os.path.abspath(os.path.join(script_dir, ".."))
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--short", "HEAD"],
                cwd=project_root if os.path.isdir(os.path.join(project_root, ".git")) else None,
                capture_output=True,
                text=True,
                check=False
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception:
            pass

        return "9eede97"

    @classmethod
    def get_remote_commit_sync(cls) -> str:
        """Pobiera skrót commita z API synchronicznie."""
        try:
            req = urllib.request.Request(
                cls.API_COMMITS_URL,
                headers={"User-Agent": "OKay-DE-Settings", "Accept": "application/vnd.github.v3+json"}
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                return data.get("sha", "")[:7].lower()
        except Exception:
            return "latest"


class CheckUpdateWorker(QThread):
    """Wątek asynchronicznego sprawdzania aktualizacji na GitHub."""
    finished = pyqtSignal(dict)

    def run(self):
        local_sha = UpdateManager.get_local_commit().lower()
        try:
            req = urllib.request.Request(
                UpdateManager.API_COMMITS_URL,
                headers={
                    "User-Agent": "OKay-DE-Settings",
                    "Accept": "application/vnd.github.v3+json"
                }
            )
            with urllib.request.urlopen(req, timeout=10) as response:
                data = json.loads(response.read().decode("utf-8"))
                remote_sha = data.get("sha", "")[:7].lower()
                commit_msg = data.get("commit", {}).get("message", "").split("\n")[0]
                author_name = data.get("commit", {}).get("author", {}).get("name", "OKay Developer")
                commit_date = data.get("commit", {}).get("author", {}).get("date", "")[:10]

                has_update = (remote_sha != local_sha) and bool(remote_sha)

                self.finished.emit({
                    "success": True,
                    "has_update": has_update,
                    "local_sha": local_sha,
                    "remote_sha": remote_sha,
                    "commit_msg": commit_msg,
                    "author": author_name,
                    "date": commit_date
                })
                return
        except Exception as e:
            try:
                res = subprocess.run(
                    ["git", "ls-remote", f"{UpdateManager.GITHUB_URL}.git", "HEAD"],
                    capture_output=True,
                    text=True,
                    timeout=10,
                    check=False
                )
                if res.returncode == 0 and res.stdout.strip():
                    remote_sha = res.stdout.strip().split()[0][:7].lower()
                    has_update = (remote_sha != local_sha) and bool(remote_sha)
                    self.finished.emit({
                        "success": True,
                        "has_update": has_update,
                        "local_sha": local_sha,
                        "remote_sha": remote_sha,
                        "commit_msg": "Najnowsza wersja gałęzi main",
                        "author": "GitHub",
                        "date": ""
                    })
                    return
            except Exception:
                pass

            self.finished.emit({
                "success": False,
                "error": str(e),
                "local_sha": local_sha
            })


class InstallUpdateWorker(QThread):
    """Wątek asynchronicznej instalacji aktualizacji."""
    progress = pyqtSignal(str)
    finished = pyqtSignal(bool, str)

    def __init__(self, target_mode: str):
        super().__init__()
        self.target_mode = target_mode

    def run(self):
        try:
            self.progress.emit("Przygotowywanie pobierania...")

            script_dir = os.path.dirname(os.path.realpath(__file__))
            project_root = os.path.abspath(os.path.join(script_dir, ".."))
            is_git_clone = False

            if os.path.isdir(os.path.join(project_root, ".git")):
                res = subprocess.run(
                    ["git", "remote", "get-url", "origin"],
                    cwd=project_root,
                    capture_output=True,
                    text=True,
                    check=False
                )
                if "okay-de" in res.stdout:
                    is_git_clone = True

            work_dir = None
            if is_git_clone:
                self.progress.emit("Pobieranie zmian z repozytorium git (git pull)...")
                subprocess.run(
                    ["git", "pull", "origin", "main"],
                    cwd=project_root,
                    capture_output=True,
                    text=True,
                    check=False
                )
                work_dir = project_root
            else:
                self.progress.emit("Pobieranie archiwum z GitHub...")
                temp_dir = tempfile.mkdtemp(prefix="okay-de-update-")
                archive_path = os.path.join(temp_dir, "main.tar.gz")

                req = urllib.request.Request(
                    UpdateManager.TARBALL_URL,
                    headers={"User-Agent": "OKay-DE-Settings"}
                )
                with urllib.request.urlopen(req, timeout=30) as resp, open(archive_path, "wb") as out_f:
                    shutil.copyfileobj(resp, out_f)

                self.progress.emit("Rozpakowywanie archiwum aktualizacji...")
                with tarfile.open(archive_path, "r:gz") as tar:
                    tar.extractall(path=temp_dir)

                extracted_dirs = [
                    os.path.join(temp_dir, d) for d in os.listdir(temp_dir)
                    if os.path.isdir(os.path.join(temp_dir, d))
                ]
                work_dir = extracted_dirs[0] if extracted_dirs else temp_dir

            if not work_dir or not os.path.exists(work_dir):
                raise RuntimeError("Nie udało się przygotować katalogu źródłowego aktualizacji.")

            self.progress.emit(f"Instalowanie aktualizacji ({self.target_mode})...")
            install_script = os.path.join(work_dir, "install.sh")
            if os.path.exists(install_script):
                os.chmod(install_script, 0o755)

            if self.target_mode == "system":
                cmd = ["pkexec", "bash", install_script, "--system"] if shutil.which("pkexec") else ["sudo", "bash", install_script, "--system"]
                res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                if res.returncode != 0:
                    raise RuntimeError(f"Błąd instalacji systemowej: {res.stderr or res.stdout}")
            else:
                cmd = ["bash", install_script, "--user"]
                res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                if res.returncode != 0:
                    raise RuntimeError(f"Błąd instalacji profilu: {res.stderr or res.stdout}")

            try:
                latest_sha = UpdateManager.get_remote_commit_sync()
                os.makedirs(os.path.dirname(UpdateManager.LOCAL_VERSION_FILE), exist_ok=True)
                with open(UpdateManager.LOCAL_VERSION_FILE, "w", encoding="utf-8") as f:
                    f.write(latest_sha)
            except Exception:
                pass

            # Przeładowanie kompozytora i paska docka
            self.progress.emit("Przeładowywanie kompozytora labwc i paska zadań...")
            subprocess.run(["pkill", "-x", "waybar"], check=False)
            subprocess.run(["pkill", "-x", "okay-dock"], check=False)
            subprocess.run(["labwc", "--reconfigure"], check=False)
            subprocess.Popen(["okay-dock"])

            if shutil.which("notify-send"):
                subprocess.Popen([
                    "notify-send",
                    "OKay DE",
                    "Aktualizacja środowiska została pomyślnie zainstalowana!",
                    "-u", "normal"
                ])

            self.finished.emit(True, "Aktualizacja zakończona sukcesem!")
        except Exception as e:
            self.finished.emit(False, str(e))


# ============================================================================
# Menedżer konfiguracji wyglądu
# ============================================================================

class ConfigManager:
    """Zarządza konfiguracją wyglądu, tapetą i przypiętymi aplikacjami."""

    CONFIG_DIR = os.path.expanduser("~/.config/okay-de")
    LABWC_DIR = os.path.expanduser("~/.config/labwc")
    WALLPAPER_TARGET = os.path.join(CONFIG_DIR, "wallpaper.png")
    PINNED_APPS_FILE = os.path.join(CONFIG_DIR, "pinned_apps.json")

    DEFAULT_PINNED_APPS = {
        "foot": {"name": "Terminal (foot)", "icon": "", "cmd": "foot", "enabled": True},
        "pcmanfm": {"name": "Menedżer plików (pcmanfm)", "icon": "󰉋", "cmd": "pcmanfm", "enabled": True},
        "settings": {"name": "Ustawienia OKay", "icon": "󰒓", "cmd": "okay-settings", "enabled": True},
        "firefox": {"name": "Przeglądarka internetowa (firefox)", "icon": "󰈹", "cmd": "firefox", "enabled": False}
    }

    @classmethod
    def get_pinned_apps(cls) -> dict:
        """Pobiera listę przypiętych aplikacji."""
        cls.ensure_dirs()
        apps = dict(cls.DEFAULT_PINNED_APPS)
        if os.path.exists(cls.PINNED_APPS_FILE):
            try:
                with open(cls.PINNED_APPS_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    for k, v in data.items():
                        apps[k] = v
            except Exception:
                pass
        return apps

    @classmethod
    def set_pinned_apps(cls, apps: dict) -> bool:
        """Zapisuje przypięte aplikacje do pliku konfiguracyjnego docka."""
        cls.ensure_dirs()
        try:
            with open(cls.PINNED_APPS_FILE, "w", encoding="utf-8") as f:
                json.dump(apps, f, indent=2, ensure_ascii=False)
            return True
        except Exception as e:
            print(f"Błąd zapisu przypiętych aplikacji: {e}", file=sys.stderr)
            return False

    @classmethod
    def ensure_dirs(cls):
        """Upewnia się, że katalogi konfiguracji istnieją."""
        os.makedirs(cls.CONFIG_DIR, exist_ok=True)
        os.makedirs(cls.LABWC_DIR, exist_ok=True)

    @classmethod
    def set_wallpaper(cls, source_path: str) -> bool:
        """Kopiuje wskazaną tapetę i natychmiast aplikuje w PCManFM oraz swaybg."""
        cls.ensure_dirs()
        try:
            shutil.copyfile(source_path, cls.WALLPAPER_TARGET)

            # 1. Pulpit PCManFM
            if shutil.which("pcmanfm"):
                subprocess.run([
                    "pcmanfm",
                    f"-w={cls.WALLPAPER_TARGET}",
                    "--wallpaper-mode=crop"
                ], check=False)

            # 2. swaybg
            subprocess.run(["pkill", "-x", "swaybg"], check=False)
            subprocess.Popen([
                "swaybg",
                "-c", "#1e1e2e",
                "-i", cls.WALLPAPER_TARGET,
                "-m", "fill"
            ])
            return True
        except Exception as e:
            print(f"Błąd zmiany tapety: {e}", file=sys.stderr)
            return False


# ============================================================================
# Komponenty UI PyQt6
# ============================================================================

class PreferenceRow(QWidget):
    """Elegancki wiersz preferencji z tytułem, opisem i kontrolką akcji."""

    def __init__(self, title: str, subtitle: str = "", suffix_widget: QWidget = None):
        super().__init__()
        layout = QHBoxLayout(self)
        layout.setContentsMargins(16, 12, 16, 12)
        layout.setSpacing(12)

        vbox = QVBoxLayout()
        vbox.setSpacing(3)

        lbl_title = QLabel(title)
        lbl_title.setObjectName("rowTitle")
        vbox.addWidget(lbl_title)

        if subtitle:
            lbl_sub = QLabel(subtitle)
            lbl_sub.setObjectName("rowSubtitle")
            lbl_sub.setWordWrap(True)
            vbox.addWidget(lbl_sub)
            self.lbl_subtitle = lbl_sub
        else:
            self.lbl_subtitle = None

        layout.addLayout(vbox, stretch=1)

        if suffix_widget:
            layout.addWidget(suffix_widget, alignment=Qt.AlignmentFlag.AlignVCenter)
            self.suffix_widget = suffix_widget

    def set_subtitle(self, text: str):
        if self.lbl_subtitle:
            self.lbl_subtitle.setText(text)


class PreferenceCard(QFrame):
    """Karta grupowania ustawień w stylu nowoczesnego centrum preferencji."""

    def __init__(self, title: str = "", description: str = ""):
        super().__init__()
        self.setObjectName("prefCard")

        self.main_layout = QVBoxLayout(self)
        self.main_layout.setContentsMargins(0, 0, 0, 0)
        self.main_layout.setSpacing(0)

        if title or description:
            header_widget = QWidget()
            header_layout = QVBoxLayout(header_widget)
            header_layout.setContentsMargins(16, 14, 16, 10)
            header_layout.setSpacing(3)

            if title:
                lbl_t = QLabel(title)
                lbl_t.setObjectName("groupTitle")
                header_layout.addWidget(lbl_t)

            if description:
                lbl_d = QLabel(description)
                lbl_d.setObjectName("groupDescription")
                lbl_d.setWordWrap(True)
                header_layout.addWidget(lbl_d)

            self.main_layout.addWidget(header_widget)

            sep = QFrame()
            sep.setFrameShape(QFrame.Shape.HLine)
            sep.setObjectName("cardSeparator")
            self.main_layout.addWidget(sep)

        self.rows_container = QVBoxLayout()
        self.rows_container.setContentsMargins(0, 0, 0, 0)
        self.rows_container.setSpacing(0)
        self.main_layout.addLayout(self.rows_container)

    def add_row(self, row_widget: QWidget):
        if self.rows_container.count() > 0:
            sep = QFrame()
            sep.setFrameShape(QFrame.Shape.HLine)
            sep.setObjectName("cardSeparator")
            self.rows_container.addWidget(sep)
        self.rows_container.addWidget(row_widget)


class ShortcutBadge(QLabel):
    """Odznaka wizualna dla kombinacji skrótów klawiszowych."""

    def __init__(self, key_combo: str):
        super().__init__(key_combo)
        self.setObjectName("shortcutBadge")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)


class SidebarButton(QPushButton):
    """Przycisk nawigacyjny paska bocznego ze stabilnymi wymiarami."""

    def __init__(self, text: str, parent=None):
        super().__init__(text, parent)
        self.setObjectName("sidebarBtn")
        self.setCheckable(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFixedHeight(44)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)


# ============================================================================
# Strony modułów (Pages)
# ============================================================================

class AppearancePage(QWidget):
    """Moduł: Wygląd i Pulpit."""

    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(18)

        # 1. Karta Tapeta i Pulpit
        card_desktop = PreferenceCard("Tapeta i Pulpit", "Dostosuj tło pulpitu oraz grafikę tła dla sesji Wayland.")

        btn_wallpaper = QPushButton("Zmień tapetę...")
        btn_wallpaper.setProperty("class", "suggested-btn")
        btn_wallpaper.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_wallpaper.clicked.connect(self._change_wallpaper)
        self.row_wallpaper = PreferenceRow(
            "Tapeta pulpitu",
            "Wybierz plik graficzny (PNG, JPG, WEBP)",
            btn_wallpaper
        )
        card_desktop.add_row(self.row_wallpaper)
        layout.addWidget(card_desktop)

        # 2. Karta Przypięte aplikacje w pasku zadań (Taskbar)
        card_pinned = PreferenceCard(
            "Przypięte aplikacje w pasku zadań (Taskbar)",
            "Zarządzaj skrótami do programów stale widocznymi na dolnym pasku zadań OKay Dock."
        )

        self.pinned_apps = ConfigManager.get_pinned_apps()
        self.pin_checkboxes = {}

        for app_id, app_info in self.pinned_apps.items():
            chk = QCheckBox("Przypięta")
            chk.setChecked(app_info.get("enabled", False))
            chk.toggled.connect(self._create_pin_toggle_handler(app_id))
            self.pin_checkboxes[app_id] = chk

            row = PreferenceRow(
                f"{app_info.get('icon', '󰣇')}  {app_info.get('name', app_id)}",
                f"Polecenie: {app_info.get('cmd', '')}",
                chk
            )
            card_pinned.add_row(row)

        btn_add_pin = QPushButton("+ Przypnij nową aplikację...")
        btn_add_pin.setProperty("class", "suggested-btn")
        btn_add_pin.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_add_pin.clicked.connect(self._add_custom_pinned_app)
        card_pinned.add_row(PreferenceRow(
            "Dodaj własny skrót",
            "Zdefiniuj nowy program do przypięcia na pasku zadań",
            btn_add_pin
        ))

        layout.addWidget(card_pinned)
        layout.addStretch()

    def _create_pin_toggle_handler(self, app_id: str):
        def handler(checked: bool):
            if app_id in self.pinned_apps:
                self.pinned_apps[app_id]["enabled"] = checked
                ConfigManager.set_pinned_apps(self.pinned_apps)
        return handler

    def _add_custom_pinned_app(self):
        name, ok1 = QInputDialog.getText(self, "Przypnij aplikację", "Nazwa aplikacji:")
        if not ok1 or not name.strip():
            return
        cmd, ok2 = QInputDialog.getText(self, "Przypnij aplikację", f"Polecenie dla '{name}':")
        if not ok2 or not cmd.strip():
            return
        icon, ok3 = QInputDialog.getText(self, "Przypnij aplikację", "Symbol ikony (np. 󰅩, , 󰈹):", text="󰣇")
        if not ok3 or not icon.strip():
            icon = "󰣇"

        app_id = f"custom_{len(self.pinned_apps) + 1}"
        self.pinned_apps[app_id] = {
            "name": name.strip(),
            "cmd": cmd.strip(),
            "icon": icon.strip(),
            "enabled": True
        }
        ConfigManager.set_pinned_apps(self.pinned_apps)
        QMessageBox.information(
            self,
            "OKay DE",
            f"Aplikacja '{name}' została pomyślnie przypięta do paska zadań!"
        )

    def _change_wallpaper(self):
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Wybierz tapetę pulpitu",
            os.path.expanduser("~"),
            "Pliki graficzne (*.png *.jpg *.jpeg *.webp)"
        )
        if file_path:
            success = ConfigManager.set_wallpaper(file_path)
            if success:
                self.row_wallpaper.set_subtitle(f"Aktywna: {os.path.basename(file_path)}")
                if shutil.which("notify-send"):
                    subprocess.Popen([
                        "notify-send",
                        "OKay DE",
                        f"Ustawiono nową tapetę:\n{os.path.basename(file_path)}"
                    ])


class SystemPage(QWidget):
    """Moduł: System i Ekran."""

    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(18)

        card = PreferenceCard("Szybkie narzędzia", "Zarządzaj monitorami, rozdzielczością i urządzeniami audio.")

        # wdisplays
        btn_display = QPushButton("Uruchom wdisplays")
        btn_display.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_display.clicked.connect(self._launch_wdisplays)
        card.add_row(PreferenceRow(
            "Ustawienia ekranu",
            "Konfiguracja monitorów, pozycji i rozdzielczości (wdisplays)",
            btn_display
        ))

        # pavucontrol
        btn_audio = QPushButton("Uruchom mikser")
        btn_audio.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_audio.clicked.connect(self._launch_pavucontrol)
        card.add_row(PreferenceRow(
            "Ustawienia dźwięku",
            "Zaawansowany mikser i urządzenia wyjściowe (pavucontrol)",
            btn_audio
        ))

        layout.addWidget(card)
        layout.addStretch()

    def _launch_wdisplays(self):
        if shutil.which("wdisplays"):
            subprocess.Popen(["wdisplays"])
        else:
            QMessageBox.warning(
                self,
                "Brak programu wdisplays",
                "Narzędzie do konfiguracji ekranów 'wdisplays' nie jest zainstalowane.\n\n"
                "Możesz je zainstalować poleceniem:\n"
                "sudo pacman -S wdisplays"
            )

    def _launch_pavucontrol(self):
        if shutil.which("pavucontrol"):
            subprocess.Popen(["pavucontrol"])
        else:
            QMessageBox.warning(
                self,
                "Brak miksera pavucontrol",
                "Graficzny mikser dźwięku 'pavucontrol' nie jest zainstalowany.\n\n"
                "Możesz go zainstalować poleceniem:\n"
                "sudo pacman -S pavucontrol"
            )


class PerformancePage(QWidget):
    """Moduł: Wydajność i Zasoby (Ghost Runner + zRAM)."""

    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(18)

        card_ghost = PreferenceCard(
            "Zarządca zasobów OKsavi (Ghost Runner)",
            "Optymalizacja cgroups v2, priorytetów zadań oraz pamięci kompresowanej zRAM."
        )

        self.chk_ghost = QCheckBox("Aktywny")
        self.chk_ghost.setChecked(self._is_ghost_runner_running())
        self.chk_ghost.toggled.connect(self._toggle_ghost_runner)
        card_ghost.add_row(PreferenceRow(
            "Demon oksavi-ghost-runner",
            "Optymalizacja procesów tła i pamięci podręcznej",
            self.chk_ghost
        ))

        self.row_zram = PreferenceRow(
            "Kompresja pamięci zRAM",
            SystemHelper.get_zram_status()
        )
        card_ghost.add_row(self.row_zram)
        layout.addWidget(card_ghost)

        card_maint = PreferenceCard(
            "Konserwacja pamięci operacyjnej",
            "Zwalnianie buforów dyskowych i stron stronicowania jądra."
        )

        btn_flush = QPushButton("Oczyść RAM")
        btn_flush.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_flush.clicked.connect(self._flush_ram)
        card_maint.add_row(PreferenceRow(
            "Zwolnij pamięć podręczną (Drop Caches)",
            "Wymusza zrzut nieużywanych buforów systemowych",
            btn_flush
        ))

        layout.addWidget(card_maint)
        layout.addStretch()

    def _is_ghost_runner_running(self) -> bool:
        try:
            res = subprocess.run(["pgrep", "-x", "oksavi-ghost-runner"], capture_output=True, check=False)
            return res.returncode == 0
        except Exception:
            return False

    def _toggle_ghost_runner(self, checked: bool):
        if checked:
            subprocess.Popen(["oksavi-ghost-runner", "--start"])
        else:
            subprocess.run(["oksavi-ghost-runner", "--stop"], check=False)

    def _flush_ram(self):
        try:
            subprocess.run(["sync"], check=False)
            if shutil.which("pkexec"):
                subprocess.run(["pkexec", "sh", "-c", "echo 3 > /proc/sys/vm/drop_caches"], check=False)
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "OKay DE", "Zwolniono pamięć podręczną RAM.", "-u", "low"])
            QMessageBox.information(self, "OKay DE", "Pamięć podręczna RAM została pomyślnie oczyszczona.")
        except Exception as e:
            QMessageBox.critical(self, "Błąd", f"Nie udało się oczyścić pamięci: {e}")


