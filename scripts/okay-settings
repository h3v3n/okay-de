#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Settings (okay-settings)
Natywne centrum sterowania środowiska graficznego OKay DE dla dystrybucji OKsavi Linux.
Stos technologiczny: Python 3, GTK4, Libadwaita.
"""

import os
import sys
import json
import shutil
import platform
import subprocess
import threading
import tarfile
import tempfile
import urllib.request
import urllib.error

# Zapobieganie 25-sekundowemu opóźnieniu D-Bus xdg-desktop-portal
os.environ.setdefault("GTK_USE_PORTAL", "0")

try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Gdk, Adw, Gio, GLib
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek GTK/Libadwaita: {err}\n"
        "Zainstaluj wymagane pakiety: python-gobject, libadwaita, gtk4.",
        file=sys.stderr
    )
    if shutil.which("notify-send"):
        subprocess.run([
            "notify-send",
            "Błąd OKay Settings",
            "Wymagane pakiety: python-gobject, libadwaita, gtk4",
            "-u", "critical"
        ], check=False)
    sys.exit(1)


class SystemHelper:
    """Klasa narzędziowa do pobierania informacji o sprzęcie i systemie."""

    @staticmethod
    def get_distro_name() -> str:
        """Pobiera nazwę dystrybucji z /etc/os-release z fallbackiem na OKsavi Linux."""
        os_release = "/etc/os-release"
        if os.path.exists(os_release):
            try:
                with open(os_release, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("PRETTY_NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
                        if line.startswith("NAME="):
                            return line.split("=", 1)[1].strip().strip('"')
            except Exception:
                pass
        return "OKsavi Linux"

    @staticmethod
    def get_desktop_info() -> str:
        """Zwraca identyfikator środowiska graficznego."""
        return "OKay DE (Wayland / labwc)"

    @staticmethod
    def get_kernel_release() -> str:
        """Zwraca wersję jądra Linux."""
        return platform.release()

    @staticmethod
    def get_cpu_info() -> str:
        """Odczytuje nazwę procesora z /proc/cpuinfo."""
        cpuinfo = "/proc/cpuinfo"
        if os.path.exists(cpuinfo):
            try:
                with open(cpuinfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if "model name" in line:
                            return line.split(":", 1)[1].strip()
                        if "Hardware" in line:
                            return line.split(":", 1)[1].strip()
            except Exception:
                pass
        return platform.processor() or "Nieznany procesor"

    @staticmethod
    def get_memory_info() -> str:
        """Odczytuje całkowitą pamięć RAM z /proc/meminfo."""
        meminfo = "/proc/meminfo"
        if os.path.exists(meminfo):
            try:
                with open(meminfo, "r", encoding="utf-8") as f:
                    for line in f:
                        if line.startswith("MemTotal:"):
                            parts = line.split()
                            kb = int(parts[1])
                            gb = kb / (1024 * 1024)
                            return f"{gb:.1f} GiB RAM"
            except Exception:
                pass
        return "Nieznana"

    @staticmethod
    def get_zram_status() -> str:
        """Odczytuje stan i statystyki kompresji pamięci zRAM."""
        zram_disksize = "/sys/block/zram0/disksize"
        if os.path.exists(zram_disksize):
            try:
                with open(zram_disksize, "r", encoding="utf-8") as f:
                    size_bytes = int(f.read().strip())
                    if size_bytes > 0:
                        size_mb = size_bytes / (1024 * 1024)
                        return f"Aktywny ({size_mb:.0f} MiB przestrzeni kompresowanej zstd)"
            except Exception:
                pass
        return "Nieskonfigurowany lub brak modułu zRAM"



class UpdateManager:
    """Zarządza sprawdzaniem i instalacją aktualizacji z repozytorium GitHub."""

    GITHUB_REPO = "h3v3n/okay-de"
    GITHUB_URL = "https://github.com/h3v3n/okay-de"
    API_COMMITS_URL = "https://api.github.com/repos/h3v3n/okay-de/commits/main"
    TARBALL_URL = "https://github.com/h3v3n/okay-de/archive/refs/heads/main.tar.gz"
    LOCAL_VERSION_FILE = os.path.expanduser("~/.config/okay-de/version")

    @classmethod
    def get_local_commit(cls) -> str:
        """Pobiera hash aktualnie zainstalowanego commita."""
        if os.path.exists(cls.LOCAL_VERSION_FILE):
            try:
                with open(cls.LOCAL_VERSION_FILE, "r", encoding="utf-8") as f:
                    val = f.read().strip()
                    if val:
                        return val
            except Exception:
                pass

        script_dir = os.path.dirname(os.path.realpath(__file__))
        project_root = os.path.abspath(os.path.join(script_dir, ".."))
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--short", "HEAD"],
                cwd=project_root if os.path.isdir(os.path.join(project_root, ".git")) else None,
                capture_output=True,
                text=True,
                check=False
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
        except Exception:
            pass

        return "ba9de83"

    @classmethod
    def get_remote_commit_sync(cls) -> str:
        """Pobiera skrót commita z API synchronicznie."""
        try:
            req = urllib.request.Request(
                cls.API_COMMITS_URL,
                headers={"User-Agent": "OKay-DE-Settings", "Accept": "application/vnd.github.v3+json"}
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                return data.get("sha", "")[:7].lower()
        except Exception:
            return "latest"

    @classmethod
    def check_for_updates(cls, callback):
        """Asynchronicznie sprawdza dostępność aktualizacji na GitHub."""
        def worker():
            local_sha = cls.get_local_commit().lower()
            try:
                # 1. Zapytanie do GitHub API
                req = urllib.request.Request(
                    cls.API_COMMITS_URL,
                    headers={
                        "User-Agent": "OKay-DE-Settings",
                        "Accept": "application/vnd.github.v3+json"
                    }
                )
                with urllib.request.urlopen(req, timeout=10) as response:
                    data = json.loads(response.read().decode("utf-8"))
                    remote_sha = data.get("sha", "")[:7].lower()
                    commit_msg = data.get("commit", {}).get("message", "").split("\n")[0]
                    author_name = data.get("commit", {}).get("author", {}).get("name", "OKay Developer")
                    commit_date = data.get("commit", {}).get("author", {}).get("date", "")[:10]

                    has_update = (remote_sha != local_sha) and bool(remote_sha)

                    result = {
                        "success": True,
                        "has_update": has_update,
                        "local_sha": local_sha,
                        "remote_sha": remote_sha,
                        "commit_msg": commit_msg,
                        "author": author_name,
                        "date": commit_date
                    }
                    GLib.idle_add(callback, result)
                    return
            except Exception as e:
                # 2. Fallback przez git ls-remote jeśli API zwróciło błąd lub rate-limit
                try:
                    res = subprocess.run(
                        ["git", "ls-remote", f"{cls.GITHUB_URL}.git", "HEAD"],
                        capture_output=True,
                        text=True,
                        timeout=10,
                        check=False
                    )
                    if res.returncode == 0 and res.stdout.strip():
                        remote_sha = res.stdout.strip().split()[0][:7].lower()
                        has_update = (remote_sha != local_sha) and bool(remote_sha)
                        result = {
                            "success": True,
                            "has_update": has_update,
                            "local_sha": local_sha,
                            "remote_sha": remote_sha,
                            "commit_msg": "Najnowsza wersja gałęzi main",
                            "author": "GitHub",
                            "date": ""
                        }
                        GLib.idle_add(callback, result)
                        return
                except Exception:
                    pass

                GLib.idle_add(callback, {
                    "success": False,
                    "error": str(e),
                    "local_sha": local_sha
                })

        threading.Thread(target=worker, daemon=True).start()

    @classmethod
    def install_update(cls, target_mode: str, progress_callback, finish_callback):
        """Pobiera i instaluje aktualizację OKay DE."""
        def worker():
            try:
                GLib.idle_add(progress_callback, "Przygotowywanie pobierania...")

                # Sprawdzenie czy mamy lokalny klon git powiązany z h3v3n/okay-de
                script_dir = os.path.dirname(os.path.realpath(__file__))
                project_root = os.path.abspath(os.path.join(script_dir, ".."))
                is_git_clone = False

                if os.path.isdir(os.path.join(project_root, ".git")):
                    res = subprocess.run(
                        ["git", "remote", "get-url", "origin"],
                        cwd=project_root,
                        capture_output=True,
                        text=True,
                        check=False
                    )
                    if "okay-de" in res.stdout:
                        is_git_clone = True

                work_dir = None
                if is_git_clone:
                    GLib.idle_add(progress_callback, "Pobieranie zmian z repozytorium git (git pull)...")
                    pull_res = subprocess.run(
                        ["git", "pull", "origin", "main"],
                        cwd=project_root,
                        capture_output=True,
                        text=True,
                        check=False
                    )
                    work_dir = project_root
                else:
                    GLib.idle_add(progress_callback, "Pobieranie archiwum z GitHub...")
                    temp_dir = tempfile.mkdtemp(prefix="okay-de-update-")
                    archive_path = os.path.join(temp_dir, "main.tar.gz")

                    req = urllib.request.Request(
                        cls.TARBALL_URL,
                        headers={"User-Agent": "OKay-DE-Settings"}
                    )
                    with urllib.request.urlopen(req, timeout=30) as resp, open(archive_path, "wb") as out_f:
                        shutil.copyfileobj(resp, out_f)

                    GLib.idle_add(progress_callback, "Rozpakowywanie archiwum aktualizacji...")
                    with tarfile.open(archive_path, "r:gz") as tar:
                        tar.extractall(path=temp_dir)

                    extracted_dirs = [os.path.join(temp_dir, d) for d in os.listdir(temp_dir) if os.path.isdir(os.path.join(temp_dir, d))]
                    if extracted_dirs:
                        work_dir = extracted_dirs[0]
                    else:
                        work_dir = temp_dir

                if not work_dir or not os.path.exists(work_dir):
                    raise RuntimeError("Nie udało się przygotować katalogu źródłowego aktualizacji.")

                # Instalacja
                GLib.idle_add(progress_callback, f"Instalowanie aktualizacji ({target_mode})...")
                install_script = os.path.join(work_dir, "install.sh")
                if os.path.exists(install_script):
                    os.chmod(install_script, 0o755)

                if target_mode == "system":
                    if shutil.which("pkexec"):
                        cmd = ["pkexec", "bash", install_script, "--system"]
                    else:
                        cmd = ["sudo", "bash", install_script, "--system"]
                    res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                    if res.returncode != 0:
                        raise RuntimeError(f"Błąd instalacji systemowej: {res.stderr or res.stdout}")
                else:
                    cmd = ["bash", install_script, "--user"]
                    res = subprocess.run(cmd, cwd=work_dir, capture_output=True, text=True, check=False)
                    if res.returncode != 0:
                        raise RuntimeError(f"Błąd instalacji użytkownika: {res.stderr or res.stdout}")

                # Zapis nowego hasha commita
                try:
                    latest_sha = cls.get_remote_commit_sync()
                    os.makedirs(os.path.dirname(cls.LOCAL_VERSION_FILE), exist_ok=True)
                    with open(cls.LOCAL_VERSION_FILE, "w", encoding="utf-8") as f:
                        f.write(latest_sha)
                except Exception:
                    pass

                # Przeładowanie kompozytora i Waybara
                GLib.idle_add(progress_callback, "Przeładowywanie kompozytora i paska...")
                subprocess.run(["labwc", "--reconfigure"], check=False)
                subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)

                if shutil.which("notify-send"):
                    subprocess.Popen([
                        "notify-send",
                        "OKay DE",
                        "Aktualizacja środowiska została pomyślnie zainstalowana!",
                        "-u", "normal"
                    ])

                GLib.idle_add(finish_callback, True, "Aktualizacja zakończona pomyślnie!")
            except Exception as e:
                GLib.idle_add(finish_callback, False, str(e))

        threading.Thread(target=worker, daemon=True).start()


class ConfigManager:
    """Zarządza konfiguracją wyglądu i ustawień użytkownika."""

    CONFIG_DIR = os.path.expanduser("~/.config/okay-de")
    WAYBAR_DIR = os.path.expanduser("~/.config/waybar")
    LABWC_DIR = os.path.expanduser("~/.config/labwc")
    THEMERC_OVERRIDE = os.path.join(LABWC_DIR, "themerc-override")
    WALLPAPER_TARGET = os.path.join(CONFIG_DIR, "wallpaper.png")
    DOCK_STYLE_FILE = os.path.join(CONFIG_DIR, "dock_style")
    DOCK_CSS_TARGET = os.path.join(WAYBAR_DIR, "dock-style.css")

    DEFAULT_BUTTON_COLORS = {
        "close": "#f38ba8",
        "max": "#89b4fa",
        "iconify": "#585b70"
    }

    @classmethod
    def ensure_dirs(cls):
        """Upewnia się, że katalogi konfiguracji istnieją."""
        os.makedirs(cls.CONFIG_DIR, exist_ok=True)
        os.makedirs(cls.WAYBAR_DIR, exist_ok=True)
        os.makedirs(cls.LABWC_DIR, exist_ok=True)

    @classmethod
    def set_wallpaper(cls, source_path: str) -> bool:
        """Kopiuje wskazaną tapetę i natychmiast aplikuje w PCManFM oraz swaybg."""
        cls.ensure_dirs()
        try:
            shutil.copyfile(source_path, cls.WALLPAPER_TARGET)

            # 1. Jeśli aktywny jest pulpit PCManFM, aplikujemy tapetę bezpośrednio przez pcmanfm
            if shutil.which("pcmanfm"):
                subprocess.run([
                    "pcmanfm",
                    f"-w={cls.WALLPAPER_TARGET}",
                    "--wallpaper-mode=crop"
                ], check=False)

            # 2. Przeładowanie tapety w swaybg
            subprocess.run(["pkill", "-x", "swaybg"], check=False)
            subprocess.Popen([
                "swaybg",
                "-c", "#1e1e2e",
                "-i", cls.WALLPAPER_TARGET,
                "-m", "fill"
            ])
            return True
        except Exception as e:
            print(f"Błąd zmiany tapety: {e}", file=sys.stderr)
            return False

    @classmethod
    def get_dock_style(cls) -> str:
        """Zwraca aktualny styl docka ('floating' lub 'full')."""
        cls.ensure_dirs()
        if os.path.exists(cls.DOCK_STYLE_FILE):
            try:
                with open(cls.DOCK_STYLE_FILE, "r", encoding="utf-8") as f:
                    return f.read().strip()
            except Exception:
                pass
        return "floating"

    @classmethod
    def set_dock_style(cls, style: str) -> bool:
        """Zapisuje styl docka i natychmiast wysyła SIGUSR2 do waybar."""
        cls.ensure_dirs()
        try:
            with open(cls.DOCK_STYLE_FILE, "w", encoding="utf-8") as f:
                f.write(style)

            # Generowanie pliku stylizacji dock-style.css dla Waybar
            if style == "full":
                css_content = (
                    "/* OKay DE - Styl docka: Pełna belka */\n"
                    "window#waybar {\n"
                    "    background-color: #11111b;\n"
                    "    border-top: 2px solid #313244;\n"
                    "    box-shadow: none;\n"
                    "}\n\n"
                    ".modules-center {\n"
                    "    background-color: transparent;\n"
                    "    border: none;\n"
                    "    border-radius: 0;\n"
                    "    padding: 0 8px;\n"
                    "    margin-bottom: 0;\n"
                    "    box-shadow: none;\n"
                    "}\n"
                )
            else:
                css_content = (
                    "/* OKay DE - Styl docka: Pływająca wyspa */\n"
                    "window#waybar {\n"
                    "    background-color: transparent;\n"
                    "    border: none;\n"
                    "    box-shadow: none;\n"
                    "}\n\n"
                    ".modules-center {\n"
                    "    background-color: rgba(30, 30, 46, 0.92);\n"
                    "    border: 1px solid rgba(137, 180, 250, 0.3);\n"
                    "    border-radius: 18px;\n"
                    "    padding: 3px 10px;\n"
                    "    margin-bottom: 8px;\n"
                    "    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);\n"
                    "}\n"
                )

            with open(cls.DOCK_CSS_TARGET, "w", encoding="utf-8") as f:
                f.write(css_content)

            # Natychmiastowe przeładowanie Waybar na żywo
            subprocess.run(["pkill", "-SIGUSR2", "waybar"], check=False)
            return True
        except Exception as e:
            print(f"Błąd zapisu stylu docka: {e}", file=sys.stderr)
            return False

    @classmethod
    def get_button_colors(cls) -> dict:
        """Odczytuje aktualne kolory przycisków okien z themerc-override."""
        cls.ensure_dirs()
        colors = dict(cls.DEFAULT_BUTTON_COLORS)

        path_to_read = None
        if os.path.exists(cls.THEMERC_OVERRIDE):
            path_to_read = cls.THEMERC_OVERRIDE
        elif os.path.exists("/etc/xdg/labwc/themerc-override"):
            path_to_read = "/etc/xdg/labwc/themerc-override"

        if path_to_read:
            try:
                with open(path_to_read, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("#") or ":" not in line:
                            continue
                        k, v = [part.strip() for part in line.split(":", 1)]
                        if k in ("window.active.button.unhover.close.color", "window.active.button.close.unpressed.image.color"):
                            colors["close"] = v
                        elif k in ("window.active.button.unhover.max.color", "window.active.button.max.unpressed.image.color"):
                            colors["max"] = v
                        elif k in ("window.active.button.unhover.iconify.color", "window.active.button.iconify.unpressed.image.color"):
                            colors["iconify"] = v
            except Exception as e:
                print(f"Błąd odczytu kolorów przycisków: {e}", file=sys.stderr)

        return colors

    @classmethod
    def set_button_color(cls, btn_type: str, hex_color: str) -> bool:
        """Aktualizuje kolory przycisku w themerc-override i wywołuje labwc --reconfigure."""
        cls.ensure_dirs()
        hex_color = hex_color.lower()

        if btn_type == "close":
            key_map = {
                "window.active.button.unhover.close.color": hex_color,
                "window.active.button.hover.close.color": hex_color,
                "window.inactive.button.unhover.close.color": "#45475a",
                "window.inactive.button.hover.close.color": hex_color,
                "window.active.button.close.unpressed.image.color": hex_color,
                "window.inactive.button.close.unpressed.image.color": "#45475a"
            }
        elif btn_type == "max":
            key_map = {
                "window.active.button.unhover.max.color": hex_color,
                "window.active.button.hover.max.color": hex_color,
                "window.inactive.button.unhover.max.color": "#45475a",
                "window.inactive.button.hover.max.color": hex_color,
                "window.active.button.max.unpressed.image.color": hex_color,
                "window.inactive.button.max.unpressed.image.color": "#45475a"
            }
        elif btn_type == "iconify":
            key_map = {
                "window.active.button.unhover.iconify.color": hex_color,
                "window.active.button.hover.iconify.color": hex_color,
                "window.inactive.button.unhover.iconify.color": "#313244",
                "window.inactive.button.hover.iconify.color": hex_color,
                "window.active.button.iconify.unpressed.image.color": hex_color,
                "window.inactive.button.iconify.unpressed.image.color": "#313244"
            }
        else:
            return False

        lines = []
        if os.path.exists(cls.THEMERC_OVERRIDE):
            with open(cls.THEMERC_OVERRIDE, "r", encoding="utf-8") as f:
                lines = f.readlines()
        elif os.path.exists("/etc/xdg/labwc/themerc-override"):
            with open("/etc/xdg/labwc/themerc-override", "r", encoding="utf-8") as f:
                lines = f.readlines()
        else:
            lines = [
                "# OKay DE - Labwc Theme Override\n",
                "window.cornerRadius: 8\n",
                "window.titlebar.layout: Title:Iconify,Maximize,Close\n",
                "titlebar.height: 30\n",
                "window.button.width: 14\n",
                "window.button.height: 14\n",
                "window.button.spacing: 4\n",
                "border.width: 2\n",
                "window.active.border.color: #89b4fa\n",
                "window.inactive.border.color: #313244\n"
            ]

        updated_keys = set()
        new_lines = []
        for line in lines:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and ":" in line:
                key = line.split(":", 1)[0].strip()
                if key in key_map:
                    new_lines.append(f"{key}: {key_map[key]}\n")
                    updated_keys.add(key)
                    continue
            new_lines.append(line)

        for k, v in key_map.items():
            if k not in updated_keys:
                new_lines.append(f"{k}: {v}\n")

        try:
            with open(cls.THEMERC_OVERRIDE, "w", encoding="utf-8") as f:
                f.writelines(new_lines)

            # Natychmiastowe przeładowanie kompozytora labwc na żywo
            subprocess.run(["labwc", "--reconfigure"], check=False)
            return True
        except Exception as e:
            print(f"Błąd zapisu themerc-override: {e}", file=sys.stderr)
            return False


class OkaySettingsWindow(Adw.PreferencesWindow):
    """Główne okno centrum sterowania OKay Settings."""

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("Ustawienia OKay DE")
        self.set_default_size(740, 600)
        self.set_search_enabled(True)

        # Inicjalizacja modułów
        self._init_appearance_page()
        self._init_system_page()
        self._init_performance_page()
        self._init_shortcuts_page()
        self._init_updates_page()
        self._init_about_page()

    def _show_alert(self, title: str, message: str):
        """Uniwersalny komunikat dialogowy zgodny z wersjami Libadwaita."""
        if hasattr(Adw, "AlertDialog"):
            dialog = Adw.AlertDialog.new(title, message)
            dialog.add_response("ok", "Rozumiem")
            dialog.set_default_response("ok")
            dialog.present(self)
        elif hasattr(Adw, "MessageDialog"):
            dialog = Adw.MessageDialog.new(self, title, message)
            dialog.add_response("ok", "Rozumiem")
            dialog.set_default_response("ok")
            dialog.present()
        else:
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", title, message, "-u", "normal"])

    def _create_color_picker(self, initial_hex: str, on_changed_callback) -> Gtk.Widget:
        """Fabrykuje przycisk próbnika koloru kompatybilny ze wszystkimi wersjami GTK4."""
        rgba = Gdk.RGBA()
        rgba.parse(initial_hex)

        if hasattr(Gtk, "ColorDialogButton"):
            dialog = Gtk.ColorDialog.new()
            dialog.set_with_alpha(False)
            btn = Gtk.ColorDialogButton.new(dialog)
            btn.set_rgba(rgba)
            btn.set_valign(Gtk.Align.CENTER)

            def on_notify_rgba(b, _p):
                c = b.get_rgba()
                h = f"#{int(c.red * 255):02x}{int(c.green * 255):02x}{int(c.blue * 255):02x}"
                on_changed_callback(h)

            btn.connect("notify::rgba", on_notify_rgba)
            return btn
        else:
            btn = Gtk.ColorButton.new_with_rgba(rgba)
            btn.set_use_alpha(False)
            btn.set_valign(Gtk.Align.CENTER)

            def on_color_set(b):
                c = b.get_rgba()
                h = f"#{int(c.red * 255):02x}{int(c.green * 255):02x}{int(c.blue * 255):02x}"
                on_changed_callback(h)

            btn.connect("color-set", on_color_set)
            return btn

