# ============================================================================
# Zarządzanie konfiguracją ~/.config/okay-de/panel.json
# ============================================================================

class PanelConfigManager:
    CONFIG_DIR = os.path.expanduser("~/.config/okay-de")
    CONFIG_FILE = os.path.join(CONFIG_DIR, "panel.json")
    LEGACY_PINS_FILE = os.path.join(CONFIG_DIR, "pinned_apps.json")
    SYSTEM_CONFIG_FILE = "/etc/xdg/okay-de/panel.json"

    DEFAULT_CONFIG = {
        "icon_only": True,
        "show_labels": False,
        "pinned_apps": [
            {
                "app_id": "foot",
                "name": "Terminal (foot)",
                "cmd": "foot",
                "icon": "utilities-terminal"
            },
            {
                "app_id": "pcmanfm",
                "name": "Menedżer plików",
                "cmd": "pcmanfm",
                "icon": "system-file-manager"
            },
            {
                "app_id": "okay-settings",
                "name": "Ustawienia OKay",
                "cmd": "okay-settings",
                "icon": "preferences-system"
            }
        ]
    }

    @classmethod
    def load(cls) -> dict:
        os.makedirs(cls.CONFIG_DIR, exist_ok=True)
        if not os.path.exists(cls.CONFIG_FILE):
            # Sprawdź konfigurację systemową lub migruj ze starszego pinned_apps.json
            initial = dict(cls.DEFAULT_CONFIG)
            if os.path.exists(cls.SYSTEM_CONFIG_FILE):
                try:
                    with open(cls.SYSTEM_CONFIG_FILE, "r", encoding="utf-8") as f:
                        initial = json.load(f)
                except Exception:
                    pass
            elif os.path.exists(cls.LEGACY_PINS_FILE):
                try:
                    with open(cls.LEGACY_PINS_FILE, "r", encoding="utf-8") as f:
                        old_pins = json.load(f)
                    migrated = []
                    for k, v in old_pins.items():
                        if v.get("enabled", True):
                            cmd = v.get("cmd", k)
                            migrated.append({
                                "app_id": cmd.split()[0],
                                "name": v.get("name", k),
                                "cmd": cmd,
                                "icon": v.get("icon_name", AppHelper.get_icon_name(cmd.split()[0]))
                            })
                    if migrated:
                        initial["pinned_apps"] = migrated
                except Exception:
                    pass
            cls.save(initial)
            return initial

        try:
            with open(cls.CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            # Synchronizacja obu flag: show_labels vs icon_only
            if "show_labels" in data:
                show_labels = bool(data["show_labels"])
            elif "icon_only" in data:
                show_labels = not bool(data["icon_only"])
            else:
                show_labels = False

            data["show_labels"] = show_labels
            data["icon_only"] = not show_labels
            if "pinned_apps" not in data or not isinstance(data["pinned_apps"], list):
                data["pinned_apps"] = list(cls.DEFAULT_CONFIG["pinned_apps"])
            return data
        except Exception:
            return dict(cls.DEFAULT_CONFIG)

    @classmethod
    def save(cls, data: dict):
        os.makedirs(cls.CONFIG_DIR, exist_ok=True)
        show_labels = bool(data.get("show_labels", not data.get("icon_only", True)))
        data["show_labels"] = show_labels
        data["icon_only"] = not show_labels
        with open(cls.CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)


# ============================================================================
# Pomocnik ikon i metadanych .desktop
# ============================================================================

class AppHelper:
    ICON_THEME = Gtk.IconTheme.get_default()
    _desktop_cache = None

    STATIC_ICON_MAP = {
        "foot": "utilities-terminal",
        "terminal": "utilities-terminal",
        "pcmanfm": "system-file-manager",
        "files": "system-file-manager",
        "okay-settings": "preferences-system",
        "settings": "preferences-system",
        "firefox": "firefox",
        "chromium": "chromium",
        "google-chrome": "google-chrome",
        "code": "code",
        "vlc": "vlc",
        "mpv": "mpv",
        "gimp": "gimp",
        "thunar": "system-file-manager",
        "pavucontrol": "multimedia-volume-control"
    }

    @classmethod
    def _build_desktop_cache(cls):
        if cls._desktop_cache is not None:
            return cls._desktop_cache
        cache = {}
        dirs = [
            os.path.expanduser("~/.local/share/applications"),
            "/usr/local/share/applications",
            "/usr/share/applications"
        ]
        for d in dirs:
            if not os.path.isdir(d):
                continue
            for path in glob.glob(os.path.join(d, "*.desktop")):
                try:
                    name = ""
                    icon = ""
                    exec_cmd = ""
                    wm_class = ""
                    with open(path, "r", encoding="utf-8", errors="ignore") as f:
                        in_entry = False
                        for line in f:
                            line = line.strip()
                            if line.startswith("["):
                                in_entry = (line == "[Desktop Entry]")
                                continue
                            if not in_entry:
                                continue
                            if line.startswith("Name=") and not name:
                                name = line[5:].strip()
                            elif line.startswith("Icon=") and not icon:
                                icon = line[5:].strip()
                            elif line.startswith("Exec=") and not exec_cmd:
                                raw_exec = line[5:].strip()
                                # Usuń placeholdery %u %U %f %F %i %c %k
                                parts = [p for p in raw_exec.split() if not p.startswith("%")]
                                exec_cmd = " ".join(parts)
                            elif line.startswith("StartupWMClass=") and not wm_class:
                                wm_class = line[15:].strip().lower()

                    base_id = os.path.splitext(os.path.basename(path))[0].lower()
                    info = {
                        "name": name or base_id,
                        "icon": icon,
                        "cmd": exec_cmd or base_id
                    }
                    cache[base_id] = info
                    if wm_class:
                        cache[wm_class] = info
                    if exec_cmd:
                        cmd_bin = os.path.basename(exec_cmd.split()[0]).lower()
                        if cmd_bin not in cache:
                            cache[cmd_bin] = info
                except Exception:
                    pass
        cls._desktop_cache = cache
        return cache

    @classmethod
    def get_app_metadata(cls, app_id: str) -> dict:
        clean_id = app_id.lower().strip()
        cache = cls._build_desktop_cache()
        if clean_id in cache:
            return cache[clean_id]
        last_part = clean_id.split(".")[-1]
        if last_part in cache:
            return cache[last_part]
        return {
            "name": app_id,
            "icon": cls.get_icon_name(app_id),
            "cmd": app_id
        }

    @classmethod
    def get_icon_name(cls, app_id: str, hint_icon: str = "") -> str:
        if hint_icon:
            if os.path.isabs(hint_icon) and os.path.exists(hint_icon):
                return hint_icon
            if cls.ICON_THEME.has_icon(hint_icon):
                return hint_icon

        clean_id = app_id.lower().strip()
        if clean_id in cls.STATIC_ICON_MAP and cls.ICON_THEME.has_icon(cls.STATIC_ICON_MAP[clean_id]):
            return cls.STATIC_ICON_MAP[clean_id]

        cache = cls._build_desktop_cache()
        if clean_id in cache and cache[clean_id].get("icon"):
            ic = cache[clean_id]["icon"]
            if cls.ICON_THEME.has_icon(ic):
                return ic

        if cls.ICON_THEME.has_icon(clean_id):
            return clean_id

        parts = clean_id.split(".")
        if parts and cls.ICON_THEME.has_icon(parts[-1]):
            return parts[-1]

        return cls.STATIC_ICON_MAP.get(clean_id, "application-x-executable")


# ============================================================================
# Natywny klient Wayland wlr-foreign-toplevel-management-v1
# ============================================================================

class WaylandToplevelClient:
    """Natywny klient protokołu Wayland zwlr_foreign_toplevel_manager_v1 (zero zależności zewnętrznych)."""
    IGNORED_APP_IDS = {"okay-panel", "okay-dock", "fuzzel", "mako", "waybar", "sfwbar"}

    DISPLAY_ID = 1
    REGISTRY_ID = 2

    def __init__(self, on_change_cb=None):
        self.on_change_cb = on_change_cb
        self.sock = None
        self.recv_buf = b""
        # Kolejne ID obiektów klienta w Wayland muszą być przydzielane ściśle sekwencyjnie (bez luk)
        self._next_id = 3
        self._protocol_error = False
        self.manager_id = None
        self.seat_id = None
        self.manager_bound = False
        self.seat_bound = False
        self.handles = {}
        self.connected = False
        try:
            self._connect()
        except Exception as e:
            print(f"[okay-panel] Wyjątek klienta wlr-foreign-toplevel (fallback): {e}", file=sys.stderr)
            self._close_socket()

    def _alloc_id(self) -> int:
        obj_id = self._next_id
        self._next_id += 1
        return obj_id

    def _close_socket(self):
        self.connected = False
        if self.sock is not None:
            try:
                self.sock.close()
            except Exception:
                pass
            self.sock = None

    @staticmethod
    def _pack_string(s: str) -> bytes:
        raw = s.encode("utf-8") + b"\x00"
        length = len(raw)
        pad = (4 - (length % 4)) % 4
        return struct.pack("<I", length) + raw + (b"\x00" * pad)

    @staticmethod
    def _unpack_string(payload: bytes, offset: int = 0) -> tuple:
        if offset + 4 > len(payload):
            return "", offset
        (length,) = struct.unpack_from("<I", payload, offset)
        offset += 4
        if length == 0:
            return "", offset
        raw = payload[offset : offset + max(0, length - 1)]
        pad = (4 - (length % 4)) % 4
        offset += length + pad
        return raw.decode("utf-8", errors="replace"), offset

    @staticmethod
    def _unpack_array(payload: bytes, offset: int = 0) -> tuple:
        if offset + 4 > len(payload):
            return b"", offset
        (length,) = struct.unpack_from("<I", payload, offset)
        offset += 4
        raw = payload[offset : offset + length]
        pad = (4 - (length % 4)) % 4
        offset += length + pad
        return raw, offset

    @staticmethod
    def _pack_msg(obj_id: int, opcode: int, payload: bytes = b"") -> bytes:
        size = 8 + len(payload)
        return struct.pack("<II", obj_id, (size << 16) | (opcode & 0xFFFF)) + payload

    def _send(self, data: bytes) -> bool:
        if not self.sock:
            return False
        try:
            self.sock.sendall(data)
            return True
        except (BrokenPipeError, OSError) as e:
            print(f"[okay-panel] Błąd zapisu Wayland (rozłączono toplevel fallback): {e}", file=sys.stderr)
            self._close_socket()
            return False
        except Exception as e:
            print(f"[okay-panel] Nieoczekiwany błąd zapisu Wayland: {e}", file=sys.stderr)
            self._close_socket()
            return False

    def _connect(self):
        xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        wayland_display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        sock_path = wayland_display if os.path.isabs(wayland_display) else os.path.join(xdg_runtime, wayland_display)

        if not os.path.exists(sock_path):
            print(f"[okay-panel] Nie znaleziono gniazda Wayland: {sock_path}", file=sys.stderr)
            return

        try:
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.settimeout(1.0)
            self.sock.connect(sock_path)

            init_sync_id = self._alloc_id()
            if not self._send(
                self._pack_msg(self.DISPLAY_ID, 1, struct.pack("<I", self.REGISTRY_ID)) +
                self._pack_msg(self.DISPLAY_ID, 0, struct.pack("<I", init_sync_id))
            ):
                return
            self._roundtrip_until(init_sync_id)

            if self._protocol_error or self.sock is None:
                self._close_socket()
                return

            if self.manager_bound and self.manager_id is not None:
                second_sync_id = self._alloc_id()
                if not self._send(self._pack_msg(self.DISPLAY_ID, 0, struct.pack("<I", second_sync_id))):
                    return
                self._roundtrip_until(second_sync_id)

            if self._protocol_error or self.sock is None:
                self._close_socket()
                return

            if self.manager_bound:
                self.connected = True
                print(f"[okay-panel] Połączono z protokołem wlr-foreign-toplevel (okien: {len(self.handles)})", file=sys.stderr)

            self.sock.setblocking(False)
            GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self._on_socket_ready)
        except Exception as e:
            print(f"[okay-panel] Błąd inicjalizacji wlr-foreign-toplevel (tryb fallback): {e}", file=sys.stderr)
            self._close_socket()

    def _roundtrip_until(self, sync_obj_id: int):
        done = False
        deadline = time.monotonic() + 1.0
        while not done and time.monotonic() < deadline:
            if self._protocol_error or self.sock is None:
                break
            try:
                chunk = self.sock.recv(65536)
                if not chunk:
                    self._close_socket()
                    break
                self.recv_buf += chunk
                _, sync_hit = self._process_buffer(target_sync_id=sync_obj_id)
                if sync_hit:
                    done = True
            except socket.timeout:
                break
            except Exception as e:
                print(f"[okay-panel] Błąd odczytu Wayland roundtrip: {e}", file=sys.stderr)
                self._close_socket()
                break

    def _on_socket_ready(self, source, condition) -> bool:
        if self.sock is None or self._protocol_error:
            self._close_socket()
            return False
        try:
            while True:
                chunk = self.sock.recv(65536)
                if not chunk:
                    self._close_socket()
                    return False
                self.recv_buf += chunk
        except BlockingIOError:
            pass
        except Exception as e:
            print(f"[okay-panel] Błąd gniazda Wayland (wyłączam toplevel fallback): {e}", file=sys.stderr)
            self._close_socket()
            return False

        try:
            changed, _ = self._process_buffer()
            if self._protocol_error or self.sock is None:
                self._close_socket()
                return False
            if changed and self.on_change_cb:
                GLib.idle_add(self.on_change_cb)
        except Exception as e:
            print(f"[okay-panel] Błąd przetwarzania zdarzeń Wayland: {e}", file=sys.stderr)
            self._close_socket()
            return False
        return True

    def _process_buffer(self, target_sync_id: int = -1) -> tuple:
        changed = False
        sync_hit = False

        while len(self.recv_buf) >= 8:
            obj_id, word1 = struct.unpack_from("<II", self.recv_buf, 0)
            size = word1 >> 16
            opcode = word1 & 0xFFFF
            if size < 8 or len(self.recv_buf) < size:
                break
            payload = self.recv_buf[8:size]
            self.recv_buf = self.recv_buf[size:]

            try:
                if obj_id == self.DISPLAY_ID:
                    if opcode == 0 and len(payload) >= 8:
                        err_obj, err_code = struct.unpack_from("<II", payload, 0)
                        err_msg, _ = self._unpack_string(payload, 8)
                        print(f"[okay-panel] Wayland error (obj={err_obj}, code={err_code}): {err_msg}", file=sys.stderr)
                        self._protocol_error = True
                        self.manager_bound = False
                        self.seat_bound = False
                        self.connected = False
                        break
                elif obj_id == target_sync_id:
                    if opcode == 0:
                        sync_hit = True
                elif obj_id == self.REGISTRY_ID:
                    if opcode == 0 and len(payload) >= 8:
                        name = struct.unpack_from("<I", payload, 0)[0]
                        iface, off = self._unpack_string(payload, 4)
                        if off + 4 > len(payload):
                            continue
                        ver = struct.unpack_from("<I", payload, off)[0]
                        if ver < 1:
                            continue
                        if iface == "zwlr_foreign_toplevel_manager_v1" and not self.manager_bound:
                            bind_ver = min(ver, 2)
                            new_id = self._alloc_id()
                            if self._send(self._pack_msg(
                                self.REGISTRY_ID, 0,
                                struct.pack("<I", name) + self._pack_string(iface) + struct.pack("<II", bind_ver, new_id)
                            )):
                                self.manager_id = new_id
                                self.manager_bound = True
                        elif iface == "wl_seat" and not self.seat_bound:
                            bind_ver = min(ver, 1)
                            new_id = self._alloc_id()
                            if self._send(self._pack_msg(
                                self.REGISTRY_ID, 0,
                                struct.pack("<I", name) + self._pack_string(iface) + struct.pack("<II", bind_ver, new_id)
                            )):
                                self.seat_id = new_id
                                self.seat_bound = True
                elif self.manager_id is not None and obj_id == self.manager_id:
                    if opcode == 0 and len(payload) >= 4:
                        handle_id = struct.unpack_from("<I", payload, 0)[0]
                        self.handles[handle_id] = {
                            "handle_id": handle_id,
                            "app_id": "",
                            "title": "",
                            "focused": False,
                            "minimized": False,
                            "maximized": False,
                            "ready": False,
                            "pending": {
                                "app_id": "",
                                "title": "",
                                "focused": False,
                                "minimized": False,
                                "maximized": False,
                            }
                        }
                    elif opcode == 1:
                        self.manager_bound = False
                elif obj_id in self.handles:
                    h = self.handles[obj_id]
                    if opcode == 0:
                        title, _ = self._unpack_string(payload, 0)
                        h["pending"]["title"] = title
                    elif opcode == 1:
                        app_id, _ = self._unpack_string(payload, 0)
                        h["pending"]["app_id"] = app_id
                    elif opcode == 4:
                        raw_arr, _ = self._unpack_array(payload, 0)
                        n = len(raw_arr) // 4
                        states = set(struct.unpack(f"<{n}I", raw_arr[: n * 4])) if n > 0 else set()
                        h["pending"]["maximized"] = (0 in states)
                        h["pending"]["minimized"] = (1 in states)
                        h["pending"]["focused"] = (2 in states)
                    elif opcode == 5:
                        p = h["pending"]
                        h["app_id"] = p["app_id"]
                        h["title"] = p["title"]
                        h["maximized"] = p["maximized"]
                        h["minimized"] = p["minimized"]
                        h["focused"] = p["focused"]
                        h["ready"] = True
                        changed = True
                    elif opcode == 6:
                        del self.handles[obj_id]
                        self._send(self._pack_msg(obj_id, 7))
                        changed = True
            except Exception as e:
                print(f"[okay-panel] Błąd dekodowania wiadomości Wayland (obj={obj_id}, op={opcode}): {e}", file=sys.stderr)

        return changed, sync_hit

    def get_windows(self) -> list:
        res = []
        for h in self.handles.values():
            if not h["ready"]:
                continue
            app_id = h["app_id"].strip()
            if app_id.lower() in self.IGNORED_APP_IDS:
                continue
            res.append({
                "handle_id": h["handle_id"],
                "app_id": app_id,
                "title": h["title"].strip(),
                "focused": h["focused"],
                "minimized": h["minimized"],
            })
        return res

    def activate_or_minimize(self, handle_id: int, is_focused: bool, is_minimized: bool):
        if not self.connected or handle_id not in self.handles:
            return
        if is_focused:
            self._send(self._pack_msg(handle_id, 2))
        else:
            if is_minimized:
                self._send(self._pack_msg(handle_id, 3))
            if self.seat_bound and self.seat_id is not None:
                self._send(self._pack_msg(handle_id, 4, struct.pack("<I", self.seat_id)))

    def set_minimized(self, handle_id: int, minimized: bool):
        if not self.connected or handle_id not in self.handles:
            return
        if minimized:
            self._send(self._pack_msg(handle_id, 2))
        else:
            self._send(self._pack_msg(handle_id, 3))
            if self.seat_bound and self.seat_id is not None:
                self._send(self._pack_msg(handle_id, 4, struct.pack("<I", self.seat_id)))

    def close_window(self, handle_id: int):
        if self.connected and handle_id in self.handles:
            self._send(self._pack_msg(handle_id, 5))


# ============================================================================
# Zarządca okien Wayland (Natywny protokół + opcjonalny fallback wlrctl)
# ============================================================================

class WindowManager:
    IGNORED_APP_IDS = WaylandToplevelClient.IGNORED_APP_IDS
    _wl_client = None

    @classmethod
    def init_client(cls, on_change_cb):
        try:
            cls._wl_client = WaylandToplevelClient(on_change_cb)
        except Exception as e:
            print(f"[okay-panel] Błąd uruchamiania klienta wlr-foreign-toplevel (fallback): {e}", file=sys.stderr)
            cls._wl_client = None

    @classmethod
    def get_open_windows(cls) -> list:
        if cls._wl_client and cls._wl_client.connected:
            return cls._wl_client.get_windows()
        if not shutil.which("wlrctl"):
            return []
        try:
            res = subprocess.run(["wlrctl", "toplevel", "list"], capture_output=True, text=True, timeout=0.4, check=False)
            if res.returncode != 0 or not res.stdout.strip():
                return []
            focused = cls._wlrctl_focused()
            minimized = cls._wlrctl_minimized()
            items = []
            for line in res.stdout.strip().split("\n"):
                if not line.strip():
                    continue
                app_id, title = (line.split(":", 1) if ":" in line else (line, line))
                app_id_c, title_c = app_id.strip(), title.strip()
                if app_id_c.lower() in cls.IGNORED_APP_IDS:
                    continue
                items.append({
                    "handle_id": 0,
                    "app_id": app_id_c,
                    "title": title_c,
                    "focused": (app_id_c, title_c) == focused,
                    "minimized": (app_id_c, title_c) in minimized,
                })
            return items
        except Exception:
            return []

    @staticmethod
    def _wlrctl_focused() -> tuple:
        try:
            res = subprocess.run(["wlrctl", "toplevel", "list", "state:focused"], capture_output=True, text=True, timeout=0.3, check=False)
            if res.returncode == 0 and res.stdout.strip():
                line = res.stdout.strip().split("\n")[0]
                a, t = (line.split(":", 1) if ":" in line else (line, line))
                return (a.strip(), t.strip())
        except Exception:
            pass
        return ("", "")

    @staticmethod
    def _wlrctl_minimized() -> set:
        out = set()
        try:
            res = subprocess.run(["wlrctl", "toplevel", "list", "state:minimized"], capture_output=True, text=True, timeout=0.3, check=False)
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().split("\n"):
                    if line.strip():
                        a, t = (line.split(":", 1) if ":" in line else (line, line))
                        out.add((a.strip(), t.strip()))
        except Exception:
            pass
        return out

    @classmethod
    def activate_or_minimize(cls, handle_id: int, app_id: str, title: str, is_focused: bool, is_minimized: bool, multiple: bool = False):
        if cls._wl_client and cls._wl_client.connected and handle_id:
            cls._wl_client.activate_or_minimize(handle_id, is_focused, is_minimized)
            return
        if not shutil.which("wlrctl"):
            return
        sel = [f"app_id:{app_id}", f"title:{title}"] if (multiple and title) else [f"app_id:{app_id}"]
        try:
            if is_focused:
                subprocess.Popen(["wlrctl", "toplevel", "minimize", "true"] + sel)
            elif is_minimized:
                subprocess.Popen(["wlrctl", "toplevel", "minimize", "false"] + sel)
                subprocess.Popen(["wlrctl", "toplevel", "focus"] + sel)
            else:
                subprocess.Popen(["wlrctl", "toplevel", "focus"] + sel)
        except Exception:
            pass

    @classmethod
    def set_minimized(cls, handle_id: int, app_id: str, title: str, minimized: bool, multiple: bool = False):
        if cls._wl_client and cls._wl_client.connected and handle_id:
            cls._wl_client.set_minimized(handle_id, minimized)
            return
        if not shutil.which("wlrctl"):
            return
        sel = [f"app_id:{app_id}", f"title:{title}"] if (multiple and title) else [f"app_id:{app_id}"]
        try:
            subprocess.Popen(["wlrctl", "toplevel", "minimize", "true" if minimized else "false"] + sel)
            if not minimized:
                subprocess.Popen(["wlrctl", "toplevel", "focus"] + sel)
        except Exception:
            pass

    @classmethod
    def close_window(cls, handle_id: int, app_id: str, title: str, multiple: bool = False):
        if cls._wl_client and cls._wl_client.connected and handle_id:
            cls._wl_client.close_window(handle_id)
            return
        if shutil.which("wlrctl"):
            sel = [f"app_id:{app_id}", f"title:{title}"] if (multiple and title) else [f"app_id:{app_id}"]
            try:
                subprocess.Popen(["wlrctl", "toplevel", "close"] + sel)
            except Exception:
                pass


# ============================================================================
# Główne okno paska zadań OKay Panel
# ============================================================================

class OkayPanel(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("okay-panel")
        self.set_title("okay-panel")

        # Natywna konfiguracja Wayland Layer-Shell (dół ekranu, 100% szerokości, exclusive zone)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_namespace(self, "okay-panel")
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.auto_exclusive_zone_enable(self)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)

        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_default_size(-1, 38)
        self.set_size_request(-1, 38)

        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(PANEL_CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Główny kontener poziomy
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(self.main_box)

        # Lewa strona: Przycisk Start ("OK") + JEDNA ZUNIFIKOWANA SEKCJA ZADAŃ
        self.left_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.main_box.pack_start(self.left_box, False, False, 0)

        self._build_start_button()

        # Jedyny kontener zadań (łączy przypięte ikony + dynamiczne otwarte okna)
        self.tasks_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.left_box.pack_start(self.tasks_box, False, False, 0)

        # Elastyczny separator środkowy
        self.spacer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.spacer.set_hexpand(True)
        self.main_box.pack_start(self.spacer, True, True, 0)

        # Prawa strona: Bateria, Głośność, Zegar, Pokaż pulpit
        self.right_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.main_box.pack_end(self.right_box, False, False, 0)

        self._build_right_section()

        self._config_mtime = -1
        self.panel_config = PanelConfigManager.load()
        self._last_state_key = None

        # Połączenie z natywnym protokołem Wayland wlr-foreign-toplevel-management-v1
        WindowManager.init_client(self._on_wayland_change)

        # Odświeżanie konfiguracji / fallback (co 500ms)
        GLib.timeout_add(500, self._update_tasks)
        # Odświeżanie statusów systemowych i zegara (co 1000ms)
        GLib.timeout_add(1000, self._update_status)

        self._update_tasks()
        self._update_status()

    def _on_wayland_change(self) -> bool:
        self._update_tasks()
        return False

    # ------------------------------------------------------------------------
    # Budowa interfejsu
    # ------------------------------------------------------------------------

    def _build_start_button(self):
        btn = Gtk.Button(label=" OK ")
        btn.set_name("start-button")
        btn.set_tooltip_text("Menu programów (Super / Fuzzel)\nPPM: Menu zasilania")
        btn.connect("button-press-event", self._on_start_button_press)
        self.left_box.pack_start(btn, False, False, 0)

    def _build_right_section(self):
        # 1. Pokaż pulpit
        btn_desktop = Gtk.Button()
        btn_desktop.set_name("desktop-button")
        btn_desktop.set_tooltip_text("Pokaż pulpit / Przywróć okna")
        btn_desktop.connect("clicked", self._on_desktop_clicked)
        self.right_box.pack_end(btn_desktop, False, False, 0)

        # 2. Zegar dwuwierszowy (Godzina + Data)
        self.btn_clock = Gtk.Button()
        self.btn_clock.set_name("clock-button")
        self.lbl_clock = Gtk.Label()
        self.lbl_clock.set_justify(Gtk.Justification.CENTER)
        self.btn_clock.add(self.lbl_clock)
        self.right_box.pack_end(self.btn_clock, False, False, 0)

        # 3. Głośność
        self.btn_volume = Gtk.Button()
        self.btn_volume.get_style_context().add_class("status-item")
        self.box_volume = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.img_volume = Gtk.Image.new_from_icon_name("audio-volume-high", Gtk.IconSize.MENU)
        self.lbl_volume = Gtk.Label(label="100%")
        self.box_volume.pack_start(self.img_volume, False, False, 0)
        self.box_volume.pack_start(self.lbl_volume, False, False, 0)
        self.btn_volume.add(self.box_volume)
        self.btn_volume.add_events(Gdk.EventMask.SCROLL_MASK)
        self.btn_volume.connect("button-press-event", self._on_volume_press)
        self.btn_volume.connect("scroll-event", self._on_volume_scroll)
        self.right_box.pack_end(self.btn_volume, False, False, 0)

        # 4. Bateria
        self.box_battery = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.box_battery.get_style_context().add_class("status-item")
        self.img_battery = Gtk.Image.new_from_icon_name("battery-full", Gtk.IconSize.MENU)
        self.lbl_battery = Gtk.Label(label="")
        self.box_battery.pack_start(self.img_battery, False, False, 0)
        self.box_battery.pack_start(self.lbl_battery, False, False, 0)
        self.right_box.pack_end(self.box_battery, False, False, 0)

    # ------------------------------------------------------------------------
    # Zdarzenia paska Start, Głośności, Pulpitu
    # ------------------------------------------------------------------------

    def _on_start_button_press(self, widget, event):
        if event.button == 1:
            subprocess.Popen(["fuzzel"])
        elif event.button == 3:
            subprocess.Popen(["okay-powermenu"])
        return True

    def _on_desktop_clicked(self, widget):
        windows = WindowManager.get_open_windows()
        unminimized = [w for w in windows if not w["minimized"]]
        app_counts = {}
        for w in windows:
            app_counts[w["app_id"]] = app_counts.get(w["app_id"], 0) + 1

        if unminimized:
            for w in unminimized:
                WindowManager.set_minimized(w["handle_id"], w["app_id"], w["title"], True, app_counts.get(w["app_id"], 1) > 1)
        elif windows:
            for w in windows:
                WindowManager.set_minimized(w["handle_id"], w["app_id"], w["title"], False, app_counts.get(w["app_id"], 1) > 1)

    def _on_volume_press(self, widget, event):
        if event.button == 1:
            subprocess.Popen(["pavucontrol"])
        elif event.button == 3:
            subprocess.Popen(["okay-volume", "mute"])
        return True

    def _on_volume_scroll(self, widget, event):
        if event.direction == Gdk.ScrollDirection.UP:
            subprocess.Popen(["okay-volume", "raise"])
        elif event.direction == Gdk.ScrollDirection.DOWN:
            subprocess.Popen(["okay-volume", "lower"])
        return True

    # ------------------------------------------------------------------------
    # Logika zunifikowanego paska zadań (Pinned + Running w jednym kontenerze)
    # ------------------------------------------------------------------------

    @staticmethod
    def _matches_pin(win_app_id: str, pin: dict) -> bool:
        w_id = win_app_id.lower().strip()
        p_id = pin.get("app_id", "").lower().strip()
        cmd = pin.get("cmd", "").strip()
        cmd_base = os.path.basename(cmd.split()[0]).lower() if cmd else ""
        if not w_id:
            return False
        if w_id == p_id or (cmd_base and w_id == cmd_base):
            return True
        w_last = w_id.split(".")[-1]
        if w_last == p_id or (cmd_base and w_last == cmd_base):
            return True
        return False

    def _make_task_button(self, icon_name: str, label_text: str, tooltip: str, show_label: bool,
                          is_pinned: bool, is_running: bool, is_focused: bool, is_minimized: bool) -> Gtk.Button:
        btn = Gtk.Button()
        ctx = btn.get_style_context()
        ctx.add_class("task-item")

        if is_running:
            ctx.add_class("app-open")
            if is_focused:
                ctx.add_class("app-focused")
            elif is_minimized:
                ctx.add_class("app-minimized")
        else:
            ctx.add_class("app-pinned")

        btn.set_tooltip_text(tooltip)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        if os.path.isabs(icon_name) and os.path.exists(icon_name):
            img = Gtk.Image.new_from_file(icon_name)
        else:
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DND)
        box.pack_start(img, False, False, 0)

        if show_label and label_text:
            short_title = (label_text[:18] + "...") if len(label_text) > 18 else label_text
            lbl = Gtk.Label(label=short_title)
            lbl.get_style_context().add_class("task-label")
            box.pack_start(lbl, False, False, 0)

        btn.add(box)
        return btn

    def _update_tasks(self) -> bool:
        # 1. Sprawdzenie zmian w ~/.config/okay-de/panel.json
        try:
            mtime = os.path.getmtime(PanelConfigManager.CONFIG_FILE) if os.path.exists(PanelConfigManager.CONFIG_FILE) else 0
            if mtime != self._config_mtime:
                self._config_mtime = mtime
                self.panel_config = PanelConfigManager.load()
                self._last_state_key = None
        except Exception:
            pass

        windows = WindowManager.get_open_windows()
        show_labels = bool(self.panel_config.get("show_labels", False))
        pinned_apps = self.panel_config.get("pinned_apps", [])

        state_key = (
            [(w["handle_id"], w["app_id"], w["title"], w["focused"], w["minimized"]) for w in windows],
            show_labels,
            tuple((p.get("app_id", ""), p.get("cmd", ""), p.get("name", "")) for p in pinned_apps)
        )
        if self._last_state_key == state_key:
            return True
        self._last_state_key = state_key

        # Wyczyść obecne przyciski
        for child in self.tasks_box.get_children():
            self.tasks_box.remove(child)

        app_counts = {}
        for w in windows:
            app_counts[w["app_id"]] = app_counts.get(w["app_id"], 0) + 1

        used_window_indices = set()

        # A. Renderowanie przypiętych aplikacji (przekształcają się w aktywne okno po uruchomieniu!)
        for pin_idx, pin in enumerate(pinned_apps):
            pin_app_id = pin.get("app_id", "")
            pin_cmd = pin.get("cmd", pin_app_id)
            pin_name = pin.get("name", pin_app_id)
            pin_icon = pin.get("icon", "")

            # Szukaj pierwszego nieprzypisanego otwartego okna pasującego do tej przypiętej ikony
            matched_win = None
            for idx, w in enumerate(windows):
                if idx in used_window_indices:
                    continue
                if self._matches_pin(w["app_id"], pin):
                    matched_win = w
                    used_window_indices.add(idx)
                    break

            if matched_win is not None:
                h_id = matched_win["handle_id"]
                w_id = matched_win["app_id"]
                w_title = matched_win["title"]
                is_focused = matched_win["focused"]
                is_minimized = matched_win["minimized"]
                multiple = app_counts.get(w_id, 1) > 1
                icon_name = AppHelper.get_icon_name(w_id, pin_icon)

                btn = self._make_task_button(
                    icon_name=icon_name,
                    label_text=w_title or pin_name,
                    tooltip=f"{w_title or pin_name}",
                    show_label=show_labels,
                    is_pinned=True,
                    is_running=True,
                    is_focused=is_focused,
                    is_minimized=is_minimized
                )
                btn.connect("button-press-event", self._on_task_press, {
                    "handle_id": h_id,
                    "app_id": w_id,
                    "title": w_title,
                    "cmd": pin_cmd,
                    "icon": icon_name,
                    "name": pin_name,
                    "is_pinned": True,
                    "pin_index": pin_idx,
                    "is_running": True,
                    "is_focused": is_focused,
                    "is_minimized": is_minimized,
                    "multiple": multiple
                })
            else:
                icon_name = AppHelper.get_icon_name(pin_app_id, pin_icon)
                btn = self._make_task_button(
                    icon_name=icon_name,
                    label_text=pin_name,
                    tooltip=f"{pin_name}\nLPM: Uruchom | PPM: Opcje",
                    show_label=show_labels,
                    is_pinned=True,
                    is_running=False,
                    is_focused=False,
                    is_minimized=False
                )
                btn.connect("button-press-event", self._on_task_press, {
                    "handle_id": 0,
                    "app_id": pin_app_id,
                    "title": pin_name,
                    "cmd": pin_cmd,
                    "icon": icon_name,
                    "name": pin_name,
                    "is_pinned": True,
                    "pin_index": pin_idx,
                    "is_running": False,
                    "is_focused": False,
                    "is_minimized": False,
                    "multiple": False
                })

            self.tasks_box.pack_start(btn, False, False, 0)

        # B. Renderowanie pozostałych otwartych okien (nieprzypiętych lub kolejnych okien tej samej aplikacji)
        for idx, w in enumerate(windows):
            if idx in used_window_indices:
                continue
            h_id = w["handle_id"]
            w_id = w["app_id"]
            w_title = w["title"]
            is_focused = w["focused"]
            is_minimized = w["minimized"]
            multiple = app_counts.get(w_id, 1) > 1

            meta = AppHelper.get_app_metadata(w_id)
            icon_name = AppHelper.get_icon_name(w_id, meta.get("icon", ""))

            btn = self._make_task_button(
                icon_name=icon_name,
                label_text=w_title or meta.get("name", w_id),
                tooltip=f"{w_title or w_id}",
                show_label=show_labels,
                is_pinned=False,
                is_running=True,
                is_focused=is_focused,
                is_minimized=is_minimized
            )
            btn.connect("button-press-event", self._on_task_press, {
                "handle_id": h_id,
                "app_id": w_id,
                "title": w_title,
                "cmd": meta.get("cmd", w_id),
                "icon": icon_name,
                "name": meta.get("name", w_id),
                "is_pinned": False,
                "pin_index": -1,
                "is_running": True,
                "is_focused": is_focused,
                "is_minimized": is_minimized,
                "multiple": multiple
            })
            self.tasks_box.pack_start(btn, False, False, 0)

        self.tasks_box.show_all()
        return True

    def _on_task_press(self, widget, event, item: dict):
        if event.button == 1:
            if not item["is_running"]:
                try:
                    subprocess.Popen(item["cmd"].split(), start_new_session=True)
                except Exception:
                    pass
            else:
                WindowManager.activate_or_minimize(
                    item["handle_id"],
                    item["app_id"],
                    item["title"],
                    item["is_focused"],
                    item["is_minimized"],
                    item["multiple"]
                )
        elif event.button == 2 and item["is_running"]:
            WindowManager.close_window(item["handle_id"], item["app_id"], item["title"], item["multiple"])
        elif event.button == 3:
            self._show_context_menu(widget, event, item)
        return True

    def _show_context_menu(self, widget, event, item: dict):
        menu = Gtk.Menu()

        # Opcja 1: Przypnij / Odepnij od paska
        if item["is_pinned"]:
            mi_pin = Gtk.MenuItem(label="Odepnij od paska")
            mi_pin.connect("activate", lambda _: self._unpin_app(item))
        else:
            mi_pin = Gtk.MenuItem(label="Przypnij do paska")
            mi_pin.connect("activate", lambda _: self._pin_app(item))
        menu.append(mi_pin)

        # Opcja 2: Uruchom / Nowe okno
        if item["cmd"]:
            lbl_launch = "Otwórz nowe okno" if item["is_running"] else "Uruchom"
            mi_launch = Gtk.MenuItem(label=lbl_launch)
            mi_launch.connect("activate", lambda _: subprocess.Popen(item["cmd"].split(), start_new_session=True))
            menu.append(mi_launch)

        # Opcja 3 i 4: Kontrola otwartego okna
        if item["is_running"]:
            menu.append(Gtk.SeparatorMenuItem())
            if item["is_minimized"]:
                mi_state = Gtk.MenuItem(label="Przywróć okno")
                mi_state.connect("activate", lambda _: WindowManager.set_minimized(item["handle_id"], item["app_id"], item["title"], False, item["multiple"]))
            else:
                mi_state = Gtk.MenuItem(label="Minimalizuj okno")
                mi_state.connect("activate", lambda _: WindowManager.set_minimized(item["handle_id"], item["app_id"], item["title"], True, item["multiple"]))
            menu.append(mi_state)

            mi_close = Gtk.MenuItem(label="Zamknij okno")
            mi_close.connect("activate", lambda _: WindowManager.close_window(item["handle_id"], item["app_id"], item["title"], item["multiple"]))
            menu.append(mi_close)

        menu.show_all()
        menu.popup_at_widget(widget, Gdk.Gravity.NORTH, Gdk.Gravity.SOUTH, event)

    def _pin_app(self, item: dict):
        cfg = PanelConfigManager.load()
        pins = cfg.get("pinned_apps", [])
        # Zapobiegaj duplikatom na liście przypiętych
        if not any(self._matches_pin(item["app_id"], p) for p in pins):
            pins.append({
                "app_id": item["app_id"],
                "name": item.get("name", item["app_id"]),
                "cmd": item.get("cmd", item["app_id"]),
                "icon": item.get("icon", "application-x-executable")
            })
            cfg["pinned_apps"] = pins
            PanelConfigManager.save(cfg)
            self._config_mtime = -1
            self._update_tasks()

    def _unpin_app(self, item: dict):
        cfg = PanelConfigManager.load()
        pins = cfg.get("pinned_apps", [])
        idx = item.get("pin_index", -1)
        if 0 <= idx < len(pins):
            pins.pop(idx)
        else:
            pins = [p for p in pins if not self._matches_pin(item["app_id"], p)]
        cfg["pinned_apps"] = pins
        PanelConfigManager.save(cfg)
        self._config_mtime = -1
        self._update_tasks()

    # ------------------------------------------------------------------------
    # Statusy: Zegar, Głośność, Bateria
    # ------------------------------------------------------------------------

    def _update_status(self) -> bool:
        now = datetime.now()
        self.lbl_clock.set_markup(f"<b>{now.strftime('%H:%M')}</b>\n<small>{now.strftime('%d.%m.%Y')}</small>")
        self.btn_clock.set_tooltip_text(now.strftime("%A, %d %B %Y"))

        # Głośność (wpctl)
        try:
            res = subprocess.run(
                ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                capture_output=True, text=True, timeout=0.2, check=False
            )
            if res.returncode == 0:
                out = res.stdout.strip()
                is_muted = "[MUTED]" in out
                parts = out.split()
                vol = 100
                if len(parts) >= 2:
                    try:
                        vol = int(float(parts[1]) * 100)
                    except ValueError:
                        pass

                if is_muted:
                    self.img_volume.set_from_icon_name("audio-volume-muted", Gtk.IconSize.MENU)
                    self.lbl_volume.set_text("Mute")
                    self.btn_volume.set_tooltip_text("Dźwięk wyciszony (LPM: Mikser, PPM: Włącz)")
                else:
                    icon = "audio-volume-high" if vol > 65 else ("audio-volume-medium" if vol > 25 else "audio-volume-low")
                    self.img_volume.set_from_icon_name(icon, Gtk.IconSize.MENU)
                    self.lbl_volume.set_text(f"{vol}%")
                    self.btn_volume.set_tooltip_text(f"Głośność: {vol}%\nLPM: Mikser, Rolka: +/-")
        except Exception:
            pass

        # Bateria
        bat_dirs = glob.glob("/sys/class/power_supply/BAT*")
        if bat_dirs:
            try:
                bat_dir = bat_dirs[0]
                cap_file = os.path.join(bat_dir, "capacity")
                stat_file = os.path.join(bat_dir, "status")
                if os.path.exists(cap_file):
                    with open(cap_file, "r", encoding="utf-8") as f:
                        cap = int(f.read().strip())
                    status = "Discharging"
                    if os.path.exists(stat_file):
                        with open(stat_file, "r", encoding="utf-8") as f:
                            status = f.read().strip()

                    is_charging = (status == "Charging")
                    icon = "battery-charging" if is_charging else ("battery-full" if cap > 75 else ("battery-good" if cap > 35 else "battery-low"))
                    self.img_battery.set_from_icon_name(icon, Gtk.IconSize.MENU)
                    self.lbl_battery.set_text(f"{cap}%")
                    self.box_battery.set_tooltip_text(f"Bateria: {cap}% ({status})")
                    self.box_battery.set_visible(True)
            except Exception:
                self.box_battery.set_visible(False)
        else:
            self.box_battery.set_visible(False)

        return True


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)

    app = OkayPanel()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
