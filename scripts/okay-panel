#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Panel (okay-panel)
Zunifikowany, natywny pasek zadań środowiska OKay DE (Wayland / labwc).
Funkcje:
- Jeden zunifikowany kontener zadań (przypięte aplikacje + dynamiczne otwarte okna w wlrctl)
- Brak duplikacji ikon (uruchomiona przypięta aplikacja przekształca się w przycisk okna)
- Menu kontekstowe pod PPM: Przypnij do paska / Odepnij od paska / Zamknij / Minimalizuj
- Obsługa trybu „Tylko ikony” oraz „Ikony + nazwy” z ~/.config/okay-de/panel.json
- Wyłączność instancji (blokada flock + ubijanie starych procesów waybar/sfwbar/okay-dock)
"""

import os
import sys
import gc
import copy
import fcntl
import glob
import json
import shlex
import time
import signal
import shutil
import socket
import struct
import threading
import subprocess
from datetime import datetime

# 1. Ograniczenie aren alokatora glibc, wyłączenie mostu AT-SPI i wymuszenie Wayland
os.environ.setdefault("MALLOC_ARENA_MAX", "2")
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ["GDK_BACKEND"] = "wayland"

# Agresywniejsze zwalnianie krótkotrwałych obiektów Pythona w procesie działającym w tle
gc.set_threshold(500, 5, 5)

# 2. Ustawienie nazwy procesu w jądrze Linux oraz dostęp do malloc_trim(0)
_LIBC = None
try:
    import ctypes
    try:
        _LIBC = ctypes.CDLL("libc.so.6")
    except OSError:
        _LIBC = ctypes.CDLL(None)
    _LIBC.prctl(15, b"okay-panel", 0, 0, 0)
except Exception:
    _LIBC = None


def _trim_heap():
    """Zwraca nieużywane strony sterty C (GTK/GdkPixbuf/Pango) z powrotem do jądra Linux."""
    try:
        gc.collect(0)
        if _LIBC is not None and hasattr(_LIBC, "malloc_trim"):
            _LIBC.malloc_trim(0)
    except Exception:
        pass


def _runtime_state_dir() -> str:
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if xdg_runtime and os.path.isdir(xdg_runtime) and os.access(xdg_runtime, os.W_OK):
        return xdg_runtime
    return "/tmp"


def _pid_file_path() -> str:
    uid = os.getuid() if hasattr(os, "getuid") else 0
    rdir = _runtime_state_dir()
    if rdir != "/tmp":
        return os.path.join(rdir, "okay-panel.pid")
    return f"/tmp/okay-panel-{uid}.pid"


def _lock_file_path() -> str:
    uid = os.getuid() if hasattr(os, "getuid") else 0
    rdir = _runtime_state_dir()
    if rdir != "/tmp":
        return os.path.join(rdir, "okay-panel.lock")
    return f"/tmp/okay-panel-{uid}.lock"


def cleanup_other_panels():
    """Zamyka wszystkie starsze/konfliktowe paski (waybar, sfwbar, okay-dock, starszy okay-panel)."""
    for proc_name in ("waybar", "sfwbar", "okay-dock"):
        try:
            subprocess.run(["pkill", "-9", "-x", proc_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    my_pid = os.getpid()
    parent_pid = os.getppid()
    for pid_file in (_pid_file_path(), "/tmp/okay-panel.pid"):
        if os.path.exists(pid_file):
            try:
                with open(pid_file, "r", encoding="utf-8") as f:
                    old_pid = int(f.read().strip())
                if old_pid not in (my_pid, parent_pid):
                    os.kill(old_pid, signal.SIGKILL)
            except Exception:
                pass

    try:
        # Używamy -x (dokładna nazwa procesu z prctl) zamiast -f, aby nie zabić powłoki rodzica
        res = subprocess.run(["pgrep", "-x", "okay-panel"], capture_output=True, text=True, check=False)
        for line in res.stdout.strip().splitlines():
            try:
                pid = int(line.strip())
                if pid not in (my_pid, parent_pid):
                    os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
    except Exception:
        pass

    time.sleep(0.2)


# Natychmiastowe czyszczenie starych instancji i blokada pojedynczej instancji
cleanup_other_panels()

_LOCK_FILE = None
try:
    _LOCK_FILE = open(_lock_file_path(), "w", encoding="utf-8")
    try:
        fcntl.flock(_LOCK_FILE.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # Jeśli lock nadal jest trzymany, odczekaj chwilę i spróbuj ponownie
        time.sleep(0.3)
        try:
            fcntl.flock(_LOCK_FILE.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(0)
except OSError:
    _LOCK_FILE = None

try:
    with open(_pid_file_path(), "w", encoding="utf-8") as _pf:
        _pf.write(str(os.getpid()))
except OSError:
    pass


# 3. Inicjalizacja GTK3 i GtkLayerShell
try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf
except (ImportError, ValueError) as err:
    print(f"Błąd uruchamiania okay-panel (GTK3): {err}", file=sys.stderr)
    sys.exit(1)

HAS_LAYER_SHELL = False
try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell
    HAS_LAYER_SHELL = True
except (ValueError, ImportError):
    if shutil.which("pacman"):
        installed = False
        if shutil.which("sudo"):
            res = subprocess.run(["sudo", "-n", "pacman", "-S", "--needed", "--noconfirm", "gtk-layer-shell"], check=False)
            installed = (res.returncode == 0)
        if not installed and shutil.which("pkexec"):
            subprocess.run(["pkexec", "pacman", "-S", "--needed", "--noconfirm", "gtk-layer-shell"], check=False)
    try:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell
        HAS_LAYER_SHELL = True
    except (ValueError, ImportError):
        HAS_LAYER_SHELL = False

if not HAS_LAYER_SHELL:
    print("BŁĄD KRYTYCZNY: okay-panel wymaga pakietu 'gtk-layer-shell'. Zainstaluj: sudo pacman -S gtk-layer-shell", file=sys.stderr)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", "OKay DE", "Brak pakietu gtk-layer-shell! Zainstaluj: sudo pacman -S gtk-layer-shell"], check=False)
    sys.exit(1)

# Rozwiązanie ścieżki modularnych widżetów panelu (`panel/`: SNI, Quick Settings, Ghost Runner)
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
for _candidate in (
    _SCRIPT_DIR,
    os.path.expanduser("~/.local/share/okay-de"),
    "/usr/local/share/okay-de",
    "/usr/share/okay-de",
):
    if os.path.isdir(os.path.join(_candidate, "panel")) and _candidate not in sys.path:
        sys.path.insert(0, _candidate)

from panel import StatusNotifierTray, QuickSettingsPopover, GhostRunnerIndicator


