#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Panel (okay-panel)
Natywny pasek zadań środowiska graficznego OKay DE dla dystrybucji OKsavi Linux.
Stos technologiczny: Python 3, GTK 3, GtkLayerShell (wlr-layer-shell dla Wayland).
Motyw: Catppuccin Mocha | Styl: KDE Plasma (0px radius, ostre krawędzie, biała kreska statusu).
"""

import os
import sys
import glob
import json
import time
import signal
import shutil
import subprocess
from datetime import datetime

# Inicjalizacja bibliotek GTK3 i Wayland Layer-Shell
import gi
gi.require_version('Gtk', '3.0')
try:
    gi.require_version('GtkLayerShell', '0.1')
    from gi.repository import GtkLayerShell
    HAS_LAYER_SHELL = True
except (ValueError, ImportError):
    HAS_LAYER_SHELL = False

from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf

# ============================================================================
# Style CSS (Catppuccin Mocha - 0px radius, ostry design)
# ============================================================================

