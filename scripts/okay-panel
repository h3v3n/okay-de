#!/usr/bin/env bash

# OKay DE - Główny zarządca paska zadań (Panel Launcher & Supervisor)
# Wybiera sprawdzony, stabilny backend: sfwbar (C/layer-shell) lub waybar (oficjalny Arch Linux).

set -eo pipefail

ACTION="${1:-start}"

restart_panel() {
    pkill -9 -f "okay-panel" 2>/dev/null || true
    pkill -9 -x sfwbar 2>/dev/null || true
    pkill -9 -x waybar 2>/dev/null || true
    sleep 0.2
}

if [ "$ACTION" = "--restart" ] || [ "$ACTION" = "restart" ]; then
    restart_panel
fi

CONFIG_DIR="$HOME/.config/okay-de/panel"
SYS_CONFIG_DIR="/etc/xdg/okay-de/panel"

# 1. Preferowany natywny lekki pasek C: sfwbar
if command -v sfwbar >/dev/null 2>&1; then
    SFW_CONF="$CONFIG_DIR/sfwbar.config"
    [ ! -f "$SFW_CONF" ] && SFW_CONF="$SYS_CONFIG_DIR/sfwbar.config"
    [ ! -f "$SFW_CONF" ] && SFW_CONF="$HOME/.config/sfwbar/sfwbar.config"
    [ ! -f "$SFW_CONF" ] && SFW_CONF="/etc/xdg/sfwbar/sfwbar.config"

    if [ -f "$SFW_CONF" ]; then
        exec sfwbar -f "$SFW_CONF" > /tmp/okay-panel.log 2>&1
    else
        exec sfwbar > /tmp/okay-panel.log 2>&1
    fi
fi

# 2. Sprawdzony, stabilny komponent z oficjalnego repo Archa: waybar
if command -v waybar >/dev/null 2>&1; then
    WAY_CONF="$CONFIG_DIR/waybar.jsonc"
    WAY_CSS="$CONFIG_DIR/waybar.css"
    [ ! -f "$WAY_CONF" ] && WAY_CONF="$SYS_CONFIG_DIR/waybar.jsonc"
    [ ! -f "$WAY_CSS" ] && WAY_CSS="$SYS_CONFIG_DIR/waybar.css"
    [ ! -f "$WAY_CONF" ] && WAY_CONF="$HOME/.config/waybar/config.jsonc"
    [ ! -f "$WAY_CSS" ] && WAY_CSS="$HOME/.config/waybar/style.css"

    if [ -f "$WAY_CONF" ] && [ -f "$WAY_CSS" ]; then
        exec waybar -c "$WAY_CONF" -s "$WAY_CSS" > /tmp/okay-panel.log 2>&1
    else
        exec waybar > /tmp/okay-panel.log 2>&1
    fi
fi

# 3. Jeśli żaden nie jest zainstalowany, próba automatycznej instalacji waybar
echo "Nie znaleziono sfwbar ani waybar. Próba instalacji waybar..." >&2
if command -v sudo >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm waybar 2>/dev/null || true
elif command -v pkexec >/dev/null 2>&1; then
    pkexec pacman -S --needed --noconfirm waybar 2>/dev/null || true
fi

if command -v waybar >/dev/null 2>&1; then
    exec waybar -c "$CONFIG_DIR/waybar.jsonc" -s "$CONFIG_DIR/waybar.css" > /tmp/okay-panel.log 2>&1
fi

echo "BŁĄD: Nie znaleziono kompatybilnego paska zadań (sfwbar ani waybar)." >&2
echo "Zainstaluj waybar poleceniem: sudo pacman -S waybar" >&2
exit 1
