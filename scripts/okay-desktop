}}
"""


class DesktopItem:
    """Reprezentuje pojedynczy element (plik, katalog lub skrót .desktop) na siatce pulpitu."""

    def __init__(self, path: Path):
        self.path: Path = path
        self.name: str = path.name
        self.display_name: str = path.name
        self.icon_name: str = "text-x-generic"
        self.is_dir: bool = path.is_dir()
        self.is_desktop_file: bool = path.suffix.lower() == ".desktop"
        self.exec_cmd: Optional[str] = None
        self.col: int = 0
        self.row: int = 0
        self.widget: Optional[Gtk.EventBox] = None
        self._parse_metadata()

    def _parse_metadata(self) -> None:
        if self.is_dir:
            self.icon_name = "folder"
            return

        if self.is_desktop_file:
            try:
                kf = GLib.KeyFile()
                kf.load_from_file(str(self.path), GLib.KeyFileFlags.NONE)
                grp = "Desktop Entry"
                if kf.has_group(grp):
                    for lang_key in ["Name[pl]", "Name"]:
                        try:
                            val = kf.get_string(grp, lang_key)
                            if val:
                                self.display_name = val
                                break
                        except Exception:
                            pass
                    try:
                        ico = kf.get_string(grp, "Icon")
                        if ico:
                            self.icon_name = ico
                    except Exception:
                        self.icon_name = "application-x-executable"
                    try:
                        self.exec_cmd = kf.get_string(grp, "Exec")
                    except Exception:
                        pass
                return
            except Exception:
                pass

        suffix = self.path.suffix.lower()
        if suffix in (".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".bmp"):
            self.icon_name = "image-x-generic"
        elif suffix in (".mp4", ".mkv", ".webm", ".avi", ".mov"):
            self.icon_name = "video-x-generic"
        elif suffix in (".mp3", ".flac", ".ogg", ".wav", ".m4a"):
            self.icon_name = "audio-x-generic"
        elif suffix in (".pdf",):
            self.icon_name = "application-pdf"
        elif suffix in (".zip", ".tar", ".gz", ".xz", ".zst", ".7z", ".rar"):
            self.icon_name = "package-x-generic"
        elif suffix in (".sh", ".py", ".rb", ".pl"):
            self.icon_name = "text-x-script"
        elif suffix in (".md", ".txt", ".log", ".ini", ".json", ".yaml", ".yml", ".toml"):
            self.icon_name = "text-x-generic"
        else:
            try:
                f = Gio.File.new_for_path(str(self.path))
                info = f.query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None)
                gicon = info.get_icon()
                if isinstance(gicon, Gio.ThemedIcon):
                    names = gicon.get_names()
                    if names:
                        self.icon_name = names[0]
            except Exception:
                self.icon_name = "text-x-generic"


class OkayDesktopWindow(Gtk.Window):
    """Główne okno warstwy tła (pulpit + siatka ikon Snap-to-Grid + menu kontekstowe)."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("okay-desktop")
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.get_style_context().add_class("desktop-window")

        self.desktop_dir: Path = get_desktop_dir()
        self.wallpaper_pixbuf: Optional[GdkPixbuf.Pixbuf] = None
        self.wallpaper_surface: Optional[GdkPixbuf.Pixbuf] = None
        self.wallpaper_path: Optional[str] = None
        self.scaled_cache_size: Tuple[int, int] = (0, 0)

        self.theme_mode: str = "dark"
        self.accent_color: str = "#cba6f7"
        self.accent_rgb: Tuple[float, float, float] = (0.796, 0.651, 0.969)

        self.items: List[DesktopItem] = []
        self.selected_paths: set[Path] = set()
        self.grid_positions: Dict[str, Tuple[int, int]] = {}

        # Stan przeciągania ikony (Snap-to-Grid)
        self.pressed_item: Optional[DesktopItem] = None
        self.press_start_root: Tuple[float, float] = (0.0, 0.0)
        self.press_offset: Tuple[float, float] = (0.0, 0.0)
        self.is_dragging_icon: bool = False
        self.drag_hover_cell: Optional[Tuple[int, int]] = None

        # Stan zaznaczania prostokątem (rubberband) na pustym tle
        self.rubberband_active: bool = False
        self.rb_start: Tuple[float, float] = (0.0, 0.0)
        self.rb_current: Tuple[float, float] = (0.0, 0.0)

        self.css_provider = Gtk.CssProvider()
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(
                screen, self.css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self._load_theme_and_css()
        self._load_grid_positions()
        self._setup_layer_shell()
        self._build_ui()
        self._load_wallpaper_from_config()
        self._populate_desktop_items()
        self._setup_monitors()

    def _load_theme_and_css(self) -> None:
        if PANEL_CONFIG_FILE.exists():
            try:
                data = json.loads(PANEL_CONFIG_FILE.read_text(encoding="utf-8"))
                self.theme_mode = str(data.get("theme_mode", "dark"))
                self.accent_color = str(data.get("accent_color", "#cba6f7"))
            except Exception:
                pass
        self.accent_rgb = hex_to_rgb_float(self.accent_color)
        css = build_desktop_css(self.theme_mode, self.accent_color)
        try:
            self.css_provider.load_from_data(css.encode("utf-8"))
        except Exception:
            pass
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", self.theme_mode != "light")

    def _load_grid_positions(self) -> None:
        self.grid_positions.clear()
        if not GRID_CONFIG_FILE.exists():
            return
        try:
            raw = json.loads(GRID_CONFIG_FILE.read_text(encoding="utf-8"))
            if isinstance(raw, dict):
                for k, v in raw.items():
                    if isinstance(v, (list, tuple)) and len(v) == 2:
                        self.grid_positions[str(k)] = (max(0, int(v[0])), max(0, int(v[1])))
        except Exception:
            pass

    def _save_grid_positions(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            payload = {item.name: [item.col, item.row] for item in self.items}
            self.grid_positions = {k: (v[0], v[1]) for k, v in payload.items()}
            fd, tmp_path = tempfile.mkstemp(prefix=".desktop_grid_", dir=str(CONFIG_DIR), text=True)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=2, ensure_ascii=False)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_path, GRID_CONFIG_FILE)
        except Exception:
            pass

    def _setup_layer_shell(self) -> None:
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() if display else None
        if not monitor and display and display.get_n_monitors() > 0:
            monitor = display.get_monitor(0)

        if HAS_LAYER_SHELL:
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "okay-desktop")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BACKGROUND)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
            GtkLayerShell.set_exclusive_zone(self, -1)
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
            if monitor:
                GtkLayerShell.set_monitor(self, monitor)

        if monitor:
            geom = monitor.get_geometry()
            self.set_default_size(geom.width, geom.height)
        else:
            self.set_default_size(1920, 1080)

    def _build_ui(self) -> None:
        self.overlay = Gtk.Overlay()
        self.add(self.overlay)

        # Warstwa tła (tapeta + obsługa kliknięć i zaznaczania na pustym pulpicie)
        self.bg_area = Gtk.EventBox()
        self.bg_area.set_hexpand(True)
        self.bg_area.set_vexpand(True)
        self.bg_area.set_visible_window(True)
        self.bg_area.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
        )
        self.bg_area.connect("button-press-event", self._on_bg_button_press)
        self.bg_area.connect("button-release-event", self._on_bg_button_release)
        self.bg_area.connect("motion-notify-event", self._on_bg_motion)

        self.bg_image = Gtk.Image()
        self.bg_image.set_hexpand(True)
        self.bg_image.set_vexpand(True)
        self.bg_area.add(self.bg_image)
        self.overlay.add(self.bg_area)

        # Warstwa siatki ikon (Gtk.Fixed umożliwia pozycjonowanie co do piksela i płynny Drag & Drop)
        self.fixed_canvas = Gtk.Fixed()
        self.fixed_canvas.set_hexpand(True)
        self.fixed_canvas.set_vexpand(True)
        self.overlay.add_overlay(self.fixed_canvas)
        self.overlay.set_overlay_pass_through(self.fixed_canvas, True)

        # Wskaźnik docelowej komórki siatki podczas przeciągania ikony
        self.drag_cell_box = Gtk.Box()
        self.drag_cell_box.set_size_request(ICON_BOX_W, ICON_BOX_H)
        self.drag_cell_box.get_style_context().add_class("desktop-grid-target")
        self.drag_cell_box.set_no_show_all(True)

        # Prostokąt zaznaczania (rubberband)
        self.rubberband_box = Gtk.Box()
        self.rubberband_box.get_style_context().add_class("desktop-rubberband")
        self.rubberband_box.set_no_show_all(True)

        self.connect("key-press-event", self._on_key_press)
        self.connect("size-allocate", self._on_window_size_allocate)

    def _get_grid_dimensions(self) -> Tuple[int, int]:
        alloc = self.get_allocation()
        w = alloc.width if alloc.width > 200 else 1920
        h = alloc.height if alloc.height > 200 else 1080
        # Zostawiamy miejsce na dolny/górny panel (~56px)
        usable_w = max(CELL_W, w - 2 * GRID_MARGIN_X)
        usable_h = max(CELL_H, h - 2 * GRID_MARGIN_Y - 52)
        max_cols = max(1, usable_w // CELL_W)
        max_rows = max(1, usable_h // CELL_H)
        return (max_cols, max_rows)

    def _cell_to_pixel(self, col: int, row: int) -> Tuple[int, int]:
        x = GRID_MARGIN_X + col * CELL_W + (CELL_W - ICON_BOX_W) // 2
        y = GRID_MARGIN_Y + row * CELL_H + (CELL_H - ICON_BOX_H) // 2
        return (x, y)

    def _pixel_to_cell(self, x: float, y: float) -> Tuple[int, int]:
        max_cols, max_rows = self._get_grid_dimensions()
        col = int((x - GRID_MARGIN_X) // CELL_W)
        row = int((y - GRID_MARGIN_Y) // CELL_H)
        col = max(0, min(max_cols - 1, col))
        row = max(0, min(max_rows - 1, row))
        return (col, row)

    def _on_window_size_allocate(self, _widget: Gtk.Widget, alloc: Gdk.Rectangle) -> None:
        self._ensure_scaled_wallpaper(alloc.width, alloc.height)
        if not self.items or self.is_dragging_icon:
            return
        max_cols, max_rows = self._get_grid_dimensions()
        changed = False
        for item in self.items:
            if item.col >= max_cols or item.row >= max_rows:
                item.col = min(item.col, max_cols - 1)
                item.row = min(item.row, max_rows - 1)
                changed = True
            if item.widget:
                px, py = self._cell_to_pixel(item.col, item.row)
                self.fixed_canvas.move(item.widget, px, py)
        if changed:
            self._save_grid_positions()

    # ------------------------------------------------------------------
    # Tapeta (ładowanie + skalowanie GdkPixbuf)
    # ------------------------------------------------------------------
    def _load_wallpaper_from_config(self) -> None:
        wp_path: Optional[Path] = None
        if PANEL_CONFIG_FILE.exists():
            try:
                data = json.loads(PANEL_CONFIG_FILE.read_text(encoding="utf-8"))
                raw = data.get("wallpaper", "")
                if raw:
                    cand = Path(os.path.expanduser(str(raw)))
                    if cand.exists():
                        wp_path = cand
            except Exception:
                pass

        if not wp_path:
            for fb in FALLBACK_WALLPAPERS:
                if fb.exists():
                    wp_path = fb
                    break

        if wp_path and str(wp_path) != self.wallpaper_path:
            try:
                self.wallpaper_pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(wp_path))
                self.wallpaper_path = str(wp_path)
                self.wallpaper_surface = None
                self.scaled_cache_size = (0, 0)
            except Exception:
                self.wallpaper_pixbuf = None
                self.wallpaper_surface = None

        alloc = self.get_allocation()
        w = alloc.width if alloc.width > 200 else 1920
        h = alloc.height if alloc.height > 200 else 1080
        self._ensure_scaled_wallpaper(w, h)

    def _ensure_scaled_wallpaper(self, width: int, height: int) -> None:
        if not self.wallpaper_pixbuf or width <= 200 or height <= 200:
            return
        if self.wallpaper_surface and self.scaled_cache_size == (width, height):
            return

        src_w = self.wallpaper_pixbuf.get_width()
        src_h = self.wallpaper_pixbuf.get_height()
        if src_w <= 0 or src_h <= 0:
            return

        scale = max(width / src_w, height / src_h)
        new_w = max(width, int(src_w * scale))
        new_h = max(height, int(src_h * scale))

        scaled = self.wallpaper_pixbuf.scale_simple(
            new_w, new_h, GdkPixbuf.InterpType.BILINEAR
        )
        if not scaled:
            return

        offset_x = (new_w - width) // 2
        offset_y = (new_h - height) // 2
        cropped = GdkPixbuf.Pixbuf.new_subpixbuf(scaled, offset_x, offset_y, width, height)

        self.wallpaper_surface = cropped
        self.scaled_cache_size = (width, height)
        self.bg_image.set_from_pixbuf(cropped)

    def _update_overlay_indicators(self) -> None:
        if self.is_dragging_icon and self.drag_hover_cell is not None:
            hc, hr = self.drag_hover_cell
            hx, hy = self._cell_to_pixel(hc, hr)
            if self.drag_cell_box.get_parent() is None:
                self.fixed_canvas.put(self.drag_cell_box, hx, hy)
            else:
                self.fixed_canvas.move(self.drag_cell_box, hx, hy)
            self.drag_cell_box.show()
        else:
            self.drag_cell_box.hide()

        if self.rubberband_active:
            x0, y0 = self.rb_start
            x1, y1 = self.rb_current
            rx = int(min(x0, x1))
            ry = int(min(y0, y1))
            rw = int(abs(x1 - x0))
            rh = int(abs(y1 - y0))
            if rw > 4 and rh > 4:
                self.rubberband_box.set_size_request(rw, rh)
                if self.rubberband_box.get_parent() is None:
                    self.fixed_canvas.put(self.rubberband_box, rx, ry)
                else:
                    self.fixed_canvas.move(self.rubberband_box, rx, ry)
                self.rubberband_box.show()
            else:
                self.rubberband_box.hide()
        else:
            self.rubberband_box.hide()

    # ------------------------------------------------------------------
    # Wypełnianie i rozmieszczanie ikon na siatce (Snap-to-Grid)
    # ------------------------------------------------------------------
    def _find_free_cell(self, occupied: set[Tuple[int, int]]) -> Tuple[int, int]:
        max_cols, max_rows = self._get_grid_dimensions()
        # Domyślnie układamy kolumnami z góry na dół (jak w klasycznych pulpitach)
        for col in range(max_cols):
            for row in range(max_rows):
                if (col, row) not in occupied:
                    return (col, row)
        # Fallback jeśli pulpit jest pełny
        idx = len(occupied)
        return (idx % max_cols, (idx // max_cols) % max_rows)

    def _populate_desktop_items(self) -> None:
        for child in list(self.fixed_canvas.get_children()):
            if child not in (self.drag_cell_box, self.rubberband_box):
                self.fixed_canvas.remove(child)
        self.items.clear()

        if not self.desktop_dir.exists():
            return

        entries: List[Path] = []
        try:
            for p in self.desktop_dir.iterdir():
                if not p.name.startswith("."):
                    entries.append(p)
        except Exception:
            return

        entries.sort(key=lambda p: (not p.is_dir(), p.name.lower()))
        max_cols, max_rows = self._get_grid_dimensions()
        occupied: set[Tuple[int, int]] = set()
        needs_save = False

        # Najpierw przypisz elementy z zapisanymi pozycjami w desktop_grid.json
        unassigned: List[DesktopItem] = []
        for path in entries:
            item = DesktopItem(path)
            self.items.append(item)
            saved = self.grid_positions.get(item.name)
            if saved is not None:
                c = min(max(0, saved[0]), max_cols - 1)
                r = min(max(0, saved[1]), max_rows - 1)
                if (c, r) not in occupied:
                    item.col, item.row = c, r
                    occupied.add((c, r))
                else:
                    unassigned.append(item)
            else:
                unassigned.append(item)

        # Nowym elementom przydziel pierwsze wolne komórki siatki
        for item in unassigned:
            c, r = self._find_free_cell(occupied)
            item.col, item.row = c, r
            occupied.add((c, r))
            needs_save = True

        for item in self.items:
            widget = self._create_item_widget(item)
            item.widget = widget
            px, py = self._cell_to_pixel(item.col, item.row)
            self.fixed_canvas.put(widget, px, py)

        self.fixed_canvas.show_all()
        if needs_save:
            self._save_grid_positions()

    def _auto_arrange_grid(self) -> None:
        """Porządkuje wszystkie ikony po kolei w siatce i zapisuje układ."""
        max_cols, max_rows = self._get_grid_dimensions()
        occupied: set[Tuple[int, int]] = set()
        self.items.sort(key=lambda it: (not it.is_dir, it.display_name.lower()))
        for item in self.items:
            c, r = self._find_free_cell(occupied)
            item.col, item.row = c, r
            occupied.add((c, r))
            if item.widget:
                px, py = self._cell_to_pixel(c, r)
                self.fixed_canvas.move(item.widget, px, py)
        self._save_grid_positions()
        self._update_overlay_indicators()

    def _create_item_widget(self, item: DesktopItem) -> Gtk.EventBox:
        eb = Gtk.EventBox()
        eb.set_visible_window(False)
        eb.set_size_request(ICON_BOX_W, ICON_BOX_H)
        eb.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.ENTER_NOTIFY_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_size_request(ICON_BOX_W, ICON_BOX_H)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)
        box.get_style_context().add_class("desktop-item")
        if item.path in self.selected_paths:
            box.get_style_context().add_class("desktop-item-selected")

        img = self._load_item_image(item, 48)
        box.pack_start(img, False, False, 2)

        lbl = Gtk.Label(label=item.display_name)
        lbl.get_style_context().add_class("desktop-label")
        lbl.set_max_width_chars(12)
        lbl.set_lines(2)
        lbl.set_line_wrap(True)
        lbl.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_justify(Gtk.Justification.CENTER)
        box.pack_start(lbl, False, False, 0)

        eb.add(box)
        eb._item_box = box  # type: ignore[attr-defined]
        eb._desktop_item = item  # type: ignore[attr-defined]

        eb.connect("button-press-event", self._on_item_button_press, item)
        eb.connect("button-release-event", self._on_item_button_release, item)
        eb.connect("motion-notify-event", self._on_item_motion, item)
        return eb

    def _load_item_image(self, item: DesktopItem, size: int) -> Gtk.Image:
        if os.path.isabs(item.icon_name) and os.path.exists(item.icon_name):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(item.icon_name, size, size, True)
                return Gtk.Image.new_from_pixbuf(pb)
            except Exception:
                pass

        if item.path.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp", ".svg"):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(item.path), size, size, True)
                return Gtk.Image.new_from_pixbuf(pb)
            except Exception:
                pass

        theme = Gtk.IconTheme.get_default()
        if theme:
            for candidate in [item.icon_name, "application-x-executable", "text-x-generic"]:
                if theme.has_icon(candidate):
                    try:
                        pb = theme.load_icon(candidate, size, Gtk.IconLookupFlags.FORCE_SIZE)
                        if pb:
                            return Gtk.Image.new_from_pixbuf(pb)
                    except Exception:
                        pass

        img = Gtk.Image.new_from_icon_name(item.icon_name, Gtk.IconSize.DIALOG)
        img.set_pixel_size(size)
        return img

    def _update_selection_visuals(self) -> None:
        for item in self.items:
            if not item.widget:
                continue
            box = getattr(item.widget, "_item_box", None)
            if not box:
                continue
            ctx = box.get_style_context()
            if item.path in self.selected_paths:
                ctx.add_class("desktop-item-selected")
            else:
                ctx.remove_class("desktop-item-selected")

    # ------------------------------------------------------------------
    # Obsługa kliknięć oraz przeciągania ikon po siatce (Drag & Drop)
    # ------------------------------------------------------------------
    def _on_item_button_press(self, widget: Gtk.EventBox, event: Gdk.EventButton, item: DesktopItem) -> bool:
        if event.button == 1:
            if event.type == Gdk.EventType._2BUTTON_PRESS:
                self.pressed_item = None
                self.is_dragging_icon = False
                self._open_item(item)
                return True

            ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
            if ctrl:
                if item.path in self.selected_paths:
                    self.selected_paths.remove(item.path)
                else:
                    self.selected_paths.add(item.path)
            else:
                if item.path not in self.selected_paths:
                    self.selected_paths = {item.path}
            self._update_selection_visuals()

            # Przygotuj stan pod potencjalne przeciąganie ikony
            self.pressed_item = item
            self.is_dragging_icon = False
            self.press_start_root = (event.x_root, event.y_root)
            self.press_offset = (event.x, event.y)
            return True

        if event.button == 3:
            if item.path not in self.selected_paths:
                self.selected_paths = {item.path}
                self._update_selection_visuals()
            self._show_item_context_menu(event, item)
            return True

        return False

    def _on_item_motion(self, widget: Gtk.EventBox, event: Gdk.EventMotion, item: DesktopItem) -> bool:
        if self.pressed_item is not item:
            return False

        dx = event.x_root - self.press_start_root[0]
        dy = event.y_root - self.press_start_root[1]
        if not self.is_dragging_icon:
            if (dx * dx + dy * dy) ** 0.5 < DRAG_THRESHOLD:
                return False
            self.is_dragging_icon = True
            box = getattr(widget, "_item_box", None)
            if box:
                box.get_style_context().add_class("desktop-item-dragging")

        # Oblicz pozycję kursora względem okna pulpitu
        win_origin = self.get_window().get_origin() if self.get_window() else (0, 0, 0)
        win_x = win_origin[1] if len(win_origin) == 3 else 0
        win_y = win_origin[2] if len(win_origin) == 3 else 0
        canvas_x = event.x_root - win_x - self.press_offset[0]
        canvas_y = event.y_root - win_y - self.press_offset[1]

        alloc = self.get_allocation()
        new_x = int(max(4, min(alloc.width - ICON_BOX_W - 4, canvas_x)))
        new_y = int(max(4, min(alloc.height - ICON_BOX_H - 4, canvas_y)))
        self.fixed_canvas.move(widget, new_x, new_y)

        center_x = new_x + ICON_BOX_W * 0.5
        center_y = new_y + ICON_BOX_H * 0.5
        self.drag_hover_cell = self._pixel_to_cell(center_x, center_y)
        self._update_overlay_indicators()
        return True

    def _on_item_button_release(self, widget: Gtk.EventBox, event: Gdk.EventButton, item: DesktopItem) -> bool:
        if event.button != 1 or self.pressed_item is not item:
            return False

        box = getattr(widget, "_item_box", None)
        if box:
            box.get_style_context().remove_class("desktop-item-dragging")

        if self.is_dragging_icon and self.drag_hover_cell is not None:
            target_col, target_row = self.drag_hover_cell
            old_col, old_row = item.col, item.row

            # Sprawdź, czy inna ikona zajmuje docelową komórkę — jeśli tak, zamień je miejscami!
            occupant: Optional[DesktopItem] = None
            for other in self.items:
                if other is not item and other.col == target_col and other.row == target_row:
                    occupant = other
                    break

            item.col, item.row = target_col, target_row
            px, py = self._cell_to_pixel(item.col, item.row)
            self.fixed_canvas.move(widget, px, py)

            if occupant is not None:
                occupant.col, occupant.row = old_col, old_row
                if occupant.widget:
                    opx, opy = self._cell_to_pixel(occupant.col, occupant.row)
                    self.fixed_canvas.move(occupant.widget, opx, opy)

            self._save_grid_positions()

        self.pressed_item = None
        self.is_dragging_icon = False
        self.drag_hover_cell = None
        self._update_overlay_indicators()
        return True

    def _on_bg_button_press(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button == 1:
            self.selected_paths.clear()
            self._update_selection_visuals()
            self.rubberband_active = True
            self.rb_start = (event.x, event.y)
            self.rb_current = (event.x, event.y)
            self._update_overlay_indicators()
            return True

        if event.button == 3:
            self._show_desktop_context_menu(event)
            return True

        return False

    def _on_bg_motion(self, _widget: Gtk.Widget, event: Gdk.EventMotion) -> bool:
        if not self.rubberband_active:
            return False
        self.rb_current = (event.x, event.y)
        self._select_items_in_rubberband()
        self._update_overlay_indicators()
        return True

    def _on_bg_button_release(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button == 1 and self.rubberband_active:
            self.rubberband_active = False
            self._update_overlay_indicators()
            return True
        return False

    def _select_items_in_rubberband(self) -> None:
        x0, y0 = self.rb_start
        x1, y1 = self.rb_current
        rx0, rx1 = min(x0, x1), max(x0, x1)
        ry0, ry1 = min(y0, y1), max(y0, y1)

        new_sel: set[Path] = set()
        for item in self.items:
            ix, iy = self._cell_to_pixel(item.col, item.row)
            ix1 = ix + ICON_BOX_W
            iy1 = iy + ICON_BOX_H
            if not (ix1 < rx0 or ix > rx1 or iy1 < ry0 or iy > ry1):
                new_sel.add(item.path)

        if new_sel != self.selected_paths:
            self.selected_paths = new_sel
            self._update_selection_visuals()

    def _on_key_press(self, _widget: Gtk.Widget, event: Gdk.EventKey) -> bool:
        keyname = Gdk.keyval_name(event.keyval) or ""
        if keyname == "Return" and self.selected_paths:
            for item in self.items:
                if item.path in self.selected_paths:
                    self._open_item(item)
                    break
            return True
        if keyname == "Delete" and self.selected_paths:
            for path in list(self.selected_paths):
                self._move_to_trash(path)
            self.selected_paths.clear()
            self._populate_desktop_items()
            return True
        if keyname == "F5":
            self._populate_desktop_items()
            return True
        if keyname == "Escape":
            self.selected_paths.clear()
            self._update_selection_visuals()
            return True
        return False

    # ------------------------------------------------------------------
    # Akcje na elementach i pulpicie
    # ------------------------------------------------------------------
    def _open_item(self, item: DesktopItem) -> None:
        if item.is_desktop_file and item.exec_cmd:
            clean_cmd = []
            for part in item.exec_cmd.split():
                if not part.startswith("%"):
                    clean_cmd.append(part)
            if clean_cmd:
                try:
                    subprocess.Popen(clean_cmd, start_new_session=True)
                    return
                except Exception:
                    pass

        try:
            subprocess.Popen(["xdg-open", str(item.path)], start_new_session=True)
        except Exception:
            pass

    def _move_to_trash(self, path: Path) -> None:
        try:
            gfile = Gio.File.new_for_path(str(path))
            gfile.trash(None)
            return
        except Exception:
            pass
        try:
            trash_dir = Path.home() / ".local" / "share" / "Trash" / "files"
            trash_dir.mkdir(parents=True, exist_ok=True)
            shutil.move(str(path), str(trash_dir / path.name))
        except Exception:
            pass

    def _open_terminal_here(self, target_dir: Path) -> None:
        for term in ["foot", "kitty", "alacritty", "wezterm", "gnome-terminal", "xfce4-terminal"]:
            if shutil.which(term):
                try:
                    subprocess.Popen([term], cwd=str(target_dir), start_new_session=True)
                    return
                except Exception:
                    pass

    def _open_file_manager(self, target_dir: Path) -> None:
        for fm in ["thunar", "nemo", "nautilus", "dolphin", "pcmanfm", "xdg-open"]:
            if shutil.which(fm):
                try:
                    subprocess.Popen([fm, str(target_dir)], start_new_session=True)
                    return
                except Exception:
                    pass

    def _launch_settings(self) -> None:
        local_script = Path(__file__).resolve().parent / "okay-settings"
        for cmd in [str(local_script), "okay-settings"]:
            if shutil.which(cmd) or os.path.exists(cmd):
                try:
                    subprocess.Popen([cmd], start_new_session=True)
                    return
                except Exception:
                    pass

    # ------------------------------------------------------------------
    # Menu kontekstowe (Popover)
    # ------------------------------------------------------------------
    def _create_popover_at(self, x: float, y: float) -> Tuple[Gtk.Popover, Gtk.Box]:
        pop = Gtk.Popover.new(self.bg_area)
        rect = Gdk.Rectangle()
        rect.x = int(x)
        rect.y = int(y)
        rect.width = 2
        rect.height = 2
        pop.set_pointing_to(rect)
        pop.set_position(Gtk.PositionType.BOTTOM)
        pop.get_style_context().add_class("desktop-context-menu")

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        vbox.set_margin_top(6)
        vbox.set_margin_bottom(6)
        vbox.set_margin_start(6)
        vbox.set_margin_end(6)
        pop.add(vbox)
        return pop, vbox

    def _add_ctx_button(
        self,
        vbox: Gtk.Box,
        pop: Gtk.Popover,
        label: str,
        callback: Any,
        danger: bool = False,
    ) -> None:
        btn = Gtk.Button(label=label)
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.get_style_context().add_class("ctx-item")
        if danger:
            btn.get_style_context().add_class("ctx-item-danger")
        child = btn.get_child()
        if isinstance(child, Gtk.Label):
            child.set_xalign(0.0)
        btn.connect("clicked", lambda _b: (pop.popdown(), callback()))
        vbox.pack_start(btn, False, False, 0)

    def _add_ctx_sep(self, vbox: Gtk.Box) -> None:
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.get_style_context().add_class("ctx-sep")
        vbox.pack_start(sep, False, False, 2)

    def _show_desktop_context_menu(self, event: Gdk.EventButton) -> None:
        click_cell = self._pixel_to_cell(event.x, event.y)
        pop, vbox = self._create_popover_at(event.x, event.y)

        self._add_ctx_button(
            vbox, pop, "📁  Nowy folder...",
            lambda: self._prompt_create_item(is_folder=True, preferred_cell=click_cell)
        )
        self._add_ctx_button(
            vbox, pop, "📄  Nowy plik tekstowy...",
            lambda: self._prompt_create_item(is_folder=False, preferred_cell=click_cell)
        )
        self._add_ctx_sep(vbox)
        self._add_ctx_button(
            vbox, pop, "🔲  Uporządkuj ikony do siatki",
            self._auto_arrange_grid
        )
        self._add_ctx_button(
            vbox, pop, "🔄  Odśwież pulpit",
            self._populate_desktop_items
        )
        self._add_ctx_sep(vbox)
        self._add_ctx_button(
            vbox, pop, "💻  Otwórz terminal tutaj",
            lambda: self._open_terminal_here(self.desktop_dir)
        )
        self._add_ctx_button(
            vbox, pop, "🗂️  Otwórz menedżer plików",
            lambda: self._open_file_manager(self.desktop_dir)
        )
        self._add_ctx_sep(vbox)
        self._add_ctx_button(vbox, pop, "🖼️  Zmień tapetę...", self._choose_wallpaper_dialog)
        self._add_ctx_button(vbox, pop, "⚙️  Ustawienia systemowe (OKay)", self._launch_settings)

        vbox.show_all()
        pop.popup()

    def _show_item_context_menu(self, event: Gdk.EventButton, item: DesktopItem) -> None:
        win_origin = self.get_window().get_origin() if self.get_window() else (0, 0, 0)
        win_x = win_origin[1] if len(win_origin) == 3 else 0
        win_y = win_origin[2] if len(win_origin) == 3 else 0
        rel_x = event.x_root - win_x
        rel_y = event.y_root - win_y

        pop, vbox = self._create_popover_at(rel_x, rel_y)

        self._add_ctx_button(vbox, pop, "🚀  Otwórz", lambda: self._open_item(item))
        if item.is_dir:
            self._add_ctx_button(
                vbox, pop, "💻  Otwórz w terminalu", lambda: self._open_terminal_here(item.path)
            )
        self._add_ctx_button(
            vbox, pop, "✏️  Zmień nazwę...", lambda: self._prompt_rename_item(item)
        )
        self._add_ctx_button(
            vbox, pop, "📋  Kopiuj ścieżkę", lambda: self._copy_path_to_clipboard(item.path)
        )
        self._add_ctx_sep(vbox)
        self._add_ctx_button(
            vbox, pop, "🗑️  Przenieś do kosza", lambda: self._trash_and_refresh(item), danger=True
        )

        vbox.show_all()
        pop.popup()

    def _copy_path_to_clipboard(self, path: Path) -> None:
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        if cb:
            cb.set_text(str(path), -1)

    def _trash_and_refresh(self, item: DesktopItem) -> None:
        self._move_to_trash(item.path)
        self.selected_paths.discard(item.path)
        self._populate_desktop_items()

    # ------------------------------------------------------------------
    # Okna dialogowe (tworzenie folderu/pliku, zmiana nazwy, wybór tapety)
    # ------------------------------------------------------------------
    def _prompt_create_item(
        self,
        is_folder: bool,
        preferred_cell: Optional[Tuple[int, int]] = None,
    ) -> None:
        pop = Gtk.Popover.new(self.bg_area)
        alloc = self.get_allocation()
        rect = Gdk.Rectangle()
        rect.x = alloc.width // 2
        rect.y = alloc.height // 3
        rect.width = 2
        rect.height = 2
        pop.set_pointing_to(rect)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.get_style_context().add_class("dialog-box")

        title = Gtk.Label(label="Nowy folder" if is_folder else "Nowy plik tekstowy")
        title.get_style_context().add_class("dialog-title")
        title.set_xalign(0.0)
        box.pack_start(title, False, False, 0)

        entry = Gtk.Entry()
        entry.get_style_context().add_class("dialog-entry")
        entry.set_width_chars(28)
        entry.set_text("Nowy folder" if is_folder else "Notatka.txt")
        entry.select_region(0, -1)
        box.pack_start(entry, False, False, 0)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)

        cancel_btn = Gtk.Button(label="Anuluj")
        cancel_btn.get_style_context().add_class("dialog-btn")
        cancel_btn.connect("clicked", lambda _b: pop.popdown())

        ok_btn = Gtk.Button(label="Utwórz")
        ok_btn.get_style_context().add_class("dialog-btn")
        ok_btn.get_style_context().add_class("dialog-btn-primary")

        def do_create(*_args: Any) -> None:
            name = entry.get_text().strip()
            if not name or "/" in name:
                return
            target = self.desktop_dir / name
            try:
                if is_folder:
                    target.mkdir(parents=True, exist_ok=True)
                else:
                    if not target.exists():
                        target.write_text("", encoding="utf-8")
                if preferred_cell is not None:
                    self.grid_positions[name] = preferred_cell
            except Exception:
                pass
            pop.popdown()
            self._populate_desktop_items()

        ok_btn.connect("clicked", do_create)
        entry.connect("activate", do_create)

        btn_row.pack_start(cancel_btn, False, False, 0)
        btn_row.pack_start(ok_btn, False, False, 0)
        box.pack_start(btn_row, False, False, 0)

        pop.add(box)
        box.show_all()
        pop.popup()
        entry.grab_focus()

    def _prompt_rename_item(self, item: DesktopItem) -> None:
        pop = Gtk.Popover.new(self.bg_area)
        alloc = self.get_allocation()
        rect = Gdk.Rectangle()
        rect.x = alloc.width // 2
        rect.y = alloc.height // 3
        rect.width = 2
        rect.height = 2
        pop.set_pointing_to(rect)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.get_style_context().add_class("dialog-box")

        title = Gtk.Label(label=f"Zmień nazwę: {item.name}")
        title.get_style_context().add_class("dialog-title")
        title.set_xalign(0.0)
        box.pack_start(title, False, False, 0)

        entry = Gtk.Entry()
        entry.get_style_context().add_class("dialog-entry")
        entry.set_width_chars(28)
        entry.set_text(item.name)
        entry.select_region(0, -1)
        box.pack_start(entry, False, False, 0)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)

        cancel_btn = Gtk.Button(label="Anuluj")
        cancel_btn.get_style_context().add_class("dialog-btn")
        cancel_btn.connect("clicked", lambda _b: pop.popdown())

        ok_btn = Gtk.Button(label="Zapisz")
        ok_btn.get_style_context().add_class("dialog-btn")
        ok_btn.get_style_context().add_class("dialog-btn-primary")

        def do_rename(*_args: Any) -> None:
            new_name = entry.get_text().strip()
            if not new_name or "/" in new_name or new_name == item.name:
                pop.popdown()
                return
            new_path = item.path.parent / new_name
            try:
                old_pos = (item.col, item.row)
                item.path.rename(new_path)
                self.grid_positions.pop(item.name, None)
                self.grid_positions[new_name] = old_pos
            except Exception:
                pass
            pop.popdown()
            self._populate_desktop_items()

        ok_btn.connect("clicked", do_rename)
        entry.connect("activate", do_rename)

        btn_row.pack_start(cancel_btn, False, False, 0)
        btn_row.pack_start(ok_btn, False, False, 0)
        box.pack_start(btn_row, False, False, 0)

        pop.add(box)
        box.show_all()
        pop.popup()
        entry.grab_focus()

    def _choose_wallpaper_dialog(self) -> None:
        dlg = Gtk.FileChooserDialog(
            title="Wybierz tapetę pulpitu OKay-DE",
            parent=None,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons(
            "Anuluj", Gtk.ResponseType.CANCEL,
            "Ustaw tapetę", Gtk.ResponseType.ACCEPT,
        )
        flt = Gtk.FileFilter()
        flt.set_name("Obrazy (PNG, JPG, WEBP)")
        for pat in ("*.png", "*.jpg", "*.jpeg", "*.webp", "*.bmp"):
            flt.add_pattern(pat)
        dlg.add_filter(flt)

        pics = Path.home() / "Pictures"
        if pics.exists():
            dlg.set_current_folder(str(pics))

        resp = dlg.run()
        chosen = dlg.get_filename() if resp == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()

        if chosen and os.path.exists(chosen):
            self._save_wallpaper_to_config(chosen)
            self._load_wallpaper_from_config()

    def _save_wallpaper_to_config(self, wp_path: str) -> None:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        data: Dict[str, Any] = {}
        if PANEL_CONFIG_FILE.exists():
            try:
                data = json.loads(PANEL_CONFIG_FILE.read_text(encoding="utf-8"))
            except Exception:
                data = {}
        data["wallpaper"] = wp_path
        try:
            fd, tmp_path = tempfile.mkstemp(prefix=".panel_", dir=str(CONFIG_DIR), text=True)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4, ensure_ascii=False)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_path, PANEL_CONFIG_FILE)
        except Exception:
            pass

    # ------------------------------------------------------------------
    # Monitorowanie zmian na żywo (Gio.FileMonitor)
    # ------------------------------------------------------------------
    def _setup_monitors(self) -> None:
        self._monitors: List[Gio.FileMonitor] = []

        try:
            g_desk = Gio.File.new_for_path(str(self.desktop_dir))
            mon_desk = g_desk.monitor_directory(Gio.FileMonitorFlags.NONE, None)
            mon_desk.connect("changed", self._on_desktop_dir_changed)
            self._monitors.append(mon_desk)
        except Exception:
            pass

        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            g_cfg = Gio.File.new_for_path(str(PANEL_CONFIG_FILE))
            mon_cfg = g_cfg.monitor_file(Gio.FileMonitorFlags.NONE, None)
            mon_cfg.connect("changed", self._on_config_file_changed)
            self._monitors.append(mon_cfg)
        except Exception:
            pass

    def _on_desktop_dir_changed(
        self,
        _monitor: Gio.FileMonitor,
        _file: Gio.File,
        _other: Optional[Gio.File],
        event_type: Gio.FileMonitorEvent,
    ) -> None:
        if event_type in (
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.DELETED,
            Gio.FileMonitorEvent.MOVED_IN,
            Gio.FileMonitorEvent.MOVED_OUT,
            Gio.FileMonitorEvent.RENAMED,
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
        ):
            GLib.timeout_add(120, self._deferred_refresh_items)

    def _deferred_refresh_items(self) -> bool:
        self._populate_desktop_items()
        return False

    def _on_config_file_changed(
        self,
        _monitor: Gio.FileMonitor,
        _file: Gio.File,
        _other: Optional[Gio.File],
        event_type: Gio.FileMonitorEvent,
    ) -> None:
        if event_type in (
            Gio.FileMonitorEvent.CHANGED,
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
        ):
            GLib.timeout_add(80, self._deferred_reload_config)

    def _deferred_reload_config(self) -> bool:
        self._load_theme_and_css()
        self._load_wallpaper_from_config()
        return False


def _cleanup_old_desktop_instances() -> None:
    try:
        import ctypes
        try:
            libc = ctypes.CDLL("libc.so.6")
        except OSError:
            libc = ctypes.CDLL(None)
        libc.prctl(15, b"okay-desktop", 0, 0, 0)
    except Exception:
        pass

    my_pid = os.getpid()
    parent_pid = os.getppid()
    rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    pid_file = os.path.join(rt if os.path.isdir(rt) else "/tmp", "okay-desktop.pid")

    if os.path.exists(pid_file):
        try:
            with open(pid_file, "r", encoding="utf-8") as f:
                old_pid = int(f.read().strip())
            if old_pid not in (my_pid, parent_pid):
                os.kill(old_pid, 9)
        except Exception:
            pass

    try:
        res = subprocess.run(
            ["pgrep", "-x", "okay-desktop"],
            capture_output=True,
            text=True,
            check=False,
        )
        for line in res.stdout.strip().splitlines():
            try:
                pid = int(line.strip())
                if pid not in (my_pid, parent_pid):
                    os.kill(pid, 9)
            except Exception:
                pass
    except Exception:
        pass

    try:
        with open(pid_file, "w", encoding="utf-8") as f:
            f.write(str(my_pid))
    except Exception:
        pass


def main() -> None:
    if not os.environ.get("WAYLAND_DISPLAY"):
        rt = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        if os.path.isdir(rt):
            for name in sorted(os.listdir(rt)):
                if name.startswith("wayland-") and not name.endswith(".lock"):
                    os.environ.setdefault("XDG_RUNTIME_DIR", rt)
                    os.environ["WAYLAND_DISPLAY"] = name
                    break

    _cleanup_old_desktop_instances()
    win = OkayDesktopWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
