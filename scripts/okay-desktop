#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
OKay-DE Desktop Manager (scripts/okay-desktop)
==============================================
Kompletny menedżer pulpitu dla kompozytora Wayfire (wlroots):
- Renderuje tapetę na warstwie BACKGROUND (gtk-layer-shell)
- Wyświetla interaktywne ikony z katalogu ~/Desktop (lub ~/Pulpit)
- Siatka ikon (Snap-to-Grid): swobodne przeciąganie i upuszczanie ikon
  w dowolne miejsce siatki z trwałym zapisem pozycji w ~/.config/okay-de/desktop_grid.json
- Natychmiastowa adaptacja do motywu Ciemnego / Jasnego oraz koloru akcentu
- Czysta typografia bez sztucznej obramówki wokół czcionki (text-shadow: none)
- Obsługuje zaznaczanie prostokątem (rubberband) na pustym obszarze
- Menu kontekstowe (PPM na pulpicie oraz PPM na ikonie)
- Monitoruje zmiany w katalogu pulpitu oraz w konfiguracji ~/.config/okay-de/panel.json
"""

import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gio", "2.0")
gi.require_version("Pango", "1.0")
try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell
    HAS_LAYER_SHELL = True
except (ValueError, ImportError):
    HAS_LAYER_SHELL = False

from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango


CONFIG_DIR = Path.home() / ".config" / "okay-de"
PANEL_CONFIG_FILE = CONFIG_DIR / "panel.json"
GRID_CONFIG_FILE = CONFIG_DIR / "desktop_grid.json"

FALLBACK_WALLPAPERS = [
    CONFIG_DIR / "wallpaper",
    CONFIG_DIR / "wallpaper.png",
    Path.home() / ".local" / "share" / "okay-de" / "defaults" / "backgrounds" / "default.png",
    Path("/usr/share/backgrounds/okay-de/default.png"),
    Path("/usr/share/okay-de/defaults/backgrounds/default.png"),
    Path("/usr/share/backgrounds/default.png"),
]

# Wymiary siatki pulpitu (Snap-to-Grid)
GRID_MARGIN_X = 20
GRID_MARGIN_Y = 20
CELL_W = 104
CELL_H = 108
ICON_BOX_W = 96
ICON_BOX_H = 100
DRAG_THRESHOLD = 6.0


def get_desktop_dir() -> Path:
    """Zwraca ścieżkę do katalogu Pulpitu użytkownika (zgodnie z XDG)."""
    try:
        xdg_path = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP)
        if xdg_path:
            p = Path(xdg_path)
            if p.exists():
                return p
    except Exception:
        pass

    for candidate in [Path.home() / "Desktop", Path.home() / "Pulpit"]:
        if candidate.exists():
            return candidate

    default_desktop = Path.home() / "Desktop"
    default_desktop.mkdir(parents=True, exist_ok=True)
    return default_desktop


def hex_to_rgb_float(hex_str: str, fallback: Tuple[float, float, float] = (0.796, 0.651, 0.969)) -> Tuple[float, float, float]:
    s = str(hex_str or "").strip().lstrip("#")
    if len(s) != 6:
        return fallback
    try:
        r = int(s[0:2], 16) / 255.0
        g = int(s[2:4], 16) / 255.0
        b = int(s[4:6], 16) / 255.0
        return (r, g, b)
    except ValueError:
        return fallback


def build_desktop_css(theme_mode: str = "dark", accent: str = "#cba6f7") -> str:
    is_dark = (theme_mode != "light")
    r, g, b = [int(c * 255) for c in hex_to_rgb_float(accent)]

    if is_dark:
        label_fg = "#f2f4ff"
        label_bg = "rgba(24, 24, 37, 0.72)"
        hover_bg = "rgba(255, 255, 255, 0.10)"
        hover_border = "rgba(255, 255, 255, 0.18)"
        menu_bg = "rgba(30, 30, 46, 0.96)"
        menu_fg = "#cdd6f4"
        menu_border = f"rgba({r}, {g}, {b}, 0.38)"
        sep_col = "rgba(255, 255, 255, 0.08)"
        entry_bg = "rgba(17, 17, 27, 0.92)"
        btn_bg = "rgba(69, 71, 90, 0.65)"
        sel_text_fg = "#11111b"
    else:
        label_fg = "#1e1e2e"
        label_bg = "rgba(239, 241, 245, 0.86)"
        hover_bg = "rgba(0, 0, 0, 0.08)"
        hover_border = "rgba(0, 0, 0, 0.16)"
        menu_bg = "rgba(239, 241, 245, 0.97)"
        menu_fg = "#4c4f69"
        menu_border = f"rgba({r}, {g}, {b}, 0.45)"
        sep_col = "rgba(0, 0, 0, 0.10)"
        entry_bg = "rgba(255, 255, 255, 0.95)"
        btn_bg = "rgba(204, 208, 218, 0.75)"
        sel_text_fg = "#ffffff"

    return f"""
* {{
    font-family: "Inter", "Cantarell", "Noto Sans", system-ui, sans-serif;
    text-shadow: none;
    -gtk-icon-shadow: none;
}}

window.desktop-window {{
    background-color: #11111b;
}}

.desktop-item {{
    background-color: transparent;
    border-radius: 12px;
    padding: 6px 4px;
    border: 1.5px solid transparent;
    transition: background-color 120ms ease, border-color 120ms ease;
}}

.desktop-item:hover {{
    background-color: {hover_bg};
    border-color: {hover_border};
}}

.desktop-item-selected {{
    background-color: rgba({r}, {g}, {b}, 0.28);
    border-color: rgba({r}, {g}, {b}, 0.85);
}}

.desktop-item-dragging {{
    background-color: rgba({r}, {g}, {b}, 0.38);
    border-color: {accent};
    opacity: 0.92;
}}

.desktop-label {{
    color: {label_fg};
    background-color: {label_bg};
