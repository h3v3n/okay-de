#!/usr/bin/env bash

# OKay DE - Sterowanie jasnością matrycy z powiadomieniem OSD
set -euo pipefail

ACTION="${1:-up}"

if ! command -v brightnessctl >/dev/null 2>&1; then
    exit 0
fi

case "$ACTION" in
    up)
        brightnessctl set +5% -q 2>/dev/null || exit 0
        ;;
    down)
        brightnessctl set 5%- -q 2>/dev/null || exit 0
        ;;
    *)
        echo "Użycie: $0 {up|down}" >&2
        exit 1
        ;;
esac

CURR=$(brightnessctl get 2>/dev/null || echo 0)
MAX=$(brightnessctl max 2>/dev/null || echo 0)

if [ "${MAX:-0}" -gt 0 ]; then
    PCT=$(( CURR * 100 / MAX ))
else
    PCT=100
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send -h string:x-canonical-private-synchronous:osd \
                -h int:value:"$PCT" \
                -u low -t 1500 "Jasność ekranu: ${PCT}%" "Matryca"
fi
