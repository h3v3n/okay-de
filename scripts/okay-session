#!/bin/sh

# OKay DE - Główny skrypt startowy sesji środowiska graficznego
export XDG_CURRENT_DESKTOP=OKay:labwc
export XDG_SESSION_DESKTOP=OKay
export XDG_SESSION_TYPE=wayland

# Spójność kursorów na całym pulpicie Wayland
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Integracja zestawów narzędzi (toolkitów) z Wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11,*"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# Wymuszenie architektury Server-Side Decorations (SSD) - wyłączenie CSD w aplikacjach
export GTK_CSD=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=0
export QT_QPA_PLATFORMTHEME="qt6ct"

# Inicjalizacja standardowych katalogów użytkownika XDG oraz pulpitu
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update
mkdir -p "$HOME/Desktop"

# Uruchomienie kompozytora labwc
exec labwc
