#!/usr/bin/env bash
# =============================================================================
# OKay DE — Skrypt inicjalizujący sesję Wayland (kompozytor Wayfire)
# Wstrzykuje zmienne środowiskowe wymuszające SSD (GTK_CSD=0, Qt, Mozilla),
# konfiguruje xdg-desktop-portal oraz synchronizuje sandbox Flatpaka.
# =============================================================================

# Ścieżka do skryptów użytkownika lub systemowych
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="${HOME}/.local/bin:${SCRIPT_DIR}:${PATH}"

# Standardowe katalogi XDG
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# Identyfikacja sesji Wayland dla XDG Portals, systemd i aplikacji
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="OKay"
export XDG_CURRENT_DESKTOP="OKay:wayfire"
export DESKTOP_SESSION="okay"

# Wymuszenie dekoracji po stronie serwera (SSD) dla GTK3/GTK4 oraz wyłączenie paska CSD GNOME
export GTK_CSD=0
export GDK_BACKEND="wayland,x11"

# Natywne wsparcie Wayland dla Qt5/Qt6, przeglądarek (Firefox/Chromium/Electron) oraz SDL/Java
export QT_QPA_PLATFORM="wayland;xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORMTHEME="qt6ct"
export MOZ_ENABLE_WAYLAND=1
export MOZ_GTK_TITLEBAR_DECORATION="system"
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export NIXOS_OZONE_WL=1
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
export _JAVA_AWT_WM_NONREPARENTING=1

# Domyślny motyw kursora
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# -----------------------------------------------------------------------------
# Pierwsze uruchomienie — kopiowanie domyślnych plików konfiguracyjnych
# -----------------------------------------------------------------------------
SYS_SHARE="/usr/share/okay-de/config"
REPO_CONF="$(cd "${SCRIPT_DIR}/../config" 2>/dev/null && pwd || true)"

copy_if_missing() {
    local rel_src="$1"
    local dst="$2"
    if [ ! -f "$dst" ]; then
        mkdir -p "$(dirname "$dst")"
        if [ -f "${SYS_SHARE}/${rel_src}" ]; then
            cp -f "${SYS_SHARE}/${rel_src}" "$dst"
        elif [ -n "$REPO_CONF" ] && [ -f "${REPO_CONF}/${rel_src}" ]; then
            cp -f "${REPO_CONF}/${rel_src}" "$dst"
        fi
    fi
}

copy_if_missing "wayfire/wayfire.ini" "$XDG_CONFIG_HOME/wayfire.ini"
copy_if_missing "okay-de/autostart"   "$XDG_CONFIG_HOME/okay-de/autostart"
copy_if_missing "okay-de/panel.json"  "$XDG_CONFIG_HOME/okay-de/panel.json"
copy_if_missing "mako/config"         "$XDG_CONFIG_HOME/mako/config"
copy_if_missing "rofi/config.rasi"    "$XDG_CONFIG_HOME/rofi/config.rasi"
copy_if_missing "gtk-3.0/settings.ini" "$XDG_CONFIG_HOME/gtk-3.0/settings.ini"
copy_if_missing "gtk-4.0/settings.ini" "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"

chmod +x "$XDG_CONFIG_HOME/okay-de/autostart" 2>/dev/null || true

# -----------------------------------------------------------------------------
# Konfiguracja xdg-desktop-portal (wlr dla ekranu/zrzutów + gtk dla motywów/okien dialogowych)
# -----------------------------------------------------------------------------
PORTAL_DIR="$XDG_CONFIG_HOME/xdg-desktop-portal"
mkdir -p "$PORTAL_DIR"
cat > "$PORTAL_DIR/okay-portals.conf" << 'EOF'
[preferred]
default=gtk
org.freedesktop.impl.portal.ScreenCast=wlr
org.freedesktop.impl.portal.Screenshot=wlr
org.freedesktop.impl.portal.Settings=gtk
org.freedesktop.impl.portal.FileChooser=gtk
EOF
cp -f "$PORTAL_DIR/okay-portals.conf" "$PORTAL_DIR/portals.conf" 2>/dev/null || true

# -----------------------------------------------------------------------------
# Wymuszenie pełnych przycisków (minimalizuj, maksymalizuj, zamknij) w plikach GTK
# -----------------------------------------------------------------------------
for gtk_ver in gtk-3.0 gtk-4.0; do
    ini_file="$XDG_CONFIG_HOME/$gtk_ver/settings.ini"
    if [ -f "$ini_file" ]; then
        if grep -q '^gtk-decoration-layout' "$ini_file"; then
            sed -i 's|^gtk-decoration-layout.*|gtk-decoration-layout = :minimize,maximize,close|' "$ini_file"
        else
            echo "gtk-decoration-layout = :minimize,maximize,close" >> "$ini_file"
        fi
    fi
done

# -----------------------------------------------------------------------------
# Automatyczna synchronizacja sandboxa Flatpak z motywami i konfiguracją OKay DE
# -----------------------------------------------------------------------------
if command -v flatpak >/dev/null 2>&1; then
    (
        flatpak override --user \
            --filesystem=xdg-config/gtk-3.0:ro \
            --filesystem=xdg-config/gtk-4.0:ro \
            --filesystem=xdg-config/okay-de:ro \
            --env=GTK_CSD=0 \
            --env=XCURSOR_THEME="${XCURSOR_THEME}" \
            --env=XCURSOR_SIZE="${XCURSOR_SIZE}" >/dev/null 2>&1 || true
    ) &
fi

# Weryfikacja obecności kompozytora Wayfire
if ! command -v wayfire >/dev/null 2>&1; then
    echo "BŁĄD KRYTYCZNY: Nie znaleziono kompozytora 'wayfire' w zmiennej PATH!" >&2
    exit 1
fi

# Start magistrali D-Bus (jeśli nie została uruchomiona przez Display Manager / systemd-logind)
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- wayfire -c "$XDG_CONFIG_HOME/wayfire.ini"
else
    exec wayfire -c "$XDG_CONFIG_HOME/wayfire.ini"
fi
