#!/bin/sh

# OKay DE - Główny skrypt startowy sesji środowiska graficznego (Wayfire)
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
export XDG_CURRENT_DESKTOP=OKay:wayfire
export XDG_SESSION_DESKTOP=OKay
export XDG_SESSION_TYPE=wayland

# Optymalizacja zużycia pamięci RAM w całej sesji (ograniczenie aren glibc i mostu AT-SPI)
export MALLOC_ARENA_MAX=2
export NO_AT_BRIDGE=1

# Spójność kursorów na całym pulpicie Wayland
# WLR_NO_HARDWARE_CURSORS=1 zapobiega niewidocznemu kursorowi na maszynach wirtualnych i kartach GPU
export WLR_NO_HARDWARE_CURSORS=1
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Integracja zestawów narzędzi (toolkitów) z Wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11,*"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# Wymuszenie architektury Server-Side Decorations (SSD) oraz integracja Qt6/GTK
export GTK_CSD=0
export GTK_THEME=Adwaita-dark
export GTK_USE_PORTAL=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=0
export QT_QPA_PLATFORMTHEME="qt6ct"

# Aktualizacja środowiska D-Bus dla usług systemd i portali (eliminuje 25-sekundowe opóźnienia)
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
fi

# Inicjalizacja standardowych katalogów użytkownika XDG oraz pulpitu
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update
mkdir -p "$HOME/Desktop"

# Inicjalizacja domyślnej konfiguracji ~/.config/wayfire.ini oraz ~/.config/okay-de/* z szablonów (jeśli brak)
XDG_CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
WF_INI="$XDG_CFG/wayfire.ini"
OKAY_CFG="$XDG_CFG/okay-de"
mkdir -p "$OKAY_CFG"

if [ ! -f "$WF_INI" ]; then
    for cand in \
        "$XDG_DATA/okay-de/defaults/wayfire/wayfire.ini" \
        "/usr/share/okay-de/defaults/wayfire/wayfire.ini" \
        "/etc/xdg/okay-de/wayfire.ini" \
        "/etc/xdg/wayfire.ini"; do
        if [ -f "$cand" ]; then
            mkdir -p "$(dirname "$WF_INI")"
            cp "$cand" "$WF_INI" 2>/dev/null || true
            break
        fi
    done
fi

if [ ! -f "$OKAY_CFG/autostart" ]; then
    for cand in \
        "$XDG_DATA/okay-de/defaults/okay-de/autostart" \
        "/usr/share/okay-de/defaults/okay-de/autostart" \
        "/etc/xdg/okay-de/autostart" \
        "/etc/okay-de/autostart"; do
        if [ -f "$cand" ]; then
            cp "$cand" "$OKAY_CFG/autostart" 2>/dev/null || true
            break
        fi
    done
fi

if [ ! -f "$OKAY_CFG/panel.json" ]; then
    for cand in \
        "$XDG_DATA/okay-de/defaults/okay-de/panel.json" \
        "/usr/share/okay-de/defaults/okay-de/panel.json" \
        "/etc/xdg/okay-de/panel.json" \
        "/etc/okay-de/panel.json"; do
        if [ -f "$cand" ]; then
            cp "$cand" "$OKAY_CFG/panel.json" 2>/dev/null || true
            break
        fi
    done
fi

# Ścieżki wtyczek i metadanych Wayfire (obsługa pixdecor w katalogu użytkownika i systemowym)
XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
export WAYFIRE_PLUGIN_PATH="${XDG_DATA}/wayfire/plugins:/usr/lib/wayfire:/usr/local/lib/wayfire${WAYFIRE_PLUGIN_PATH:+:$WAYFIRE_PLUGIN_PATH}"
export WAYFIRE_PLUGIN_XML_PATH="${XDG_DATA}/wayfire/metadata:/usr/share/wayfire/metadata:/usr/local/share/wayfire/metadata${WAYFIRE_PLUGIN_XML_PATH:+:$WAYFIRE_PLUGIN_XML_PATH}"

# Jeśli dostępny jest plugin pixdecor, automatycznie aktywuj go zamiast decoration
if [ -f "$WF_INI" ] && { [ -f "$XDG_DATA/wayfire/plugins/libpixdecor.so" ] || [ -f /usr/lib/wayfire/libpixdecor.so ] || [ -f /usr/local/lib/wayfire/libpixdecor.so ]; }; then
    if grep -qE '^plugins\s*=.*\bdecoration\b' "$WF_INI" 2>/dev/null && ! grep -qE '^plugins\s*=.*\bpixdecor\b' "$WF_INI" 2>/dev/null; then
        sed -i -E 's/(^plugins\s*=.*)\bdecoration\b/\1pixdecor/' "$WF_INI" 2>/dev/null || true
    fi
elif [ -f "$WF_INI" ] && grep -qE '^plugins\s*=.*\bpixdecor\b' "$WF_INI" 2>/dev/null; then
    sed -i -E 's/(^plugins\s*=.*)\bpixdecor\b/\1decoration/' "$WF_INI" 2>/dev/null || true
fi

# Zapewnienie uprawnień wykonywalności dla autostartu
[ -f "$OKAY_CFG/autostart" ] && chmod +x "$OKAY_CFG/autostart" 2>/dev/null || true
[ -f "/etc/xdg/okay-de/autostart" ] && chmod +x "/etc/xdg/okay-de/autostart" 2>/dev/null || true

# Uruchomienie kompozytora Wayfire
if command -v wayfire >/dev/null 2>&1; then
    exec wayfire
fi

echo "OKay DE: Błąd krytyczny — nie znaleziono kompozytora 'wayfire'. Zainstaluj pakiet: sudo pacman -S wayfire" >&2
exit 1
