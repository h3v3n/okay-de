# ============================================================================
# Menu Start a'la KDE Kickoff
# ============================================================================

class KickoffMenu(QWidget):
    """Eleganckie menu programów a'la KDE Plasma Kickoff z wyszukiwarką."""

    def __init__(self, parent=None):
        super().__init__(parent, Qt.WindowType.Popup | Qt.WindowType.FramelessWindowHint)
        self.setObjectName("kickoffWindow")
        self.setFixedSize(400, 480)

        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(14, 14, 14, 14)
        main_layout.setSpacing(10)

        # 1. Pasek wyszukiwania
        self.search_bar = QLineEdit()
        self.search_bar.setObjectName("kickoffSearch")
        self.search_bar.setPlaceholderText("Wyszukaj aplikację...")
        self.search_bar.textChanged.connect(self._filter_apps)
        main_layout.addWidget(self.search_bar)

        # 2. Lista aplikacji
        self.list_widget = QListWidget()
        self.list_widget.setObjectName("kickoffList")
        self.list_widget.setIconSize(QSize(28, 28))
        self.list_widget.itemActivated.connect(self._launch_app)
        main_layout.addWidget(self.list_widget)

        # 3. Dolny pasek szybkiego dostępu (Ustawienia, Blokada, Zasilanie)
        bottom_bar = QHBoxLayout()
        bottom_bar.setContentsMargins(0, 4, 0, 0)
        bottom_bar.setSpacing(8)

        btn_settings = QPushButton("Ustawienia")
        btn_settings.setProperty("class", "dock-btn")
        btn_settings.setIcon(IconHelper.get_icon("settings", "settings"))
        btn_settings.clicked.connect(lambda: self._exec_and_close(["okay-settings"]))
        bottom_bar.addWidget(btn_settings)

        btn_lock = QPushButton("Zablokuj")
        btn_lock.setProperty("class", "dock-btn")
        btn_lock.setIcon(IconHelper.get_icon("lock", "lock"))
        btn_lock.clicked.connect(lambda: self._exec_and_close(["okay-lock"]))
        bottom_bar.addWidget(btn_lock)

        btn_power = QPushButton("Zasilanie")
        btn_power.setProperty("class", "dock-btn")
        btn_power.setIcon(IconHelper.get_icon("power", "power"))
        btn_power.clicked.connect(lambda: self._exec_and_close(["okay-powermenu"]))
        bottom_bar.addWidget(btn_power)

        main_layout.addLayout(bottom_bar)

        self.all_apps = []
        self._load_apps()

    def _load_apps(self):
        """Ładuje aplikacje ze standardowych plików .desktop."""
        self.all_apps = [
            {"name": "Terminal (foot)", "cmd": "foot", "icon": "foot", "desc": "Szybki emulator terminala Wayland"},
            {"name": "Menedżer plików (pcmanfm)", "cmd": "pcmanfm", "icon": "pcmanfm", "desc": "Zarządzanie plikami i katalogami"},
            {"name": "Ustawienia OKay", "cmd": "okay-settings", "icon": "okay-settings", "desc": "Centrum sterowania OKay DE"},
            {"name": "Wyszukiwarka (fuzzel)", "cmd": "fuzzel", "icon": "fuzzel", "desc": "Szybki launcher aplikacji"},
            {"name": "Historia schowka", "cmd": "okay-clipboard", "icon": "clipboard", "desc": "Menedżer historii schowka"},
            {"name": "Zrzut ekranu", "cmd": "okay-screenshot", "icon": "fuzzel", "desc": "Przechwytywanie ekranu"},
        ]

        # Skanowanie /usr/share/applications/ dla popularnych programów (np. firefox)
        if os.path.exists("/usr/share/applications/firefox.desktop") or shutil.which("firefox"):
            self.all_apps.append({"name": "Przeglądarka Firefox", "cmd": "firefox", "icon": "firefox", "desc": "Przeglądarka internetowa"})

        self._populate_list(self.all_apps)

    def _populate_list(self, apps: list):
        self.list_widget.clear()
        for app in apps:
            item = QListWidgetItem()
            item.setText(f"{app['name']}\n{app.get('desc', '')}")
            item.setIcon(IconHelper.get_icon(app.get("icon", "app"), app.get("icon", "app")))
            item.setData(Qt.ItemDataRole.UserRole, app["cmd"])
            self.list_widget.addItem(item)

    def _filter_apps(self, text: str):
        query = text.strip().lower()
        if not query:
            self._populate_list(self.all_apps)
            return
        filtered = [
            app for app in self.all_apps
            if query in app["name"].lower() or query in app.get("desc", "").lower() or query in app["cmd"].lower()
        ]
        self._populate_list(filtered)

    def _launch_app(self, item: QListWidgetItem):
        cmd = item.data(Qt.ItemDataRole.UserRole)
        if cmd:
            subprocess.Popen([cmd], shell=True)
            self.close()

    def _exec_and_close(self, args: list):
        subprocess.Popen(args)
        self.close()

    def show_above(self, target_pos: QPoint):
        self.search_bar.clear()
        self._populate_list(self.all_apps)
        x = max(0, target_pos.x())
        y = max(0, target_pos.y() - self.height() - 6)
        self.move(x, y)
        self.show()
        self.raise_()
        self.activateWindow()
        self.search_bar.setFocus()


# ============================================================================
# Przyciski Aplikacji i Aplety Tacki Systemowej
# ============================================================================

class TaskButton(QPushButton):
    """Przycisk zadania z prawdziwą ikoną graficzną a'la KDE Plasma."""

    def __init__(self, app_id: str, app_info: dict, parent=None):
        super().__init__(parent)
        self.app_id = app_id
        self.app_info = app_info
        self.setProperty("class", "dock-btn task-btn")
        self.setIconSize(QSize(24, 24))
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setToolTip(app_info.get("name", app_id))

        icon_name = app_info.get("icon_name") or app_info.get("cmd") or app_id
        self.setIcon(IconHelper.get_icon(icon_name, app_id))
        self.clicked.connect(self._launch)

    def _launch(self):
        cmd = self.app_info.get("cmd", self.app_id)
        if cmd:
            subprocess.Popen([cmd], shell=True)


class VolumeApplet(QPushButton):
    """Zaawansowany aplet głośności a'la KDE Plasma z kółkiem myszy i stanami."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("volApplet")
        self.setProperty("class", "dock-btn")
        self.setIconSize(QSize(20, 20))
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setToolTip("Głośność\nLewy klik: Wycisz\nPrawy klik: Mikser dźwięku (pavucontrol)\nKółko myszy: Regulacja")
        self.update_volume()

    def update_volume(self):
        vol, muted = self._get_volume()
        if muted or vol == 0:
            self.setIcon(IconHelper.get_icon("volume-muted", "volume-muted"))
            self.setText("Wycisz")
        else:
            if vol >= 66:
                self.setIcon(IconHelper.get_icon("volume-high", "volume-high"))
            elif vol >= 33:
                self.setIcon(IconHelper.get_icon("volume-med", "volume-med"))
            else:
                self.setIcon(IconHelper.get_icon("volume-low", "volume-low"))
            self.setText(f"{vol}%")

    def _get_volume(self):
        if not shutil.which("wpctl"):
            return 100, False
        try:
            res = subprocess.run(
                ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                capture_output=True,
                text=True,
                timeout=0.6,
                check=False
            )
            if res.returncode != 0 or not res.stdout.strip():
                return 100, False
            out = res.stdout.strip()
            muted = "[MUTED]" in out
            parts = out.split()
            vol = 100
            for p in parts:
                try:
                    vol = int(float(p) * 100)
                    break
                except ValueError:
                    continue
            return vol, muted
        except Exception:
            return 100, False

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            subprocess.run(["okay-volume", "mute"], check=False)
            self.update_volume()
        elif event.button() == Qt.MouseButton.RightButton:
            if shutil.which("pavucontrol"):
                subprocess.Popen(["pavucontrol"])
        else:
            super().mousePressEvent(event)

    def wheelEvent(self, event: QWheelEvent):
        delta = event.angleDelta().y()
        if delta > 0:
            subprocess.run(["okay-volume", "raise"], check=False)
        elif delta < 0:
            subprocess.run(["okay-volume", "lower"], check=False)
        self.update_volume()
        event.accept()


# ============================================================================
# Główny Pasek Zadań (Taskbar a'la KDE Plasma)
# ============================================================================

class OkayDock(QWidget):
    """Natywny pasek zadań OKay DE inspirowany KDE Plasma."""

    CONFIG_FILE = os.path.expanduser("~/.config/okay-de/pinned_apps.json")

    DEFAULT_PINNED_APPS = {
        "foot": {"name": "Terminal (foot)", "icon_name": "utilities-terminal", "cmd": "foot", "enabled": True},
        "pcmanfm": {"name": "Menedżer plików (pcmanfm)", "icon_name": "system-file-manager", "cmd": "pcmanfm", "enabled": True},
        "settings": {"name": "Ustawienia OKay", "icon_name": "preferences-system", "cmd": "okay-settings", "enabled": True},
        "firefox": {"name": "Przeglądarka internetowa (firefox)", "icon_name": "firefox", "cmd": "firefox", "enabled": True}
    }

    def __init__(self):
        super().__init__()
        self.setObjectName("dockWindow")
        self.setWindowTitle("okay-dock")

        # Flagi okna dla stabilnej pracy na Wayland i XWayland
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint |
            Qt.WindowType.WindowStaysOnTopHint
        )

        self._init_ui()
        self._setup_watcher()
        self._setup_timers()

        # Kickoff Menu
        self.kickoff_menu = KickoffMenu()

        # Reakcja na zmianę rozdzielczości ekranu oraz synchronizacja po starcie sesji
        screen = QApplication.primaryScreen()
        if screen:
            screen.geometryChanged.connect(lambda _g: self.reposition())

        QTimer.singleShot(200, self.reposition)
        QTimer.singleShot(800, self.reposition)
        QTimer.singleShot(2000, self.reposition)

    def showEvent(self, event):
        super().showEvent(event)
        self.reposition()

    def _init_ui(self):
        root_layout = QHBoxLayout(self)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(0)

        self.container = QFrame()
        self.container.setObjectName("dockContainer")
        self.layout_dock = QHBoxLayout(self.container)
        self.layout_dock.setContentsMargins(6, 0, 0, 0)
        self.layout_dock.setSpacing(4)

        # 1. Przycisk Menu Start a'la KDE Plasma
        self.btn_start = QPushButton(" Menu")
        self.btn_start.setObjectName("startBtn")
        self.btn_start.setIcon(IconHelper.get_icon("start", "start"))
        self.btn_start.setIconSize(QSize(22, 22))
        self.btn_start.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_start.setToolTip("Menu programów OKay DE (KDE Kickoff)")
        self.btn_start.clicked.connect(self._toggle_kickoff)
        self.layout_dock.addWidget(self.btn_start)

        # Separator 1
        sep1 = QFrame()
        sep1.setProperty("class", "dock-sep")
        sep1.setFrameShape(QFrame.Shape.VLine)
        self.layout_dock.addWidget(sep1)

        # 2. Kontener paska zadań (przypięte aplikacje i aktywne zadania)
        self.tasks_widget = QWidget()
        self.layout_tasks = QHBoxLayout(self.tasks_widget)
        self.layout_tasks.setContentsMargins(0, 0, 0, 0)
        self.layout_tasks.setSpacing(4)
        self.layout_dock.addWidget(self.tasks_widget)

        self._reload_tasks()

        # 3. Przestrzeń elastyczna
        self.layout_dock.addSpacerItem(QSpacerItem(0, 0, QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Minimum))

        # 4. Tacka systemowa (System Tray)
        # Schowek
        self.btn_clipboard = QPushButton()
        self.btn_clipboard.setProperty("class", "dock-btn")
        self.btn_clipboard.setIcon(IconHelper.get_icon("clipboard", "clipboard"))
        self.btn_clipboard.setIconSize(QSize(18, 18))
        self.btn_clipboard.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_clipboard.setToolTip("Historia schowka (okay-clipboard)")
        self.btn_clipboard.clicked.connect(lambda: subprocess.Popen(["okay-clipboard"]))
        self.layout_dock.addWidget(self.btn_clipboard)

        # Głośność
        self.btn_volume = VolumeApplet()
        self.layout_dock.addWidget(self.btn_volume)

        # Separator 2
        sep2 = QFrame()
        sep2.setProperty("class", "dock-sep")
        sep2.setFrameShape(QFrame.Shape.VLine)
        self.layout_dock.addWidget(sep2)

        # Zegar cyfrowy KDE Plasma (czas + data w dwóch wierszach)
        self.clock_widget = QWidget()
        self.clock_layout = QVBoxLayout(self.clock_widget)
        self.clock_layout.setContentsMargins(6, 4, 6, 4)
        self.clock_layout.setSpacing(0)
        self.clock_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.lbl_time = QLabel()
        self.lbl_time.setObjectName("clockTime")
        self.lbl_time.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.lbl_date = QLabel()
        self.lbl_date.setObjectName("clockDate")
        self.lbl_date.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.clock_layout.addWidget(self.lbl_time)
        self.clock_layout.addWidget(self.lbl_date)
        self.clock_widget.setCursor(Qt.CursorShape.PointingHandCursor)
        self.clock_widget.mousePressEvent = lambda _e: self._show_calendar_info()
        self._update_clock()
        self.layout_dock.addWidget(self.clock_widget)

        # 5. Przycisk 'Pokaż Pulpit' (wąski pasek po prawej a'la KDE / Windows)
        self.btn_show_desktop = QPushButton()
        self.btn_show_desktop.setObjectName("showDesktopBtn")
        self.btn_show_desktop.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_show_desktop.setToolTip("Pokaż Pulpit")
        self.btn_show_desktop.clicked.connect(lambda: subprocess.Popen(["pcmanfm", os.path.expanduser("~/Desktop")]))
        self.layout_dock.addWidget(self.btn_show_desktop)

        root_layout.addWidget(self.container)

    def _setup_timers(self):
        self.timer_clock = QTimer(self)
        self.timer_clock.timeout.connect(self._update_clock)
        self.timer_clock.start(1000)

        self.timer_vol = QTimer(self)
        self.timer_vol.timeout.connect(self.btn_volume.update_volume)
        self.timer_vol.start(3000)

    def _setup_watcher(self):
        os.makedirs(os.path.dirname(self.CONFIG_FILE), exist_ok=True)
        self.watcher = QFileSystemWatcher(self)
        if os.path.exists(self.CONFIG_FILE):
            self.watcher.addPath(self.CONFIG_FILE)
        self.watcher.fileChanged.connect(lambda _p: self._reload_tasks())

    def _get_pinned_apps(self) -> dict:
        if not os.path.exists(self.CONFIG_FILE):
            try:
                with open(self.CONFIG_FILE, "w", encoding="utf-8") as f:
                    json.dump(self.DEFAULT_PINNED_APPS, f, indent=2, ensure_ascii=False)
            except Exception:
                pass
            return self.DEFAULT_PINNED_APPS.copy()

        try:
            with open(self.CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data if isinstance(data, dict) else self.DEFAULT_PINNED_APPS.copy()
        except Exception:
            return self.DEFAULT_PINNED_APPS.copy()

    def _reload_tasks(self):
        while self.layout_tasks.count() > 0:
            item = self.layout_tasks.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()

        apps = self._get_pinned_apps()
        for app_id, app_info in apps.items():
            if app_info.get("enabled", False):
                btn = TaskButton(app_id, app_info)
                self.layout_tasks.addWidget(btn)

    def _update_clock(self):
        now = QDateTime.currentDateTime()
        self.lbl_time.setText(now.toString("HH:mm"))
        self.lbl_date.setText(now.toString("ddd, d MMM"))
        self.clock_widget.setToolTip(now.toString("dddd, d MMMM yyyy\nGodzina: HH:mm:ss"))

    def _show_calendar_info(self):
        now = QDateTime.currentDateTime()
        date_str = now.toString("dddd, d MMMM yyyy")
        if shutil.which("notify-send"):
            subprocess.Popen([
                "notify-send",
                "Kalendarz OKay",
                f"Dzisiaj jest: {date_str}",
                "-u", "low"
            ])

    def _toggle_kickoff(self):
        if self.kickoff_menu.isVisible():
            self.kickoff_menu.close()
        else:
            pos = self.btn_start.mapToGlobal(QPoint(0, 0))
            self.kickoff_menu.show_above(pos)

    def reposition(self):
        screen = QApplication.primaryScreen()
        h = 44
        w = 1280
        x = 0
        y = 760
        if screen:
            geom = screen.geometry()
            if geom.width() >= 400:
                w = geom.width()
            if geom.height() >= 300:
                y = geom.y() + geom.height() - h
            x = geom.x()
        self.setGeometry(x, y, w, h)
        self.setFixedHeight(h)
        self.setMinimumWidth(w)


def main():
    os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")
    app = QApplication(sys.argv)
    app.setApplicationName("okay-dock")
    app.setDesktopFileName("okay-dock")
    app.setStyleSheet(DOCK_QSS)

    # Ustawienie domyślnych motywów ikon systemowych
    QIcon.setThemeName("Papirus-Dark")

    dock = OkayDock()
    dock.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
