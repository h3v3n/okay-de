#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Dock (okay-dock)
Natywny pasek zadań (taskbar) dla środowiska graficznego OKay DE w PyQt6.
Zarządza menu programów, przypiętymi aplikacjami, historią schowka, dźwiękiem, zegarem i zasilaniem.
"""

import os
import sys
import json
import shutil
import subprocess

try:
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QHBoxLayout, QPushButton,
        QMenu, QInputDialog, QMessageBox, QFrame, QSpacerItem, QSizePolicy
    )
    from PyQt6.QtCore import Qt, QTimer, QSize, QFileSystemWatcher, QDateTime, QPoint
    from PyQt6.QtGui import QWheelEvent
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek PyQt6 dla OKay Dock: {err}\n"
        "Zainstaluj pakiet: python-pyqt6.",
        file=sys.stderr
    )
    sys.exit(1)


