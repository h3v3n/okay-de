#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Dock (okay-dock)
Natywny pasek zadań (Taskbar / Panel) w stylu KDE Plasma dla OKay DE w PyQt6.
Zawiera:
- Menu Start a'la KDE Kickoff z wyszukiwarką i kategoriami aplikacji
- Menedżer zadań z prawdziwymi ikonami systemowymi i wskaźnikiem aktywnych okien
- Tackę systemową (schowek, zaawansowany aplet głośności)
- Zegar cyfrowy KDE Digital Clock (czas i data w dwóch wierszach)
- Przycisk 'Pokaż Pulpit' (Show Desktop)
"""

import os
import sys
import json
import glob
import shutil
import subprocess

try:
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QHBoxLayout, QVBoxLayout, QPushButton,
        QMenu, QInputDialog, QMessageBox, QFrame, QSpacerItem, QSizePolicy,
        QLabel, QLineEdit, QListWidget, QListWidgetItem, QScrollArea
    )
    from PyQt6.QtCore import Qt, QTimer, QSize, QFileSystemWatcher, QDateTime, QPoint, QRect
    from PyQt6.QtGui import QIcon, QPixmap, QColor, QPainter, QFont, QPen, QBrush, QWheelEvent
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek PyQt6 dla OKay Dock: {err}\n"
        "Zainstaluj pakiet: python-pyqt6.",
        file=sys.stderr
    )
    sys.exit(1)


# ============================================================================
# Generator i Menedżer Ikon Graficznych (System Icons + SVG/Painter Fallback)
# ============================================================================

class IconHelper:
    """Zapewnia prawdziwe, graficzne ikony z motywów systemowych z bezpiecznym fallbackiem."""

    _cache = {}

    @classmethod
    def get_icon(cls, name_or_cmd: str, fallback_type: str = "app") -> QIcon:
        cache_key = f"{name_or_cmd}_{fallback_type}"
        if cache_key in cls._cache:
            return cls._cache[cache_key]

        # 1. Próba znalezienia ikony w systemowym motywie (Papirus, Breeze, Adwaita, hicolor)
        theme_names = cls._get_theme_candidates(name_or_cmd, fallback_type)
        for t_name in theme_names:
            if QIcon.hasThemeIcon(t_name):
                icon = QIcon.fromTheme(t_name)
                if not icon.isNull():
                    cls._cache[cache_key] = icon
                    return icon

        # 2. Poszukiwanie pliku ikony na dysku (/usr/share/pixmaps, /usr/share/icons)
        disk_icon = cls._find_icon_on_disk(name_or_cmd)
        if disk_icon and not disk_icon.isNull():
            cls._cache[cache_key] = disk_icon
            return disk_icon

        # 3. Generowanie czystej, eleganckiej ikony wektorowej (QPainter)
        generated_icon = cls._create_fallback_icon(fallback_type)
        cls._cache[cache_key] = generated_icon
        return generated_icon

    @staticmethod
    def _get_theme_candidates(name_or_cmd: str, fallback_type: str) -> list:
        key = name_or_cmd.lower()
        mapping = {
            "foot": ["utilities-terminal", "terminal", "org.gnome.Terminal", "xterm"],
            "terminal": ["utilities-terminal", "terminal"],
            "pcmanfm": ["system-file-manager", "folder", "org.gnome.Nautilus", "file-manager"],
            "files": ["system-file-manager", "folder"],
            "okay-settings": ["preferences-system", "preferences-desktop", "settings", "gnome-control-center"],
            "settings": ["preferences-system", "preferences-desktop", "settings"],
            "firefox": ["firefox", "web-browser", "internet-web-browser"],
            "browser": ["web-browser", "firefox", "chromium"],
            "fuzzel": ["system-search", "search", "preferences-system-search"],
            "clipboard": ["klipper", "edit-paste", "clipboard"],
            "lock": ["system-lock-screen", "lock"],
            "power": ["system-shutdown", "system-log-out", "power"],
            "start": ["start-here", "distributor-logo", "kde-plasma", "applications-system"],
            "volume-high": ["audio-volume-high"],
            "volume-med": ["audio-volume-medium"],
            "volume-low": ["audio-volume-low"],
            "volume-muted": ["audio-volume-muted"],
        }
        candidates = mapping.get(key, [])
        candidates.append(key)
        if fallback_type in mapping and fallback_type != key:
            candidates.extend(mapping[fallback_type])
        return candidates

    @staticmethod
    def _find_icon_on_disk(name: str) -> QIcon | None:
        clean = name.split()[0].replace("/", "").strip()
        search_patterns = [
            f"/usr/share/pixmaps/{clean}.png",
            f"/usr/share/pixmaps/{clean}.svg",
            f"/usr/share/icons/hicolor/scalable/apps/{clean}.svg",
            f"/usr/share/icons/hicolor/48x48/apps/{clean}.png",
            f"/usr/share/icons/Papirus/48x48/apps/{clean}.svg",
            f"/usr/share/icons/breeze/apps/48/{clean}.svg",
        ]
        for path in search_patterns:
            if os.path.exists(path):
                icon = QIcon(path)
                if not icon.isNull():
                    return icon
        return None

    @staticmethod
    def _create_fallback_icon(icon_type: str) -> QIcon:
        """Rysuje ostrą, nowoczesną ikonę 48x48 o kolorystyce Catppuccin Mocha."""
        pixmap = QPixmap(48, 48)
        pixmap.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)

        color_accent = QColor("#89b4fa")
        color_sub = QColor("#cdd6f4")

        if icon_type == "terminal":
            painter.setBrush(QBrush(QColor("#181825")))
            painter.setPen(QPen(color_accent, 2))
            painter.drawRoundedRect(4, 8, 40, 32, 4, 4)
            painter.setPen(QPen(color_accent, 3))
            painter.drawLine(10, 18, 18, 24)
            painter.drawLine(18, 24, 10, 30)
            painter.setPen(QPen(color_sub, 3))
            painter.drawLine(22, 30, 34, 30)
        elif icon_type == "files":
            painter.setBrush(QBrush(QColor("#fab387")))
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawRoundedRect(6, 12, 16, 8, 3, 3)
            painter.setBrush(QBrush(QColor("#89b4fa")))
            painter.drawRoundedRect(6, 16, 36, 24, 4, 4)
        elif icon_type == "settings":
            painter.setPen(QPen(color_accent, 3))
            painter.setBrush(QBrush(QColor("#313244")))
            painter.drawEllipse(12, 12, 24, 24)
            painter.setBrush(QBrush(color_accent))
            painter.drawEllipse(20, 20, 8, 8)
        elif icon_type == "browser":
            painter.setPen(QPen(QColor("#89dceb"), 2))
            painter.setBrush(QBrush(QColor("#1e1e2e")))
            painter.drawEllipse(8, 8, 32, 32)
            painter.drawEllipse(16, 8, 16, 32)
            painter.drawLine(8, 24, 40, 24)
        elif icon_type == "start":
            painter.setBrush(QBrush(color_accent))
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawRect(8, 8, 14, 14)
            painter.drawRect(26, 8, 14, 14)
            painter.drawRect(8, 26, 14, 14)
            painter.setBrush(QBrush(QColor("#cdd6f4")))
            painter.drawRect(26, 26, 14, 14)
        elif icon_type.startswith("volume"):
            painter.setBrush(QBrush(color_sub))
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawRect(8, 18, 8, 12)
            # Stożek głośnika
            polygon = [QPoint(16, 18), QPoint(26, 10), QPoint(26, 38), QPoint(16, 30)]
            painter.drawPolygon(polygon)
            if "high" in icon_type or "med" in icon_type:
                painter.setPen(QPen(color_accent, 2))
                painter.drawArc(22, 14, 16, 20, -60 * 16, 120 * 16)
            if "high" in icon_type:
                painter.drawArc(24, 10, 22, 28, -60 * 16, 120 * 16)
            if "muted" in icon_type:
                painter.setPen(QPen(QColor("#f38ba8"), 3))
                painter.drawLine(30, 16, 42, 32)
                painter.drawLine(42, 16, 30, 32)
        else:
            painter.setBrush(QBrush(QColor("#313244")))
            painter.setPen(QPen(color_accent, 2))
            painter.drawRoundedRect(8, 8, 32, 32, 6, 6)
            painter.setPen(QPen(color_sub, 2))
            painter.drawLine(16, 24, 32, 24)
            painter.drawLine(24, 16, 24, 32)

        painter.end()
        return QIcon(pixmap)


