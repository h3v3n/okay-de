#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OKay Dock (okay-dock)
Natywny, nowoczesny pływający dock i pasek zadań dla środowiska OKay DE w PyQt6.
Obsługuje menu aplikacji, przypięte programy, kontrolę głośności, zegar i zasilanie.
"""

import os
import sys
import json
import shutil
import subprocess

try:
    from PyQt6.QtWidgets import (
        QApplication, QWidget, QHBoxLayout, QVBoxLayout, QPushButton,
        QLabel, QMenu, QInputDialog, QMessageBox, QFrame, QSizePolicy
    )
    from PyQt6.QtCore import Qt, QTimer, QSize, QFileSystemWatcher, QDateTime, QPoint
    from PyQt6.QtGui import QColor, QFont, QCursor, QAction, QIcon, QWheelEvent
except ImportError as err:
    print(
        f"Błąd krytyczny: Brak wymaganych bibliotek PyQt6 dla OKay Dock: {err}\n"
        "Zainstaluj wymagany pakiet: python-pyqt6.",
        file=sys.stderr
    )
    sys.exit(1)


