#!/usr/bin/env bash

# OKay DE - Skrypt menu zasilania (Powermenu) oparty o fuzzel
# Wyświetla minimalistyczne menu zarządzania sesją i zasilaniem.

set -euo pipefail

if ! command -v fuzzel >/dev/null 2>&1; then
    echo "Błąd: wymagany pakiet fuzzel." >&2
    exit 1
fi

LOCK="  Zablokuj"
LOGOUT="󰗽  Wyloguj"
REBOOT="󰑓  Uruchom ponownie"
SHUTDOWN="  Wyłącz"

# Wywołanie fuzzel dmenu (anulowanie klawiszem ESC nie przerywa skryptu błędem)
CHOICE=$(printf "%s\n%s\n%s\n%s\n" "$LOCK" "$LOGOUT" "$REBOOT" "$SHUTDOWN" | fuzzel --dmenu -p "Zasilanie: " --lines 4 --width 20 || true)

case "$CHOICE" in
    *"Zablokuj"*)
        if command -v okay-lock >/dev/null 2>&1; then
            okay-lock
        elif command -v swaylock >/dev/null 2>&1; then
            swaylock -f -c 11111b
        else
            loginctl lock-session
        fi
        ;;
    *"Wyloguj"*)
        # Bezpieczne zakończenie procesu kompozytora Wayfire (oraz ewentualnej starszej sesji przy przesiadce)
        CUR_USER="$(id -un)"
        pkill -TERM -u "$CUR_USER" -x wayfire || pkill -TERM -u "$CUR_USER" -x labwc || killall wayfire 2>/dev/null || true
        ;;
    *"Uruchom ponownie"*)
        systemctl reboot || loginctl reboot
        ;;
    *"Wyłącz"*)
        systemctl poweroff || loginctl poweroff
        ;;
    *)
        exit 0
        ;;
esac
