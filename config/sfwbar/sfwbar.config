# OKay DE - Konfiguracja paska zadań sfwbar dla OKsavi Linux
# Motyw: Catppuccin Mocha | Styl: KDE Plasma / Windows (0px radius, ostry design)

function("SfwBarInit") {
  SetBarId "bar-0"
  SetLayer "top"
  SetExclusiveZone "auto"
}

# Lewa strona: Menu Start (OKsavi / OKay DE) oraz Pasek Zadań (Taskbar)
layout ":start" {
  # Przycisk Start (Fuzzel / Menu zasilania)
  button {
    style = "launcher"
    value = "distributor-logo"
    tooltip = "Programy (Super / Fuzzel)"
    action = Exec "fuzzel"
    action[3] = Exec "okay-powermenu"
  }

  # Pasek zadań - dynamiczne ikony otwartych aplikacji oraz przypięte programy
  taskbar {
    rows = 1
    icons = true
    labels = false
    group = popup
    pins = "foot", "pcmanfm", "okay-settings"
  }
}

# Środek (pusty / elastyczny spacer)
layout ":center" {
}

# Prawa strona: Zasobnik systemowy (Tray), Głośność, Zegar, Pokaż pulpit
layout ":end" {
  # Zasobnik systemowy (StatusNotifierItem / SNI)
  tray {
    rows = 1
    style = "tray"
  }

  # Wskaźnik i regulacja głośności
  button {
    style = "volume"
    value = "audio-volume-high"
    tooltip = "Dźwięk (LPM: Pavucontrol, PPM: Wycisz, Rolka: Głośność)"
    action = Exec "pavucontrol"
    action[ScrollUp] = Exec "okay-volume raise"
    action[ScrollDown] = Exec "okay-volume lower"
    action[3] = Exec "okay-volume mute"
  }

  # Dwuwierszowy zegar cyfrowy w stylu KDE Plasma (godzina na górze, data na dole)
  label {
    style = "clock"
    value = Time("%H:%M\n%d.%m.%Y")
    tooltip = Time("%A, %d %B %Y")
  }

  # Przycisk "Pokaż pulpit" na samym skraju paska zadań
  button {
    style = "showdesktop"
    tooltip = "Pokaż pulpit (Super + D)"
    action = Exec "pcmanfm ~/Desktop"
  }
}

#CSS
/* OKay DE - Styl paska zadań sfwbar dla OKsavi Linux
 * Motyw: Catppuccin Mocha | Styl: KDE Plasma / Windows (0px radius, ostry design)
 */

* {
  font-family: "JetBrains Mono", sans-serif;
  font-size: 11px;
  border-radius: 0px;
  -GtkButton-default-border: 0px;
  -GtkButton-default-outside-border: 0px;
}

/* Główne okno paska zadań */
window#sfwbar {
  -GtkWidget-direction: bottom;
  background-color: #11111b;
  border-top: 1px solid #313244;
  color: #cdd6f4;
  min-height: 40px;
}

/* Przycisk Start (Launcher) */
button#launcher,
button.launcher {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  padding: 4px 10px;
  margin-right: 4px;
}

button#launcher:hover,
button.launcher:hover {
  background-color: #313244;
}

/* ==========================================================================
 * Dynamiczny Pasek Zadań (Taskbar)
 * ========================================================================== */

/* Domyślny styl przycisku aplikacji w pasku zadań */
button#taskbar_item,
#taskbar button {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  border-bottom: 3px solid #ffffff; /* Biała kreska na dole dla każdej otwartej aplikacji */
  padding: 2px 8px;
  margin: 0px 2px;
  min-height: 36px;
  min-width: 40px;
  color: #cdd6f4;
}

/* Przypięte aplikacje, które NIE są uruchomione - brak białej kreski */
button#taskbar_item.pin,
#taskbar button.pin {
  border-bottom: 3px solid transparent;
  opacity: 0.85;
}

/* Przypięta aplikacja po uruchomieniu (staje się aktywna, zogniskowana lub zminimalizowana) - BIAŁA KRESKA */
button#taskbar_item.pin.focused,
button#taskbar_item.pin.active,
button#taskbar_item.pin.minimized,
#taskbar button.pin.focused,
#taskbar button.pin.active,
#taskbar button.pin.minimized {
  border-bottom: 3px solid #ffffff;
  opacity: 1.0;
}

/* Aktywna / bieżąca aplikacja (Focused / Active) */
button#taskbar_item.focused,
button#taskbar_item.active,
#taskbar button.focused,
#taskbar button.active {
  background-color: #24273a;
  border-bottom: 3px solid #ffffff;
  opacity: 1.0;
}

/* Zminimalizowane okno - lekko przygaszone, ale BIAŁA KRESKA POZOSTAJE */
button#taskbar_item.minimized,
#taskbar button.minimized {
  opacity: 0.65;
  background-color: transparent;
  border-bottom: 3px solid #ffffff;
}

/* Efekt najechania myszą na pozycję w taskbarze */
button#taskbar_item:hover,
#taskbar button:hover {
  background-color: #313244;
}

/* Okno w stanie pilnym (Urgent / Alert) */
button#taskbar_item.urgent,
#taskbar button.urgent {
  background-color: #f38ba8;
  color: #11111b;
  border-bottom: 3px solid #f38ba8;
}

/* Rozwijane menu grupy okien (Popup grupowania dla wielu okien tego samego programu) */
window#taskbar_popup,
grid#taskbar_popup_grid,
popup {
  background-color: #181825;
  border: 1px solid #313244;
  border-radius: 0px;
  padding: 4px;
}

grid#taskbar_popup_grid button,
window#taskbar_popup button {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  border-bottom: 2px solid #89b4fa;
  padding: 6px 12px;
  color: #cdd6f4;
  font-family: "JetBrains Mono", sans-serif;
  font-size: 11px;
}

grid#taskbar_popup_grid button:hover,
window#taskbar_popup button:hover {
  background-color: #313244;
}

/* ==========================================================================
 * Prawa Strona Paska (Zasobnik, Głośność, Zegar, Pokaż Pulpit)
 * ========================================================================== */

/* Zasobnik systemowy (Tray) */
grid#tray,
tray {
  margin-left: 6px;
  margin-right: 6px;
  background-color: transparent;
  border: none;
}

tray image {
  padding: 0px 4px;
}

/* Przycisk Głośności */
button#volume,
button.volume {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  padding: 2px 8px;
  margin: 0px 2px;
}

button#volume:hover,
button.volume:hover {
  background-color: #313244;
}

/* Dwuwierszowy zegar cyfrowy (KDE Plasma style) */
label#clock,
label.clock {
  color: #cdd6f4;
  font-family: "JetBrains Mono", sans-serif;
  font-size: 11px;
  padding: 2px 10px;
  margin: 0px 4px;
  text-align: center;
}

label#clock:hover,
label.clock:hover {
  background-color: #24273a;
}

/* Przycisk "Pokaż pulpit" na skraju paska */
button#showdesktop,
button.showdesktop {
  background-color: transparent;
  border: none;
  border-left: 1px solid #313244;
  border-radius: 0px;
  min-width: 12px;
  padding: 0px 6px;
  margin-left: 4px;
}

button#showdesktop:hover,
button.showdesktop:hover {
  background-color: #89b4fa;
}
