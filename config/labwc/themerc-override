# OKay DE - Labwc Theme Override (Catppuccin Mocha)

# Geometryczne zaokrąglenie okien
window.cornerRadius: 8

# Układ przycisków paska tytułowego (brak tytułu, 3 duże prostokąty: min, max, close)
window.titlebar.layout: :iconify,max,close

# Wymiary i odstępy przycisków (duże prostokąty 44x22)
window.button.width: 44
window.button.height: 22
window.button.spacing: 6

# Obramowania okien
border.width: 2
window.active.border.color: #89b4fa
window.inactive.border.color: #313244

# Pasek tytułowy (dla okien z SSD)
titlebar.height: 36
window.titlebar.padding: 4
window.titlebar.padding.width: 8
window.titlebar.padding.height: 6
window.active.title.bg.color: #1e1e2e
window.inactive.title.bg.color: #181825
window.active.label.text.color: transparent
window.inactive.label.text.color: transparent

# Przyciski sterowania oknami (prostokątne klocki)
# Przycisk zamykania (Close)
window.active.button.unhover.close.color: #f38ba8
window.active.button.hover.close.color: #eba0ac
window.inactive.button.unhover.close.color: #45475a
window.inactive.button.hover.close.color: #f38ba8
window.active.button.close.unpressed.image.color: #f38ba8
window.inactive.button.close.unpressed.image.color: #45475a

# Przycisk maksymalizowania (Maximize)
window.active.button.unhover.max.color: #89b4fa
window.active.button.hover.max.color: #b4befe
window.inactive.button.unhover.max.color: #45475a
window.inactive.button.hover.max.color: #89b4fa
window.active.button.max.unpressed.image.color: #89b4fa
window.inactive.button.max.unpressed.image.color: #45475a

# Przycisk minimalizowania (Iconify)
window.active.button.unhover.iconify.color: #585b70
window.active.button.hover.iconify.color: #6c7086
window.inactive.button.unhover.iconify.color: #313244
window.inactive.button.hover.iconify.color: #585b70
window.active.button.iconify.unpressed.image.color: #585b70
window.inactive.button.iconify.unpressed.image.color: #313244

# Menu kontekstowe (menu.xml)
menu.border.width: 1
menu.border.color: #89b4fa
menu.items.bg.color: #1e1e2e
menu.items.text.color: #cdd6f4
menu.items.active.bg.color: #89b4fa
menu.items.active.text.color: #11111b
menu.separator.color: #313244
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
