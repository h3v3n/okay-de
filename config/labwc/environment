# OKay DE - Zmienne środowiskowe kompozytora labwc
# Wymuszenie widoczności kursora programowego (niezbędne dla VM, QEMU, VirtualBox, NVIDIA)
WLR_NO_HARDWARE_CURSORS=1
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24

# Integracja Wayland i optymalizacja pamięci RAM
MALLOC_ARENA_MAX=2
NO_AT_BRIDGE=1
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland;xcb
GDK_BACKEND=wayland,x11,*
SDL_VIDEODRIVER=wayland
CLUTTER_BACKEND=wayland
GTK_CSD=0
GTK_THEME=Adwaita-dark
GTK_USE_PORTAL=0
QT_WAYLAND_DISABLE_WINDOWDECORATION=0
