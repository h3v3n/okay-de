#!/bin/sh

# OKay DE - Skrypt autostartu sesji kompozytora labwc

# 0. Zapewnienie pełnej ścieżki PATH dla skryptów środowiska
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# 1. Agent uwierzytelniania Polkit (gnome)
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif [ -x /usr/libexec/polkit-gnome-authentication-agent-1 ]; then
    /usr/libexec/polkit-gnome-authentication-agent-1 &
fi

# 2. Demon powiadomień
mako &

# 3. Pasek zadań OKay DE (sfwbar z wlr-layer-shell)
(
    # Zakończenie ewentualnych starych instancji
    pkill -9 -x okay-dock 2>/dev/null || true
    pkill -x sfwbar 2>/dev/null || true
    sleep 0.5
    SFWBAR_BIN="$(command -v sfwbar 2>/dev/null || echo "")"
    if [ -z "$SFWBAR_BIN" ]; then
        if [ -x /usr/bin/sfwbar ]; then SFWBAR_BIN="/usr/bin/sfwbar"; fi
        if [ -x /usr/local/bin/sfwbar ]; then SFWBAR_BIN="/usr/local/bin/sfwbar"; fi
    fi
    if [ -n "$SFWBAR_BIN" ]; then
        if [ -f "$HOME/.config/sfwbar/sfwbar.config" ]; then
            "$SFWBAR_BIN" -f "$HOME/.config/sfwbar/sfwbar.config" > /tmp/sfwbar.log 2>&1
        elif [ -f /etc/xdg/sfwbar/sfwbar.config ]; then
            "$SFWBAR_BIN" -f /etc/xdg/sfwbar/sfwbar.config > /tmp/sfwbar.log 2>&1
        else
            "$SFWBAR_BIN" > /tmp/sfwbar.log 2>&1
        fi
    fi
) &

# 4. Tapeta i tło pulpitu (swaybg z kolorem bazowym i tapetą)
# Sprawdzenie w kolejności: tapeta użytkownika -> tapeta systemowa -> kolor awaryjny
WALLPAPER_USER="$HOME/.config/okay-de/wallpaper.png"
WALLPAPER_SYSTEM="/usr/share/backgrounds/okay-de/default.png"

if [ -f "$WALLPAPER_USER" ]; then
    swaybg -c "#1e1e2e" -i "$WALLPAPER_USER" -m fill &
elif [ -f "$WALLPAPER_SYSTEM" ]; then
    swaybg -c "#1e1e2e" -i "$WALLPAPER_SYSTEM" -m fill &
else
    swaybg -c "#1e1e2e" &
fi

# 5. Menedżer schowka (wl-clipboard + cliphist: obsługa tekstu oraz obrazów)
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    wl-paste --watch cliphist store &
    wl-paste --type image --watch cliphist store &
fi

# 6. Zarządca zasobów OKsavi (cgroups v2 + zRAM)
if command -v oksavi-ghost-runner >/dev/null 2>&1; then
    oksavi-ghost-runner --start &
fi
