#!/bin/sh

# OKay DE - Skrypt autostartu sesji kompozytora labwc

# 0. Zapewnienie pełnej ścieżki PATH oraz spójnego ciemnego motywu sesji (GTK / ikony / kursor)
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
if command -v gsettings >/dev/null 2>&1; then
    (
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-size 24 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name 'JetBrains Mono 10' 2>/dev/null || true
    ) &
fi

# Wyłączenie nadpisywania tła swaybg przez pcmanfm --desktop w sesji Wayland
PCMANFM_CONF="$HOME/.config/pcmanfm/default/desktop-items-0.conf"
if [ -f "$PCMANFM_CONF" ]; then
    sed -i -E 's|^wallpaper_mode=.*|wallpaper_mode=color|; s|^wallpaper=.*|wallpaper=|; s|^desktop_bg=.*|desktop_bg=#00000000|' "$PCMANFM_CONF" 2>/dev/null || true
fi

# 1. Agent uwierzytelniania Polkit (gnome)
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif [ -x /usr/libexec/polkit-gnome-authentication-agent-1 ]; then
    /usr/libexec/polkit-gnome-authentication-agent-1 &
fi

# 2. Demon powiadomień
mako &

# 3. Pasek zadań OKay DE (Zunifikowany okay-panel)
(
    sleep 0.5
    PANEL_LOG="${XDG_RUNTIME_DIR:-/tmp}/okay-panel.log"
    pkill -9 -x sfwbar 2>/dev/null || true
    pkill -9 -x waybar 2>/dev/null || true
    pkill -9 -x okay-dock 2>/dev/null || true
    if [ -x "$HOME/.local/bin/okay-panel" ]; then
        "$HOME/.local/bin/okay-panel" > "$PANEL_LOG" 2>&1 &
    elif [ -x /usr/local/bin/okay-panel ]; then
        /usr/local/bin/okay-panel > "$PANEL_LOG" 2>&1 &
    elif [ -x /usr/bin/okay-panel ]; then
        /usr/bin/okay-panel > "$PANEL_LOG" 2>&1 &
    elif command -v okay-panel >/dev/null 2>&1; then
        okay-panel > "$PANEL_LOG" 2>&1 &
    fi
) &

# 3b. Natywny pulpit z ikonami aplikacji i plików (~/Desktop)
(
    sleep 0.3
    DESKTOP_LOG="${XDG_RUNTIME_DIR:-/tmp}/okay-desktop.log"
    if [ -x "$HOME/.local/bin/okay-desktop" ]; then
        "$HOME/.local/bin/okay-desktop" > "$DESKTOP_LOG" 2>&1 &
    elif [ -x /usr/local/bin/okay-desktop ]; then
        /usr/local/bin/okay-desktop > "$DESKTOP_LOG" 2>&1 &
    elif [ -x /usr/bin/okay-desktop ]; then
        /usr/bin/okay-desktop > "$DESKTOP_LOG" 2>&1 &
    elif command -v okay-desktop >/dev/null 2>&1; then
        okay-desktop > "$DESKTOP_LOG" 2>&1 &
    fi
) &

# 4. Tapeta i tło pulpitu (swaybg z kolorem bazowym i tapetą)
# Sprawdzenie w kolejności: tapeta użytkownika -> tapeta systemowa -> kolor awaryjny
WALLPAPER_USER="$HOME/.config/okay-de/wallpaper.png"
WALLPAPER_SYSTEM="/usr/share/backgrounds/okay-de/default.png"

if [ -f "$WALLPAPER_USER" ]; then
    swaybg -c "#1e1e2e" -i "$WALLPAPER_USER" -m fill &
elif [ -f "$WALLPAPER_SYSTEM" ]; then
    swaybg -c "#1e1e2e" -i "$WALLPAPER_SYSTEM" -m fill &
else
    swaybg -c "#1e1e2e" &
fi

# 5. Menedżer schowka (wl-clipboard + cliphist: obsługa tekstu oraz obrazów)
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    wl-paste --watch cliphist store &
    wl-paste --type image --watch cliphist store &
fi
