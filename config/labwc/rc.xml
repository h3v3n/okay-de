<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <gap>6</gap>
    <margin bottom="44" />
  </core>

  <!-- Kafelkowanie okien przy przeciąganiu myszą do krawędzi ekranu -->
  <snapping>
    <range>
      <inner>10</inner>
      <outer>10</outer>
      <cornerRange>20</cornerRange>
    </range>
  </snapping>

  <theme>
    <name>OKay</name>
    <cornerRadius>0</cornerRadius>
    <titlebar>
      <layout>:iconify,max,close</layout>
      <showTitle>no</showTitle>
    </titlebar>
    <font place="MenuItem">
      <name>JetBrains Mono</name>
      <size>10</size>
    </font>
  </theme>

  <!-- Reguły okien: wymuszenie Server-Side Decorations (SSD) dla wszystkich aplikacji XDG-Shell -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" />
    <windowRule identifier="okay-dock" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
      <fixedPosition>yes</fixedPosition>
    </windowRule>
    <windowRule title="okay-dock*" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="MoveToEdge" direction="down" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
      <fixedPosition>yes</fixedPosition>
    </windowRule>
    <windowRule identifier="fuzzel" serverDecoration="no" />
    <windowRule identifier="pcmanfm" type="desktop" serverDecoration="no" />
  </windowRules>

  <mouse>
    <default />
    <!-- Menu kontekstowe pod prawym przyciskiem myszy na pulpicie -->
    <!-- Nadpisanie domyślnego zachowania labwc: lewy przycisk na pulpicie NIE otwiera menu -->
    <context name="Root">
      <mousebind button="Left" action="Press" />
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

  <keyboard>
    <default />

    <!-- Terminal: Super + Return -->
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>

    <!-- Launcher aplikacji: Super + Spacja -->
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- Menu główne / podręczne: Super + M -->
    <keybind key="W-m">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>

    <!-- Centrum sterowania / Ustawienia: Super + I -->
    <keybind key="W-i">
      <action name="Execute" command="sh -c 'if [ -x &quot;$HOME/.local/bin/okay-settings&quot; ]; then exec &quot;$HOME/.local/bin/okay-settings&quot;; else exec okay-settings; fi'" />
    </keybind>

    <!-- Menedżer plików: Super + E -->
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm" />
    </keybind>

    <!-- Historia schowka: Super + V -->
    <keybind key="W-v">
      <action name="Execute" command="okay-clipboard" />
    </keybind>

    <!-- Blokada ekranu: Super + L -->
    <keybind key="W-l">
      <action name="Execute" command="okay-lock" />
    </keybind>

    <!-- Zamknięcie aktywnego okna: Super + Q -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Zarządzanie oknami i kafelkowanie (Tiling) -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Menu zasilania / Powermenu: Super + Shift + E -->
    <keybind key="W-S-e">
      <action name="Execute" command="okay-powermenu" />
    </keybind>

    <!-- Zrzut ekranu zaznaczonego obszaru: PrintScreen -->
    <keybind key="Print">
      <action name="Execute" command="okay-screenshot" />
    </keybind>

    <!-- Klawisze multimedialne: Regulacja głośności z OSD (PipeWire / wpctl) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="okay-volume raise" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="okay-volume lower" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="okay-volume mute" />
    </keybind>

    <!-- Klawisze jasności ekranu z OSD (brightnessctl) -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="okay-brightness up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="okay-brightness down" />
    </keybind>
  </keyboard>
</labwc_config>
