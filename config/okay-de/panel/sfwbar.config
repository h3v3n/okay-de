# OKay DE - Konfiguracja paska zadań sfwbar dla OKsavi Linux
# Motyw: OKsavi Dark Neon | Styl: Kanciasty, zieleń OKsavi (#00e676)

function("SfwBarInit") {
  SetBarId "bar-0"
  SetLayer "top"
  SetExclusiveZone "auto"
}

# Lewa strona: Menu Start (OK) oraz Pasek Zadań (Taskbar z ikonami i nazwami okien)
layout ":start" {
  button {
    style = "launcher"
    label = " OK "
    tooltip = "Menu programów (Super / Fuzzel)\nPPM: Menu zasilania"
    action = Exec "fuzzel"
    action[3] = Exec "okay-powermenu"
  }

  taskbar {
    rows = 1
    icons = true
    labels = true
    group = popup
    pins = "foot", "pcmanfm", "okay-settings"
  }
}

# Środek (elastyczny odstęp)
layout ":center" {
}

# Prawa strona: Zasobnik systemowy (Tray / SNI), Głośność, Zegar, Pokaż pulpit
layout ":end" {
  tray {
    rows = 1
    style = "tray"
  }

  button {
    style = "volume"
    value = "audio-volume-high"
    tooltip = "Dźwięk (LPM: Mikser, PPM: Wycisz, Rolka: Głośność)"
    action = Exec "pavucontrol"
    action[ScrollUp] = Exec "okay-volume raise"
    action[ScrollDown] = Exec "okay-volume lower"
    action[3] = Exec "okay-volume mute"
  }

  label {
    style = "clock"
    value = Time("%H:%M  %d.%m.%Y")
    tooltip = Time("%A, %d %B %Y")
  }

  button {
    style = "showdesktop"
    tooltip = "Pokaż pulpit (Super + D)"
    action = Exec "pcmanfm ~/Desktop"
  }
}

#CSS
/* OKay DE - Styl CSS paska sfwbar (OKsavi Dark Neon) */

* {
  font-family: "JetBrains Mono", sans-serif;
  font-size: 11px;
  border-radius: 0px;
  -GtkButton-default-border: 0px;
  -GtkButton-default-outside-border: 0px;
  margin: 0;
  padding: 0;
}

window#sfwbar {
  -GtkWidget-direction: bottom;
  background-color: #111111;
  border-top: 1px solid #222222;
  color: #e0e0e0;
  min-height: 38px;
}

/* Przycisk Start (OK) */
button#launcher,
button.launcher {
  background-color: #00e676;
  color: #000000;
  font-weight: bold;
  border: none;
  border-radius: 0px;
  padding: 0px 14px;
  margin-right: 6px;
  min-height: 38px;
}

button#launcher:hover,
button.launcher:hover {
  background-color: #2ecc71;
  color: #000000;
}

/* Dynamiczny Taskbar (Otwarte okna i przypięte aplikacje) */
button#taskbar_item,
#taskbar button {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  border-bottom: 3px solid #282828;
  padding: 2px 10px;
  margin: 0px 2px;
  min-height: 34px;
  min-width: 60px;
  color: #e0e0e0;
}

/* Przypięta aplikacja nieuruchomiona */
button#taskbar_item.pin,
#taskbar button.pin {
  border-bottom: 3px solid transparent;
  opacity: 0.8;
}

/* Aktywne / zogniskowane okno (Zielony akcent OKsavi) */
button#taskbar_item.focused,
button#taskbar_item.active,
#taskbar button.focused,
#taskbar button.active {
  background-color: #172b1e;
  border-bottom: 3px solid #00e676;
  color: #ffffff;
  opacity: 1.0;
}

/* Zminimalizowane okno */
button#taskbar_item.minimized,
#taskbar button.minimized {
  opacity: 0.65;
  background-color: transparent;
  border-bottom: 3px solid #00e676;
}

button#taskbar_item:hover,
#taskbar button:hover {
  background-color: #222222;
}

/* Menu popup zgrupowanych okien */
window#taskbar_popup,
grid#taskbar_popup_grid,
popup {
  background-color: #161616;
  border: 1px solid #2e2e2e;
  border-radius: 0px;
  padding: 4px;
}

grid#taskbar_popup_grid button,
window#taskbar_popup button {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  border-bottom: 2px solid #00e676;
  padding: 6px 12px;
  color: #e0e0e0;
}

grid#taskbar_popup_grid button:hover,
window#taskbar_popup button:hover {
  background-color: #222222;
}

/* Prawa strona */
grid#tray,
tray {
  margin-left: 6px;
  margin-right: 6px;
  background-color: transparent;
}

tray image {
  padding: 0px 4px;
}

button#volume,
button.volume {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  padding: 2px 8px;
  margin: 0px 2px;
  color: #e0e0e0;
}

button#volume:hover,
button.volume:hover {
  background-color: #222222;
}

label#clock,
label.clock {
  color: #e0e0e0;
  font-weight: bold;
  padding: 2px 12px;
  margin: 0px 4px;
}

label#clock:hover,
label.clock:hover {
  background-color: #1c1c1c;
}

button#showdesktop,
button.showdesktop {
  background-color: transparent;
  border: none;
  border-left: 1px solid #282828;
  border-radius: 0px;
  min-width: 14px;
  padding: 0px 6px;
  margin-left: 4px;
}

button#showdesktop:hover,
button.showdesktop:hover {
  background-color: #00e676;
}
