# OKay DE - Konfiguracja paska zadań sfwbar dla OKsavi Linux
# Natywna obsługa Wayland: wlr-layer-shell (dół ekranu, exclusive zone) oraz wlr-foreign-toplevel

function("SfwBarInit") {
  SetBarId "bar-0"
  SetLayer "top"
  SetExclusiveZone "auto"
}

# Logika kliknięcia w zadanie na pasku:
# - Okno sfokusowane -> minimalizuj
# - Okno zminimalizowane -> przywróć (UnMinimize) i aktywuj (Focus)
# - Okno w tle -> aktywuj na wierzch (Focus)
function("TaskbarClick") {
  [Focused] Minimize
  [Minimized] UnMinimize
  [!Focused] Focus
}

menu("winops") {
  item("Przywróć / Aktywuj", Focus)
  item("Minimalizuj", Minimize)
  item("Maksymalizuj", Maximize)
  item("Zamknij", Close)
}

layout {
  # Po lewej: Przycisk Menu Start ("OK")
  label {
    style = "launcher"
    value = " OK "
    tooltip = "Menu programów (Super / Fuzzel)\nPPM: Menu zasilania"
    action[1] = Exec "fuzzel"
    action[3] = Exec "okay-powermenu"
  }

  # Dynamiczny pasek zadań (wszystkie otwarte okna z wlr-foreign-toplevel)
  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = true
    title_width = 20
    group = false
    sort = true
    action[1] = Function "TaskbarClick"
    action[2] = Close
    action[3] = Menu "winops"
  }

  # Elastyczny odstęp rozpychający prawą stronę do krawędzi ekranu
  label {
    value = ""
    css = "* { -GtkWidget-hexpand: true; }"
  }

  # Po prawej: Zasobnik systemowy (System Tray / SNI)
  tray {
    rows = 1
    style = "tray"
  }

  # Regulacja głośności
  button {
    style = "volume"
    value = "audio-volume-high"
    tooltip = "Dźwięk (LPM: Mikser, PPM: Wycisz, Rolka: +/-)"
    action[1] = Exec "pavucontrol"
    action[3] = Exec "okay-volume mute"
    action[4] = Exec "okay-volume raise"
    action[5] = Exec "okay-volume lower"
  }

  # Zegar z godziną i datą
  label {
    style = "clock"
    value = Time("%H:%M  %d.%m.%Y")
    tooltip = Time("%A, %d %B %Y")
  }

  # Przycisk "Pokaż pulpit"
  button {
    style = "showdesktop"
    value = "user-desktop"
    tooltip = "Pokaż pulpit (Super + D)"
    action[1] = Exec "pcmanfm ~/Desktop"
  }
}

#CSS
/* OKay DE - Styl CSS paska zadań sfwbar (OKsavi Dark Neon) */

* {
  font-family: "JetBrains Mono", sans-serif;
  font-size: 11px;
  border-radius: 0px;
  -GtkButton-default-border: 0px;
  -GtkButton-default-outside-border: 0px;
}

window#sfwbar {
  -GtkWidget-direction: bottom;
  background-color: #111111;
  border-top: 1px solid #222222;
  color: #e0e0e0;
  min-height: 38px;
}

/* Przycisk Start ("OK") */
label#launcher,
label.launcher,
button#launcher {
  background-color: #00e676;
  color: #000000;
  font-weight: bold;
  font-size: 12px;
  border: none;
  border-radius: 0px;
  padding: 0px 14px;
  margin-right: 6px;
  min-height: 38px;
}

label#launcher:hover,
label.launcher:hover,
button#launcher:hover {
  background-color: #2ecc71;
  color: #000000;
}

/* ==========================================================================
 * Dynamiczny Taskbar (Stany okien: normalne, aktywne, zminimalizowane)
 * ========================================================================== */

/* Każde otwarte okno: subtelna biała kreska u dołu przycisku */
grid#taskbar button,
#taskbar button,
button#taskbar_item,
button.taskbar_item,
button#taskbar_normal {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  border-bottom: 2px solid rgba(255, 255, 255, 0.55);
  padding: 2px 10px;
  margin: 0px 2px;
  min-height: 34px;
  min-width: 44px;
  color: #cccccc;
}

/* Aktywne / sfokusowane okno: wyraźne podświetlenie + pełna jasna biała kreska */
grid#taskbar button.focused,
grid#taskbar button.active,
grid#taskbar button:focus,
#taskbar button.focused,
#taskbar button.active,
#taskbar button:focus,
button#taskbar_item.focused,
button#taskbar_item.active,
button.taskbar_item.focused,
button.taskbar_item.active,
button#taskbar_active {
  background-color: #172b1e;
  border-bottom: 3px solid #ffffff;
  color: #ffffff;
  font-weight: bold;
}

/* Zminimalizowane okno: lekko przygaszona ikona i subtelny ciemniejszy wskaźnik */
grid#taskbar button.minimized,
grid#taskbar button:minimized,
#taskbar button.minimized,
#taskbar button:minimized,
button#taskbar_item.minimized,
button.taskbar_item.minimized,
button#taskbar_minimized {
  opacity: 0.55;
  background-color: transparent;
  border-bottom: 2px solid rgba(255, 255, 255, 0.25);
  color: #888888;
}

/* Hover myszą na oknie w pasku zadań */
grid#taskbar button:hover,
#taskbar button:hover,
button#taskbar_item:hover,
button.taskbar_item:hover,
button#taskbar_normal:hover,
button#taskbar_active:hover {
  background-color: #222222;
  color: #ffffff;
}

/* Okno wymagające uwagi (Urgent) */
grid#taskbar button.urgent,
#taskbar button.urgent,
button#taskbar_item.urgent,
button.taskbar_item.urgent {
  background-color: #2e1518;
  border-bottom: 3px solid #f38ba8;
  color: #ffffff;
}

/* Prawa strona: Tray, Głośność, Zegar, Pokaż pulpit */
grid#tray,
tray {
  margin-left: 6px;
  margin-right: 6px;
  background-color: transparent;
}

tray image {
  padding: 0px 4px;
}

button#volume,
button.volume {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  padding: 2px 8px;
  margin: 0px 2px;
  color: #e0e0e0;
}

button#volume:hover,
button.volume:hover {
  background-color: #222222;
}

label#clock,
label.clock {
  color: #e0e0e0;
  font-weight: bold;
  padding: 2px 12px;
  margin: 0px 4px;
}

label#clock:hover,
label.clock:hover {
  background-color: #1c1c1c;
}

button#showdesktop,
button.showdesktop {
  background-color: transparent;
  border: none;
  border-left: 1px solid #282828;
  border-radius: 0px;
  min-width: 14px;
  padding: 0px 6px;
  margin-left: 4px;
}

button#showdesktop:hover,
button.showdesktop:hover {
  background-color: #00e676;
}
