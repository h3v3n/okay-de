{
  "layer": "top",
  "position": "bottom",
  "height": 38,
  "margin-bottom": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,

  "modules-left": [
    "custom/launcher",
    "wlr/taskbar"
  ],

  "modules-center": [],

  "modules-right": [
    "tray",
    "pulseaudio",
    "clock",
    "custom/desktop"
  ],

  "custom/launcher": {
    "format": " OK ",
    "tooltip": true,
    "tooltip-format": "Menu programów (Super / Fuzzel)\nPPM: Menu zasilania",
    "on-click": "fuzzel",
    "on-click-right": "okay-powermenu"
  },

  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 20,
    "all-outputs": true,
    "tooltip": true,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "ignore-list": [
      "fuzzel"
    ]
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Wyciszony",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "okay-volume mute",
    "on-scroll-up": "okay-volume raise",
    "on-scroll-down": "okay-volume lower",
    "tooltip": true,
    "tooltip-format": "Głośność: {volume}%\nLPM: Mikser, PPM: Wycisz, Rolka: +/-"
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M  %d.%m.%Y}",
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/desktop": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Pokaż pulpit (Super + D)",
    "on-click": "pcmanfm ~/Desktop"
  }
}
