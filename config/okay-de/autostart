#!/usr/bin/env sh
# =============================================================================
# OKay DE — Skrypt autostartu sesji Wayland (uruchamiany przez kompozytor Wayfire)
# =============================================================================

export PATH="$HOME/.local/bin:$PATH"
export GTK_CSD=0
export XDG_CURRENT_DESKTOP="OKay:wayfire"
export XDG_SESSION_DESKTOP="OKay"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export MOZ_ENABLE_WAYLAND=1
export MOZ_GTK_TITLEBAR_DECORATION="system"

# 1. Przekazanie zmiennych sesji Wayland do D-Bus i systemd (wymagane przez xdg-desktop-portal i Flatpaki)
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        GTK_CSD QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME MOZ_ENABLE_WAYLAND >/dev/null 2>&1 &
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment \
        WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        GTK_CSD QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME MOZ_ENABLE_WAYLAND >/dev/null 2>&1 &
fi

# 2. Synchronizacja ustawień dconf/gsettings, stylów GTK3/GTK4/libadwaita oraz sandboxa Flatpak
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' >/dev/null 2>&1 &
    gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita' >/dev/null 2>&1 &
fi

if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import sys, os
for p in [os.path.expanduser("~/.local/bin"), "/usr/bin", "/usr/local/bin"]:
    if os.path.isdir(os.path.join(p, "settings")) and p not in sys.path:
        sys.path.insert(0, p)
try:
    from settings.helpers import sync_startup_environment
    sync_startup_environment()
except Exception:
    pass
' >/dev/null 2>&1 &
fi

# 3. Tapeta pulpitu (swaybg)
WALLPAPER_USER="$HOME/.config/okay-de/wallpaper"
WALLPAPER_SYS="/usr/share/okay-de/wallpapers/default.png"

pkill -x swaybg 2>/dev/null || true
if command -v swaybg >/dev/null 2>&1; then
    if [ -f "$WALLPAPER_USER" ]; then
        swaybg -i "$WALLPAPER_USER" -m fill >/dev/null 2>&1 &
    elif [ -f "$WALLPAPER_SYS" ]; then
        swaybg -i "$WALLPAPER_SYS" -m fill >/dev/null 2>&1 &
    else
        swaybg -c "#0D0D11" >/dev/null 2>&1 &
    fi
fi

# 4. Natywny pasek systemowy OKay Panel (GTK3 + GtkLayerShell)
pkill -x waybar 2>/dev/null || true
pkill -f "okay-panel" 2>/dev/null || true
if command -v okay-panel >/dev/null 2>&1; then
    okay-panel >/dev/null 2>&1 &
elif [ -x "$HOME/.local/bin/okay-panel" ]; then
    "$HOME/.local/bin/okay-panel" >/dev/null 2>&1 &
fi

# 5. Demon powiadomień (mako)
pkill -x mako 2>/dev/null || true
if command -v mako >/dev/null 2>&1; then
    mako >/dev/null 2>&1 &
fi

# 6. Agent uwierzytelniania Polkit (uprawnienia administratora dla GUI)
for polkit_agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-kde-authentication-agent-1 \
    /usr/libexec/polkit-kde-authentication-agent-1 \
    /usr/lib/xfce-polkit/xfce-polkit \
    /usr/bin/lxpolkit; do
    if [ -x "$polkit_agent" ]; then
        "$polkit_agent" >/dev/null 2>&1 &
        break
    fi
done

# 7. Menedżer historii schowka Wayland (wl-paste + cliphist)
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
    pkill -f "wl-paste --type text --watch cliphist store" 2>/dev/null || true
    pkill -f "wl-paste --type image --watch cliphist store" 2>/dev/null || true
    wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
    wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
fi

# 8. Aplet sieciowy w zasobniku (nm-applet)
if command -v nm-applet >/dev/null 2>&1; then
    pkill -x nm-applet 2>/dev/null || true
    nm-applet --indicator >/dev/null 2>&1 &
fi
