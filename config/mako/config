# OKay DE - Konfiguracja demona powiadomień mako

font=JetBrains Mono 10
width=360
height=120
margin=44,14,0,0
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48

# Położenie w prawym górnym rogu pod panelem Waybar
anchor=top-right

# Stylistyka (Catppuccin Mocha)
background-color=#1e1e2ef0
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #89b4fa

# Czas wyświetlania powiadomień (ms)
default-timeout=5000

[urgency=low]
border-color=#313244
default-timeout=3000

[urgency=normal]
border-color=#89b4fa
default-timeout=5000

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
