{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "spacing": 4,

  "modules-left": [],
  "modules-center": [
    "custom/launcher",
    "custom/pin-foot",
    "custom/pin-pcmanfm",
    "custom/pin-settings",
    "wlr/taskbar",
    "custom/separator",
    "custom/clipboard",
    "pulseaudio",
    "network",
    "battery",
    "clock",
    "custom/power"
  ],
  "modules-right": [],

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "fuzzel",
    "tooltip-format": "Wyszukiwarka aplikacji"
  },

  "custom/pin-foot": {
    "format": "",
    "on-click": "foot",
    "tooltip-format": "Terminal (foot)"
  },

  "custom/pin-pcmanfm": {
    "format": "󰉋",
    "on-click": "pcmanfm",
    "tooltip-format": "Menedżer plików (pcmanfm)"
  },

  "custom/pin-settings": {
    "format": "󰒓",
    "on-click": "okay-settings",
    "tooltip-format": "Ustawienia OKay"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 24,
    "icon-theme": "Papirus-Dark",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close"
  },

  "custom/separator": {
    "format": "│",
    "tooltip": false
  },

  "custom/clipboard": {
    "format": "󰅍",
    "on-click": "okay-clipboard",
    "tooltip-format": "Historia schowka"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "okay-volume mute",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "okay-volume raise",
    "on-scroll-down": "okay-volume lower",
    "tooltip-format": "Głośność: {volume}% (Prawy klik: Mikser)"
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "on-click": "foot -e nmtui",
    "tooltip-format": "{essid} ({signalStrength}%)\nIP: {ipaddr}\nKliknij, aby zarządzać połączeniami"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nZużycie: {power}W"
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/power": {
    "format": "",
    "on-click": "okay-powermenu",
    "tooltip-format": "Zasilanie i sesja"
  }
}
