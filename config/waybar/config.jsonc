{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": ["custom/launcher", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "memory", "battery", "tray", "custom/power"],

  "custom/launcher": {
    "format": "󰣇 OKay",
    "on-click": "fuzzel",
    "tooltip": false
  },

  "wlr/taskbar": {
    "format": "{icon} {title}",
    "icon-size": 16,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "max-length": 25
  },

  "clock": {
    "format": "{:%H:%M  %d.%m.%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 3,
    "tooltip-format": "Pamięć: {used:0.1f}GiB / {total:0.1f}GiB"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Wyciszony",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 Sieć",
    "format-disconnected": "󰖪 Brak sieci",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂃", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "",
    "on-click": "okay-powermenu",
    "tooltip": false
  }
}
