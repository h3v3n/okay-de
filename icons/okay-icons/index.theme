[Icon Theme]
Name=OKay Icons
Comment=Premium Dark Glass & Anodized Metal icon theme for OKay DE
Inherits=hicolor,Adwaita
Example=folder
Directories=scalable/apps,scalable/places,scalable/mimetypes,scalable/devices,scalable/status

[scalable/apps]
Context=Applications
Size=48
MinSize=16
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=48
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=48
MinSize=16
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=48
MinSize=16
MaxSize=512
Type=Scalable

[scalable/status]
Context=Status
Size=22
MinSize=16
MaxSize=512
Type=Scalable
